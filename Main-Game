function drawDarkKnightSword(ctx,angle,r,ultActive=false){
  if(ultActive) return;
  ctx.save();
  ctx.rotate(angle);

  // The entire sword is deliberately OUTSIDE the ball.
  // 1.15r = the inner end of the grip, leaving a visible gap from the ball.
  // The old sword was much smaller; these dimensions make it ~1.5x larger.
  const gripStart=r*1.25;
  const gripEnd=r*2;
  const guardX=r*1.62;
  const tipX=r*5.5;
  const bladeW=r*0.235;

  ctx.shadowColor='#ffffff'; ctx.shadowBlur=2;

  // Pommel.
  ctx.fillStyle='#c9a33b';
  ctx.beginPath(); ctx.arc(gripStart,0,r*0.10,0,Math.PI*2); ctx.fill();

  // Wooden/leather handle, clearly visible and never inside the ball.
  ctx.fillStyle='#5a3a18';
  ctx.fillRect(gripStart,-r*0.105,gripEnd-gripStart,r*0.21);
  ctx.strokeStyle='#d6aa45'; ctx.lineWidth=2;
  for(let gx=gripStart+r*.10;gx<gripEnd;gx+=r*.13){
    ctx.beginPath(); ctx.moveTo(gx,-r*.105); ctx.lineTo(gx,r*.105); ctx.stroke();
  }

  // Gold crossguard.
  ctx.strokeStyle='#d6aa45'; ctx.lineWidth=r*.10; ctx.lineCap='round';
  ctx.beginPath(); ctx.moveTo(guardX,-r*.30); ctx.lineTo(guardX,r*.30); ctx.stroke();
  ctx.strokeStyle='#8d6b24'; ctx.lineWidth=r*.045;
  ctx.beginPath(); ctx.moveTo(guardX,-r*.28); ctx.lineTo(guardX,r*.28); ctx.stroke();

  // Knight blade: not a triangle anymore — it has parallel edges, a fuller,
  // shoulders, and a pointed tip.
  const bladeStart=guardX+r*.08;
  ctx.fillStyle='#bfc4ca';
  ctx.beginPath();
  ctx.moveTo(bladeStart,-bladeW);
  ctx.lineTo(tipX-r*.20,-bladeW*.72);
  ctx.lineTo(tipX,0);
  ctx.lineTo(tipX-r*.20,bladeW*.72);
  ctx.lineTo(bladeStart,bladeW);
  ctx.closePath(); ctx.fill();
  ctx.strokeStyle='#6f747c'; ctx.lineWidth=2; ctx.stroke();

  // Steel highlight / fuller.
  ctx.strokeStyle='#f2f3f4'; ctx.lineWidth=r*.045;
  ctx.beginPath(); ctx.moveTo(bladeStart+r*.10,-r*.02); ctx.lineTo(tipX-r*.18,-r*.02); ctx.stroke();
  ctx.strokeStyle='#8b9096'; ctx.lineWidth=r*.025;
  ctx.beginPath(); ctx.moveTo(bladeStart+r*.10,r*.06); ctx.lineTo(tipX-r*.22,r*.06); ctx.stroke();

  ctx.shadowBlur=0;
  ctx.restore();
}

function drawDarkKnightShield(ctx,x,y,r,ready=false,ultActive=false){
  ctx.save();
  ctx.translate(x+r*1.2,y+r*0.95);
  const sr=r*0.76;

  // Shield sits lower-right so it no longer covers the Knight's face.
  // During the ultimate it is completely pitch black — no white details.
  ctx.shadowColor=ready&&!ultActive?'#ffffff':'#000000';
  ctx.shadowBlur=ready&&!ultActive?0:0;

  // Charged shield sticker outline is UNDER the shield, never painted over it.
  if(ready && !ultActive){
    ctx.save();
    ctx.scale(1.10,1.10);
    ctx.beginPath(); ctx.arc(0,0,r*0.75,0,Math.PI*2);
    ctx.fillStyle='#ffffff'; ctx.fill();
    ctx.restore();
  }

  ctx.beginPath(); ctx.arc(0,0,sr,0,Math.PI*2);
  const g=ctx.createRadialGradient(-sr*.25,-sr*.25,2,0,0,sr);
  g.addColorStop(0,ultActive?'#000000':'#917357');
  g.addColorStop(.55,ultActive?'#000000':'#917357');
  g.addColorStop(1,ultActive?'#000000':'#785637');
  ctx.fillStyle=g; ctx.fill();
  ctx.strokeStyle=ultActive?'#ffffff':'#C2C2C2'; ctx.lineWidth=2; ctx.stroke();

  if(!ultActive){
    ctx.strokeStyle='#3f454c'; ctx.lineWidth=3;
    ctx.beginPath();ctx.moveTo(-sr*.65,0);ctx.lineTo(sr*.65,0);ctx.stroke();
    ctx.beginPath();ctx.moveTo(0,-sr*.65);ctx.lineTo(0,sr*.65);ctx.stroke();
    ctx.beginPath();ctx.arc(0,0,sr*.18,0,Math.PI*2);
    ctx.fillStyle='#b08a48';ctx.fill();
  }
  ctx.restore();
}

function spawnDarkKnightPortal(knight){
  if(knight.dkUltActive || !knight.alive) return;
  const ox=knight.x, oy=knight.y;
  const portalPos=randomArenaPoint(70);
  const nx=portalPos.x, ny=portalPos.y;
  darkKnightPortals.push({x:ox,y:oy,nx,ny,side:knight.side,t:0,dur:1,id:Math.random()});
  knight.x=nx; knight.y=ny;
  effects.push({type:'ult_flash',x:ox,y:oy,r:45,color:'#ffffff',t:0,dur:0.25});
  effects.push({type:'ult_flash',x:nx,y:ny,r:55,color:'#ffffff',t:0,dur:0.35});
}

function spawnDarkKnightWind(knight){
  // Freeze the particle's direction at spawn time. This makes every wind
  // streak stay parallel to the exact direction the Knight was moving.
  const speed=Math.hypot(knight.vx,knight.vy)||1;
  const dirX=knight.vx/speed;
  const dirY=knight.vy/speed;
  const px=knight.x-dirX*(knight.r*.45+Math.random()*8);
  const py=knight.y-dirY*(knight.r*.45+Math.random()*8);
  darkKnightWindParticles.push({
    x:px,y:py,
    vx:-dirX*(.8+Math.random()*.9),
    vy:-dirY*(.8+Math.random()*.9),
    dirX,dirY,
    life:0,maxLife:.25+Math.random()*.25,
    len:12+Math.random()*22
  });
}

function spawnDarkKnightShadow(knight){
  darkKnightShadowParticles.push({
    x:knight.x+(Math.random()-.5)*knight.r*1.8,
    y:knight.y+(Math.random()-.5)*knight.r*1.8,
    vx:(Math.random()-.5)*1.2,
    vy:(Math.random()-.5)*1.2-.4,
    size:4+Math.random()*9,life:0,maxLife:.35+Math.random()*.5,
    side:knight.side
  });
}

function updateDarkKnightParticles(dt){
  darkKnightWindParticles=darkKnightWindParticles.filter(p=>{
    p.life+=dt;p.x+=p.vx;p.y+=p.vy;return p.life<p.maxLife;
  });
  darkKnightShadowParticles=darkKnightShadowParticles.filter(p=>{
    p.life+=dt;p.x+=p.vx;p.y+=p.vy;p.size*=.985;return p.life<p.maxLife;
  });
  darkKnightPortals=darkKnightPortals.filter(p=>{p.t+=dt;return p.t<p.dur;});
  darkKnightSlashEffects=darkKnightSlashEffects.filter(s=>{s.t+=dt;return s.t<s.dur;});
}

function drawDarkKnightEffects(ctx){
  darkKnightPortals.forEach(p=>{
    const fade=Math.sin(Math.min(1,p.t/p.dur)*Math.PI);
    [ [p.x,p.y], [p.nx,p.ny] ].forEach(([x,y])=>{
      ctx.save();ctx.globalAlpha=.85*fade;
      ctx.strokeStyle='#ffffff';ctx.shadowColor='#ffffff';ctx.shadowBlur=18;ctx.lineWidth=3;
      ctx.beginPath();ctx.arc(x,y,24+5*Math.sin(Date.now()/70),0,Math.PI*2);ctx.stroke();
      ctx.lineWidth=1;ctx.beginPath();ctx.arc(x,y,16,0,Math.PI*2);ctx.stroke();
      ctx.restore();
    });
  });
  darkKnightWindParticles.forEach(p=>{
    const f=Math.max(0,1-p.life/p.maxLife);
    // The streak never rotates after it is spawned. Its axis is the saved
    // movement direction, not its changing particle velocity.
    const len=p.len*(.35+.65*f);
    const half=len*.5;
    ctx.save();
    ctx.globalAlpha=f*f*.72;
    ctx.strokeStyle='#dcecff';
    ctx.lineWidth=Math.max(.35,2.2*f); // visibly thins as lifetime expires
    ctx.beginPath();
    ctx.moveTo(p.x-p.dirX*half,p.y-p.dirY*half);
    ctx.lineTo(p.x+p.dirX*half,p.y+p.dirY*half);
    ctx.stroke();
    ctx.restore();
  });
  darkKnightShadowParticles.forEach(p=>{
    const f=1-p.life/p.maxLife;
    ctx.save();ctx.globalAlpha=f*.55;ctx.fillStyle='#000000';ctx.shadowColor='#000000';ctx.shadowBlur=8;
    ctx.beginPath();ctx.arc(p.x,p.y,p.size*f,0,Math.PI*2);ctx.fill();ctx.restore();
  });
  darkKnightSlashEffects.forEach(s=>{
    const p=s.t/s.dur, a=Math.sin(Math.min(1,p)*Math.PI);
    ctx.save();ctx.translate(s.x,s.y);ctx.globalAlpha=a;
    ctx.strokeStyle='#ffffff';ctx.shadowColor='#ffdddd';ctx.shadowBlur=18;ctx.lineWidth=6;
    ctx.beginPath();ctx.arc(0,0,s.r,0,Math.PI*2);ctx.stroke();
    ctx.strokeStyle='#8d1018';ctx.lineWidth=2;ctx.beginPath();ctx.arc(0,0,s.r*.72,0,Math.PI*2);ctx.stroke();
    ctx.restore();
  });
}

function darkKnightSwordHit(knight){
  if(knight.dkUltActive || !knight.alive) return;
  // drawDarkKnightBall() rotates by knight.angle first, then the sword
  // rotates by dkSwordAngle. Use that same combined world-space angle.
  const swordAngle=knight.angle+knight.dkSwordAngle;
  const swordHitRadius=knight.r*0.255+2;
  // Match the visible blade: bladeStart=guardX+r*.08, tipX=r*4.5.
  const sx=knight.x+Math.cos(swordAngle)*(knight.r*1.62+knight.r*0.08);
  const sy=knight.y+Math.sin(swordAngle)*(knight.r*1.62+knight.r*0.08);
  const ex=knight.x+Math.cos(swordAngle)*knight.r*4.5;
  const ey=knight.y+Math.sin(swordAngle)*knight.r*4.5;
  const dx=ex-sx,dy=ey-sy,lenSq=dx*dx+dy*dy||1;
  const enemies=[...balls,...copies].filter(b=>b.alive&&b.side!==knight.side&&sameRealm(b,knight));
  for(const e of enemies){
    const er=e.char.id==='elder_tree'?e.etGrowR:e.r;
    const wx=e.x-sx,wy=e.y-sy;
    const t=Math.max(0,Math.min(1,(wx*dx+wy*dy)/lenSq));
    const px=sx+dx*t,py=sy+dy*t;
    if(Math.hypot(e.x-px,e.y-py)<=er+swordHitRadius){
      const key=e.id;
      if(!knight.dkSwordHits[key] || knight.dkSwordHits[key]<=0){
        knight.dkSwordHits[key]=.45;
        e.takeDamage(45,knight);
        domainCount(knight,'swordHits',1);
        const ang=Math.atan2(e.y-knight.y,e.x-knight.x);
        const spd=e.getSpeed();
        e.vx=Math.cos(ang)*spd;e.vy=Math.sin(ang)*spd;
        effects.push({type:'ring',x:e.x,y:e.y,r:er,maxR:er+45,color:'#ffffff',t:0,dur:.28});
        effects.push({type:'ult_flash',x:e.x,y:e.y,r:38,color:'#d6b45a',t:0,dur:.22});
      }
    }
  }
  for(const t of turrets){
    if(!t.alive||t.side===knight.side||!sameRealm(t,knight)) continue;
    const wx=t.x-sx,wy=t.y-sy;
    const q=Math.max(0,Math.min(1,(wx*dx+wy*dy)/lenSq));
    const px=sx+dx*q,py=sy+dy*q;
    if(Math.hypot(t.x-px,t.y-py)<=t.r+swordHitRadius){
      const key='t'+t.id;
      if(!knight.dkSwordHits[key] || knight.dkSwordHits[key]<=0){
        knight.dkSwordHits[key]=.45;t.takeDamage(45,knight);
        effects.push({type:'ring',x:t.x,y:t.y,r:t.r,maxR:t.r+35,color:'#ffffff',t:0,dur:.28});
      }
    }
  }
}

function darkKnightUltHit(knight,target){
  if(!target || !target.alive) return;
  const er=target.char.id==='elder_tree'?target.etGrowR:target.r;

  // This is the ONLY damage/stun event for the ultimate. It is deliberately
  // separate from normal ball collisions so the Knight can pass through.
  target.takeDamage(45,knight);
  darkKnightStunTimers[target.id]=1.15;
  target.vx=0;
  target.vy=0;

  darkKnightSlashEffects.push({x:target.x,y:target.y,r:er+30,t:0,dur:.8});
  effects.push({type:'ring',x:target.x,y:target.y,r:er,maxR:er+80,color:'#ffffff',t:0,dur:.35});
  effects.push({type:'ult_flash',x:target.x,y:target.y,r:75,color:'#8d1018',t:0,dur:.25});
}

function processDarkKnightUltContacts(){
  balls.forEach(knight=>{
    if(!knight.alive||knight.char.id!=='dark_knight'||!knight.dkUltActive) return;
    if(isDomainMode()&&domainState?.owner===knight) return;

    // Before the first hit, the ultimate simply charges forward.
    if(!knight.dkUltLockedTarget){
      const enemies=[...balls,...copies].filter(e=>e.alive&&e.side!==knight.side);
      for(const e of enemies){
        const er=e.char.id==='elder_tree'?e.etGrowR:e.r;
        if(Math.hypot(e.x-knight.x,e.y-knight.y)<=knight.r+er){
          knight.dkUltLockedTarget=e;
          knight.dkUltLockX=e.x;
          knight.dkUltLockY=e.y;
          knight.dkUltTeleportTimer=1.25;
          knight.dkUltContacting=true;
          darkKnightUltHit(knight,e);

          // Immediately steer toward the locked enemy.
          const dx=e.x-knight.x,dy=e.y-knight.y,d=Math.hypot(dx,dy)||1;
          const spd=knight.getSpeed();
          knight.vx=dx/d*spd;
          knight.vy=dy/d*spd;
          break;
        }
      }
      return;
    }

    const target=knight.dkUltLockedTarget;
    if(target && target.alive){
      knight.dkUltLockX=target.x;
      knight.dkUltLockY=target.y;
      const er=target.char.id==='elder_tree'?target.etGrowR:target.r;
      const touching=Math.hypot(target.x-knight.x,target.y-knight.y)<=knight.r+er;

      // A physical pass-through can only trigger once per contact. Once the
      // Knight leaves the target, another pass (or teleport) can hit again.
      if(touching && !knight.dkUltContacting){
        knight.dkUltContacting=true;
        darkKnightUltHit(knight,target);
      }else if(!touching){
        knight.dkUltContacting=false;
      }

      // Do NOT keep steering toward the enemy. The Knight only aims at the
      // enemy's position when he teleports (or on the initial lock). After
      // that, he commits to that direction and phases straight through.
    }

  });
}

function updateDarkKnight(dt,enemies){
  if(this.isCopy) return;
  if(isDomainMode()&&domainState?.phase==='active'&&domainState.owner===this){
    // Use the normal ultimate's lock-and-teleport rhythm inside the domain.
    // A new lock is acquired if the previous target is defeated.
    if(!this.dkUltLockedTarget?.alive||!sameRealm(this,this.dkUltLockedTarget)){
      this.dkUltLockedTarget=domainNearest(this);
      this.dkUltTeleportTimer=Math.min(this.dkUltTeleportTimer,1.25);
    }
    const spd=this.getSpeed(),len=Math.hypot(this.vx,this.vy)||1;
    this.vx=this.vx/len*spd;this.vy=this.vy/len*spd;
    if(this.dkUltLockedTarget){
      this.dkUltTeleportTimer-=dt;
      if(this.dkUltTeleportTimer<=0){
        const target=this.dkUltLockedTarget,oldX=this.x,oldY=this.y;
        const next=domainCirclePoint(1,80);
        this.x=next.x;this.y=next.y;
        keepInCircle(this,this.r,false);
        darkKnightPortals.push({x:oldX,y:oldY,nx:this.x,ny:this.y,side:this.side,t:0,dur:.7,id:Math.random()});
        effects.push({type:'ult_flash',x:oldX,y:oldY,r:45,color:'#ffffff',t:0,dur:.25});
        effects.push({type:'ult_flash',x:this.x,y:this.y,r:55,color:'#ffffff',t:0,dur:.35});
        this.dkUltLockX=target.x;this.dkUltLockY=target.y;
        const dx=target.x-this.x,dy=target.y-this.y,distance=Math.hypot(dx,dy)||1;
        this.vx=dx/distance*spd;this.vy=dy/distance*spd;
        this.dkUltTeleportTimer=1.25;
      }
    }
    return;
  }

  if(this.dkUltActive){
    this.dkUltDuration-=dt;
    this.dkUltRamp=Math.min(1,(this.dkUltRamp+dt)/.75);

    // Wind and shadow are spawned throughout the active phase.
    if(Math.random()<dt*28) spawnDarkKnightWind(this);
    if(Math.random()<dt*18) spawnDarkKnightShadow(this);

    // If the enemy Dark Knight locked onto dies (including a low-health
    // main enemy or a Manic Lion clone), immediately release the lock so the
    // ultimate can continue moving and acquire another enemy.
    if(this.dkUltLockedTarget && !this.dkUltLockedTarget.alive){
      this.dkUltLockedTarget=null;
      this.dkUltContacting=false;
      this.dkUltTeleportTimer=0;
    }

    const spd=this.getSpeed();

    if(this.dkUltLockedTarget){
      const target=this.dkUltLockedTarget;
      const tx=target && target.alive ? target.x : this.dkUltLockX;
      const ty=target && target.alive ? target.y : this.dkUltLockY;

      // Teleport every 1.25 seconds to a random arena location, then travel
      // directly toward the locked target from that new position.
      this.dkUltTeleportTimer-=dt;
      if(this.dkUltTeleportTimer<=0){
        const ox=this.x,oy=this.y;
        const portalPos=randomArenaPoint(70);
        const nx=portalPos.x;
        const ny=portalPos.y;
        this.x=nx;
        this.y=ny;
        darkKnightPortals.push({x:ox,y:oy,nx,ny,side:this.side,t:0,dur:.7,id:Math.random()});
        effects.push({type:'ult_flash',x:ox,y:oy,r:45,color:'#ffffff',t:0,dur:.25});
        effects.push({type:'ult_flash',x:nx,y:ny,r:55,color:'#ffffff',t:0,dur:.35});

        const dx=tx-nx,dy=ty-ny,d=Math.hypot(dx,dy)||1;
        this.vx=dx/d*spd;
        this.vy=dy/d*spd;
        this.dkUltTeleportTimer=1.25;
        this.dkUltContacting=false; // landing on the target counts as a fresh contact
      }
    }else{
      // No target yet: preserve the current direction while ramping speed.
      const cur=Math.hypot(this.vx,this.vy);
      if(cur>0.01){this.vx=this.vx/cur*spd;this.vy=this.vy/cur*spd;}
      else{const a=Math.random()*Math.PI*2;this.vx=Math.cos(a)*spd;this.vy=Math.sin(a)*spd;}
    }

    if(this.dkUltDuration<=0){
      this.dkUltActive=false;
      this.dkUltTimer=0;
      this.ultProgress=0;
      this.dkShieldReady=false;
      this.dkShieldCharge=0;
      this.dkUltLockedTarget=null;
      this.dkUltTeleportTimer=0;
      this.dkUltRamp=0;
      this.dkUltContacting=false;
      this.dkSwordAngle=Math.random()*Math.PI*2;
      effects.push({type:'ult_flash',x:this.x,y:this.y,r:100,color:'#ffffff',t:0,dur:.45});
      triggerScreenUltFlash('#160407',.55);
      const s=this.getSpeed(),c=Math.hypot(this.vx,this.vy)||1;
      this.vx=this.vx/c*s;this.vy=this.vy/c*s;
    }
    return;
  }

  const spd=this.getSpeed();
  const cur=Math.hypot(this.vx,this.vy);
  if(cur>0.01){const f=spd/cur;this.vx*=f;this.vy*=f;}
  else{const a=Math.random()*Math.PI*2;this.vx=Math.cos(a)*spd;this.vy=Math.sin(a)*spd;}

  this.dkSwordAngle += Math.PI*2*dt*(1.7/3);
  for(const k in this.dkSwordHits) this.dkSwordHits[k]-=dt;
  darkKnightSwordHit(this);

  this.dkShieldCharge=Math.min(8,this.dkShieldCharge+dt);
  if(this.dkShieldCharge>=8) this.dkShieldReady=true;

  this.dkPortalTimer+=dt;
  if(this.dkPortalTimer>=this.dkPortalInterval){
    this.dkPortalTimer=0;
    this.dkPortalInterval=10+Math.random()*3;
    spawnDarkKnightPortal(this);
  }

  this.dkUltTimer+=dt;
  this.ultProgress=Math.min(1,this.dkUltTimer/this.dkUltInterval);
  if(this.dkUltTimer>=this.dkUltInterval) activateDarkKnightUlt(this);
}

function activateDarkKnightUlt(knight){
  if(knight.dkUltActive) return;
  knight.dkUltActive=true;
  knight.dkUltDuration=12;
  knight.dkUltHits={};
  knight.dkUltLockedTarget=null;
  knight.dkUltLockX=knight.x;
  knight.dkUltLockY=knight.y;
  knight.dkUltTeleportTimer=0;
  knight.dkUltRamp=0;
  knight.dkUltContacting=false;
  knight.dkShieldReady=false;
  knight.dkShieldCharge=0;
  effects.push({type:'ult_flash',x:knight.x,y:knight.y,r:120,color:'#8d1018',t:0,dur:.7});
  effects.push({type:'ult_flash',x:knight.x,y:knight.y,r:70,color:'#ffffff',t:0,dur:.45});
  triggerScreenUltFlash('#35060b',.8);

  // Keep his current direction; only the speed ramps up to the existing
  // ultimate cap of 10.5.
  const cur=Math.hypot(knight.vx,knight.vy)||1;
  knight.vx=knight.vx/cur*knight.getSpeed();
  knight.vy=knight.vy/cur*knight.getSpeed();
}

function drawDarkKnightUltArena(ctx,knight){
  if(!knight||!knight.alive||!knight.dkUltActive) return;
  const pulse=.5+.5*Math.sin(Date.now()/100);
  ctx.save();
  ctx.fillStyle=`rgba(90,0,8,${.07+.035*pulse})`;
  ctx.fillRect(0,0,W,H);
  ctx.strokeStyle=`rgba(150,20,30,${.45+.25*pulse})`;
  ctx.lineWidth=5;
  if(isHexArena()){
    const v=getArenaVertices(4);
    ctx.beginPath();
    v.forEach((p,i)=>i===0?ctx.moveTo(p.x,p.y):ctx.lineTo(p.x,p.y));
    ctx.closePath();
    ctx.stroke();
  }else{
    ctx.strokeRect(2,2,W-4,H-4);
  }
  ctx.restore();
}

// ---- HARPER GEM SYSTEM ----
function getNearestEnemyFor(owner){
  const enemies=[...balls,...copies].filter(e=>e.alive&&e.side!==owner.side&&sameRealm(e,owner));
  if(!enemies.length) return null;
  return enemies.reduce((a,b)=>
    Math.hypot(a.x-owner.x,a.y-owner.y)<Math.hypot(b.x-owner.x,b.y-owner.y)?a:b
  );
}

function getHarperBloodstone(owner){
  return harperBloodstones.find(stone=>stone.alive&&stone.owner===owner&&sameRealm(stone,owner))||null;
}

function spawnHarperShard(owner,orbitTime=1,launchAngle=null,options={}){
  const formSource=options.formSource||owner;
  const demon=formSource.harperForm==='demon';
  const artistGrayCopy=!!options.artistGrayCopy;
  const scale=owner.combatScale||1;
  harperShards.push({
    id:Math.random(),owner,side:owner.side,realm:owner.realm||0,
    x:owner.x,y:owner.y,
    orbitAngle:Math.random()*Math.PI*2,
    orbitRadius:owner.r*(1.8+Math.random()*.9),
    // Negative rotation is counter-clockwise on the canvas. Harper's old
    // orbit speed is reduced to exactly 33% here.
    orbitSpeed:-(demon?.20:.16)*.33,
    orbitTime,t:0,state:'orbit',vx:0,vy:0,life:0,maxLife:5,
    damage:8,
    // Two times the old 5.2 / 6.2 shard sizes.
    r:(demon?12.4:10.4)*scale,
    color:artistGrayCopy?'#bcbcbc':HARPER_ROSE,
    glow:artistGrayCopy?'#ffffff':'#ffb3cb',
    launchAngle,
    isShatter:Number.isFinite(launchAngle),
    artistGrayCopy,formSource,
    onlyTargetStone:!!options.onlyTargetStone,
    forcedStoneId:options.forcedStoneId||null,
    targetStoneId:null,alive:true
  });
}

function launchHarperShard(shard){
  const owner=shard.owner;
  if(!owner||!owner.alive){shard.alive=false;return;}
  const formSource=shard.formSource||owner;

  // Bloodstone-copy gems belong exclusively to that copied Bloodstone. They
  // never acquire a fighter or turret target, and vanish if the stone is gone.
  if(shard.onlyTargetStone){
    const forcedStone=harperBloodstones.find(stone=>stone.alive&&stone.id===shard.forcedStoneId);
    if(!forcedStone||!sameRealm(shard,forcedStone)){shard.alive=false;return;}
    const dx=forcedStone.x-shard.x,dy=forcedStone.y-shard.y,d=Math.hypot(dx,dy)||1;
    const speed=formSource.harperForm==='demon'?10.8:9.2;
    shard.targetStoneId=forcedStone.id;
    shard.vx=dx/d*speed;shard.vy=dy/d*speed;shard.state='fly';
    return;
  }

  // Gem Shatter spends a second orbiting before it launches. Re-acquire the
  // nearest enemy here and aim from the gem's CURRENT position, otherwise the
  // old owner-based angle can make the throw look random after that orbit.
  if(shard.isLargeShatter){
    const nearest=getNearestEnemyFor(owner);
    if(nearest) shard.launchAngle=Math.atan2(nearest.y-shard.y,nearest.x-shard.x);
  }

  // Fragments and ultimate field gems keep the angle assigned to them.
  if(Number.isFinite(shard.launchAngle)){
    const speed=(formSource.harperForm==='demon'?10.8:9.2)*(shard.speedMultiplier||1);
    shard.vx=Math.cos(shard.launchAngle)*speed;
    shard.vy=Math.sin(shard.launchAngle)*speed;
    shard.state='fly';
    return;
  }

  const nearest=getNearestEnemyFor(owner);
  const stone=getHarperBloodstone(owner);
  const enemyDist=nearest?Math.hypot(nearest.x-owner.x,nearest.y-owner.y):Infinity;
  const stoneDist=stone?Math.hypot(stone.x-owner.x,stone.y-owner.y):Infinity;
  let tx=owner.x+Math.cos(shard.orbitAngle)*120;
  let ty=owner.y+Math.sin(shard.orbitAngle)*120;

  // A closer enemy always wins. Otherwise Harper deliberately feeds the
  // Bloodstone. The chosen coordinates are a snapshot, so shards fly straight.
  if(stone&&stoneDist<enemyDist){
    tx=stone.x;ty=stone.y;shard.targetStoneId=stone.id;
  }else if(nearest){
    tx=nearest.x;ty=nearest.y;
  }

  const dx=tx-shard.x,dy=ty-shard.y,d=Math.hypot(dx,dy)||1;
  const speed=formSource.harperForm==='demon'?10.8:9.2;
  shard.vx=dx/d*speed;shard.vy=dy/d*speed;shard.state='fly';
}

function activateHarperGemShatter(owner,target,options={}){
  if(!owner||!target) return;
  // One large gem: 4x a normal shard, 2x slower, and 70 impact damage.
  const launchAngle=Math.atan2(target.y-owner.y,target.x-owner.x);
  spawnHarperShard(owner,1,launchAngle,options);
  const shard=harperShards[harperShards.length-1];
  shard.isLargeShatter=true;
  shard.isShatter=true;
  shard.speedMultiplier=.5;
  shard.r*=4;
  shard.damage=70;
  const effectColor=options.artistGrayCopy?'#d0d0d0':HARPER_ROSE;
  effects.push({type:'text',x:owner.x,y:owner.y-owner.r-20,text:'GEM SHATTER',color:effectColor,t:0,dur:.85});
  effects.push({type:'ring',x:owner.x,y:owner.y,r:owner.r,maxR:owner.r+62,color:effectColor,t:0,dur:.42});
}

function spawnHarperFlyingFragment(owner,x,y,angle,options={}){
  // Fragments are ordinary 6-damage gems at ordinary size and speed.
  spawnHarperShard(owner,0,angle,options);
  const fragment=harperShards[harperShards.length-1];
  fragment.x=x;fragment.y=y;fragment.realm=options.realm??fragment.realm;fragment.state='fly';fragment.t=0;
  fragment.isShatter=false;fragment.isShatterFragment=true;
  launchHarperShard(fragment);
}

function shatterHarperLargeGem(shard){
  if(!shard.alive||shard.hasShattered) return;
  shard.hasShattered=true;shard.alive=false;
  const baseAngle=Number.isFinite(shard.launchAngle)?shard.launchAngle:Math.atan2(shard.vy,shard.vx);
  // Eight perfectly symmetrical fragments: exactly 45 degrees apart.
  const copyOptions={artistGrayCopy:shard.artistGrayCopy,formSource:shard.formSource,realm:shard.realm};
  for(let i=0;i<8;i++) spawnHarperFlyingFragment(shard.owner,shard.x,shard.y,baseAngle+i*Math.PI/4,copyOptions);
  const flashColor=shard.artistGrayCopy?'#bcbcbc':HARPER_ROSE;
  const ringColor=shard.artistGrayCopy?'#ffffff':'#ffd0df';
  effects.push({type:'ult_flash',x:shard.x,y:shard.y,r:72*(shard.owner.combatScale||1),color:flashColor,t:0,dur:.38});
  effects.push({type:'ring',x:shard.x,y:shard.y,r:12,maxR:86*(shard.owner.combatScale||1),color:ringColor,t:0,dur:.45});
}

function spawnHarperUltimateFieldGem(owner){
  spawnHarperShard(owner,0,null);
  const shard=harperShards[harperShards.length-1];
  const pos=isDomainMode()?domainCirclePoint(shard.realm,Math.max(45,shard.r+18)):randomArenaPoint(Math.max(45,shard.r+18));
  shard.x=pos.x;shard.y=pos.y;
  shard.state='field';shard.isUltField=true;
  shard.vx=0;shard.vy=0;shard.life=0;
  return shard;
}

function launchHarperUltimateFieldGem(shard){
  if(!shard||!shard.alive||shard.state!=='field') return;
  const enemies=[...balls,...copies].filter(enemy=>enemy.alive&&enemy.side!==shard.side&&sameRealm(enemy,shard));
  let angle=Math.random()*Math.PI*2;
  if(enemies.length){
    const target=enemies[Math.floor(Math.random()*enemies.length)];
    angle=Math.atan2(target.y-shard.y,target.x-shard.x);
  }
  shard.launchAngle=angle;shard.state='fly';shard.life=0;
  launchHarperShard(shard);
}

function launchHarperUltimateWave(owner){
  const fieldGems=harperShards.filter(shard=>shard.alive&&shard.owner===owner&&shard.state==='field');
  // Fisher-Yates makes the ten selected gems genuinely random each wave.
  for(let i=fieldGems.length-1;i>0;i--){
    const j=Math.floor(Math.random()*(i+1));
    [fieldGems[i],fieldGems[j]]=[fieldGems[j],fieldGems[i]];
  }
  fieldGems.slice(0,10).forEach(launchHarperUltimateFieldGem);
}

function grantHarperUltimateGemBoost(shard){
  const owner=getCombatOwner(shard.owner);
  if(!shard.isUltField||!owner||owner.char?.id!=='harper') return;
  owner.harperGemDamageBonus=(owner.harperGemDamageBonus||0)+.01;
  owner.damageMultiplier=(owner.damageMultiplier||1)+.01;
}

function getHarperShardInterval(owner){
  // Exact standard-form breakpoints requested by the user:
  // Hybrid: 1.00s at full HP -> 0.33s at 100 HP.
  // Daemon: 0.33s at full HP -> 0.125s at 100 HP.
  const fullInterval=owner.harperForm==='demon'?.33:1;
  const lowInterval=owner.harperForm==='demon'?.125:.33;
  const hpRange=Math.max(1,owner.maxHp-100);
  const missingProgress=Math.max(0,Math.min(1,(owner.maxHp-owner.hp)/hpRange));
  return fullInterval+(lowInterval-fullInterval)*missingProgress;
}

function updateHarperShard(shard,dt){
  if(!shard.alive) return;
  const owner=shard.owner;
  if(!owner||!owner.alive){shard.alive=false;return;}

  if(shard.state==='orbit'){
    shard.t+=dt;
    shard.orbitAngle+=shard.orbitSpeed*60*dt;
    shard.x=owner.x+Math.cos(shard.orbitAngle)*shard.orbitRadius;
    shard.y=owner.y+Math.sin(shard.orbitAngle)*shard.orbitRadius;
    if(shard.t>=shard.orbitTime) launchHarperShard(shard);
    return;
  }

  // Ultimate field gems are visible but completely harmless and stationary
  // until one of the four launch waves selects them.
  if(shard.state==='field') return;

  if(shard.onlyTargetStone&&!harperBloodstones.some(stone=>stone.alive&&stone.id===shard.forcedStoneId)){
    shard.alive=false;return;
  }

  shard.life+=dt;
  if(shard.life>=shard.maxLife){shard.alive=false;return;}
  shard.x+=shard.vx;shard.y+=shard.vy;

  if(shard.isLargeShatter){
    const hitWall=isDomainMode()
      ? Math.hypot(shard.x-circleFor(shard).x,shard.y-circleFor(shard).y)+shard.r>=DOMAIN_RADIUS-2
      : isHexArena()? !pointInArena(shard.x,shard.y)
      : shard.x-shard.r<=0||shard.x+shard.r>=W||shard.y-shard.r<=0||shard.y+shard.r>=H;
    if(hitWall){if(isDomainMode())keepInCircle(shard,shard.r,false);shatterHarperLargeGem(shard);return;}
  }

  // Harper's shards never bounce. They simply leave the arena and disappear.
  if(isDomainMode()&&Math.hypot(shard.x-circleFor(shard).x,shard.y-circleFor(shard).y)+shard.r>=DOMAIN_RADIUS){shard.alive=false;return;}
  if(shard.x<-50||shard.x>W+50||shard.y<-50||shard.y>H+50){shard.alive=false;return;}

  if(shard.targetStoneId){
    const stone=harperBloodstones.find(s=>s.id===shard.targetStoneId&&s.alive);
    if(stone&&sameRealm(stone,shard)&&Math.hypot(stone.x-shard.x,stone.y-shard.y)<stone.r+shard.r){
      stone.charge=Math.min(20,stone.charge+1);
      stone.r=Math.min(40*(owner.combatScale||1),stone.r+1.3);
      effects.push({type:'ring',x:stone.x,y:stone.y,r:stone.r,maxR:stone.r+16,color:shard.artistGrayCopy?'#d0d0d0':'#ff9ec8',t:0,dur:.22});
      shard.alive=false;return;
    }
  }

  for(const enemy of [...balls,...copies]){
    if(!enemy.alive||enemy.side===shard.side||!sameRealm(enemy,shard)) continue;
    const enemyR=enemy.char.id==='elder_tree'?enemy.etGrowR:enemy.r;
    if(Math.hypot(enemy.x-shard.x,enemy.y-shard.y)<enemyR+shard.r){
      enemy.takeDamage(shard.damage,owner);
      grantHarperUltimateGemBoost(shard);
      effects.push({type:'ring',x:enemy.x,y:enemy.y,r:enemyR,maxR:enemyR+30,color:shard.color,t:0,dur:.3});
      if(shard.isLargeShatter) shatterHarperLargeGem(shard);
      else shard.alive=false;
      return;
    }
  }

  for(const turret of turrets){
    if(!turret.alive||turret.side===shard.side||!sameRealm(turret,shard)) continue;
    if(Math.hypot(turret.x-shard.x,turret.y-shard.y)<turret.r+shard.r){
      turret.takeDamage(shard.damage,owner);
      grantHarperUltimateGemBoost(shard);
      effects.push({type:'ring',x:turret.x,y:turret.y,r:turret.r,maxR:turret.r+24,color:shard.color,t:0,dur:.3});
      if(shard.isLargeShatter) shatterHarperLargeGem(shard);
      else shard.alive=false;
      return;
    }
  }
}

function spawnHarperBloodstone(owner,target,options={}){
  // Harper can maintain one Bloodstone at a time.
  harperBloodstones.forEach(stone=>{if(stone.owner===owner) stone.alive=false;});
  const stone={
    id:Math.random(),owner,side:owner.side,realm:owner.realm||0,x:target.x,y:target.y,
    r:18*(owner.combatScale||1),charge:0,life:0,fuse:5.2,alive:true,
    artistGrayCopy:!!options.artistGrayCopy,
    copySourceHarper:options.copySourceHarper||null
  };
  harperBloodstones.push(stone);
  effects.push({type:'ring',x:target.x,y:target.y,r:12,maxR:45,color:stone.artistGrayCopy?'#c8c8c8':'#ff5f8f',t:0,dur:.35});
  return stone;
}

function detonateHarperBloodstone(stone){
  if(!stone.alive) return;
  stone.alive=false;
  const owner=stone.owner;
  if(owner.char?.id==='harper' && stone.charge>=10) domainUnlock(owner);
  // Doubled Bloodstone shockwave range. Maniac Artist's grayscale copy uses
  // this same function, so its shockwave is doubled too.
  const radius=(170+stone.charge*20)*(owner.combatScale||1);
  // 25 base + 5 per gem, capped at 20 gems / 125 total damage.
  const damage=25+Math.min(20,stone.charge)*5;
  const flashColor=stone.artistGrayCopy?'#bcbcbc':'#ff5f8f';
  const ringColor=stone.artistGrayCopy?'#ffffff':'#ffd2e4';
  effects.push({type:'ult_flash',x:stone.x,y:stone.y,r:radius,color:flashColor,t:0,dur:.45});
  effects.push({type:'ring',x:stone.x,y:stone.y,r:16,maxR:radius,color:ringColor,t:0,dur:.55});

  if(owner.artistHarperBloodstone===stone){
    owner.artistHarperBloodstone=null;
    owner.artistHarperSource=null;
    owner.artistHarperGemTimer=0;
    harperShards.forEach(shard=>{
      if(shard.owner===owner&&shard.onlyTargetStone&&shard.forcedStoneId===stone.id) shard.alive=false;
    });
  }

  for(const enemy of [...balls,...copies]){
    if(!enemy.alive||enemy.side===stone.side||!sameRealm(enemy,stone)) continue;
    const enemyR=enemy.char.id==='elder_tree'?enemy.etGrowR:enemy.r;
    if(Math.hypot(enemy.x-stone.x,enemy.y-stone.y)<=radius+enemyR) enemy.takeDamage(damage,owner);
  }
  for(const turret of turrets){
    if(!turret.alive||turret.side===stone.side||!sameRealm(turret,stone)) continue;
    if(Math.hypot(turret.x-stone.x,turret.y-stone.y)<=radius+turret.r) turret.takeDamage(damage,owner);
  }
}

function updateHarperBloodstone(stone,dt){
  if(!stone.alive) return;
  stone.life+=dt;
  if(stone.life>=stone.fuse) detonateHarperBloodstone(stone);
}

function drawHarperShard(ctx,shard){
  if(!shard.alive) return;
  ctx.save();ctx.translate(shard.x,shard.y);
  if(shard.artistGrayCopy) ctx.filter='grayscale(1)';
  ctx.rotate(shard.state==='fly'?Math.atan2(shard.vy,shard.vx)+Math.PI/2:shard.orbitAngle);
  if(shard.state==='field'){
    const pulse=.48+.22*Math.sin(Date.now()/120+shard.id*20);
    ctx.globalAlpha=.72;
    ctx.beginPath();ctx.arc(0,0,shard.r*1.65,0,Math.PI*2);
    ctx.strokeStyle=`rgba(232,95,141,${pulse})`;ctx.lineWidth=1.5;ctx.stroke();
  }
  ctx.shadowColor=shard.glow;ctx.shadowBlur=12;ctx.fillStyle=shard.color;
  ctx.beginPath();ctx.moveTo(0,-shard.r);ctx.lineTo(shard.r*.8,0);ctx.lineTo(0,shard.r);ctx.lineTo(-shard.r*.8,0);ctx.closePath();ctx.fill();
  if(shard.isLargeShatter){
    ctx.strokeStyle=shard.artistGrayCopy?'#ffffff':'#ffd5e2';ctx.lineWidth=Math.max(2,shard.r*.055);ctx.stroke();
  }
  ctx.shadowBlur=0;ctx.restore();
}

function drawHarperBloodstone(ctx,stone){
  if(!stone.alive) return;
  const pulse=1+.1*Math.sin(Date.now()/90);
  const mainColor=stone.artistGrayCopy?'#bcbcbc':'#ff5f8f';
  const auraColor=stone.artistGrayCopy?'rgba(210,210,210,.18)':'rgba(255,70,130,.18)';
  const edgeColor=stone.artistGrayCopy?'#ffffff':'#ffd2e4';
  ctx.save();ctx.translate(stone.x,stone.y);ctx.scale(pulse,pulse);
  ctx.shadowColor=mainColor;ctx.shadowBlur=20;
