let gameRunning = false;
let animId;
let battleSpeed = 1;
let W=600, H=560;
const R=28;
// Rotation is opt-in. Existing characters that were designed around the old
// shared spin keep it; Mayhem and every future character stay upright by default.
const LEGACY_SPINNING_CHARACTER_IDS=new Set([
  'manic_lion','villainy','devourer','engineer','elder_tree',
  'dark_knight','emmy','maniac_artist','plasma'
]);

function getMode(){ return GAME_MODES[gameMode]; }
function isDomainMode(){ return gameMode==='domain'; }
const DOMAIN_CENTERS=[{x:425,y:450},{x:1275,y:450}];
const DOMAIN_RADIUS=410;
let domainState=null, domainQueue=[];
function sameRealm(a,b){return !isDomainMode() || circleFor(a)===circleFor(b);}
function circleFor(obj){
  const realm=obj?.realm??obj?.owner?.realm??obj?.source?.realm??obj?.source?.owner?.realm??(obj?.x>W/2?1:0);
  return DOMAIN_CENTERS[realm===1?1:0];
}
function rayHeptagonActive(realm){
  return isDomainMode()&&realm===1&&domainState?.phase==='active'&&domainState.owner.char.id==='ray';
}
function rayHeptagonVertices(pad=0){
  const c=DOMAIN_CENTERS[1],radius=DOMAIN_RADIUS-pad;
  const angle=(domainState?.data?.wallAngle||0)-Math.PI/2;
  return Array.from({length:7},(_,i)=>({x:c.x+Math.cos(angle+i*Math.PI*2/7)*radius,y:c.y+Math.sin(angle+i*Math.PI*2/7)*radius}));
}
function domainBoundaryPath(ctx,realm){
  const c=DOMAIN_CENTERS[realm];ctx.beginPath();
  if(rayHeptagonActive(realm)){
    rayHeptagonVertices().forEach((p,i)=>i?ctx.lineTo(p.x,p.y):ctx.moveTo(p.x,p.y));ctx.closePath();
  }else ctx.arc(c.x,c.y,DOMAIN_RADIUS,0,Math.PI*2);
}
function domainClip(ctx,obj,draw){
  if(!isDomainMode()){draw();return;}
  const c=circleFor(obj);
  ctx.save();domainBoundaryPath(ctx,c===DOMAIN_CENTERS[1]?1:0);ctx.clip();
  try{draw();}finally{ctx.restore();}
}
function keepInCircle(obj,r=obj.r||0,bounce=true){
  if(rayHeptagonActive(obj?.realm??obj?.owner?.realm??(obj?.x>W/2?1:0))){
    let collided=false;
    const vertices=rayHeptagonVertices();
    // Edge normals face inwards. Moving walls transfer a little of their
    // tangential velocity to anything they catch as the polygon turns.
    for(let i=0;i<7;i++){
      const a=vertices[i],b=vertices[(i+1)%7],ex=b.x-a.x,ey=b.y-a.y,len=Math.hypot(ex,ey);
      const nx=-ey/len,ny=ex/len,depth=(obj.x-a.x)*nx+(obj.y-a.y)*ny;
      if(depth<r+3){
        obj.x+=nx*(r+3-depth);obj.y+=ny*(r+3-depth);collided=true;
        if(bounce&&Number.isFinite(obj.vx)&&Number.isFinite(obj.vy)){
          const cx=(a.x+b.x)*.5-DOMAIN_CENTERS[1].x,cy=(a.y+b.y)*.5-DOMAIN_CENTERS[1].y;
          const omega=.33/60,wallVX=-cy*omega,wallVY=cx*omega;
          const toward=(obj.vx-wallVX)*nx+(obj.vy-wallVY)*ny;
          if(toward<0){obj.vx-=2*toward*nx;obj.vy-=2*toward*ny;}
        }
      }
    }
    return collided;
  }
  const c=circleFor(obj),dx=obj.x-c.x,dy=obj.y-c.y,d=Math.hypot(dx,dy);
  const limit=Math.max(1,DOMAIN_RADIUS-r-3);
  if(d<=limit) return false;
  const nx=dx/(d||1),ny=dy/(d||1);
  obj.x=c.x+nx*limit;obj.y=c.y+ny*limit;
  if(bounce && Number.isFinite(obj.vx) && Number.isFinite(obj.vy)){
    const dot=obj.vx*nx+obj.vy*ny;
    if(dot>0){obj.vx-=2*dot*nx;obj.vy-=2*dot*ny;}
  }
  return true;
}
function isHexArena(){ return getMode().arena==='hexagon'; }
function isThreeWay(){ return gameMode==='threeway'; }
function isTeamMode(){ return new Set(getMode().teams).size<getMode().selectionCount; }
function areEnemies(a,b){ return a && b && a.side!==b.side; }
function combatRealm(source){
  return source?.realm??source?.source?.realm??source?.owner?.realm??getCombatOwner(source)?.realm??0;
}
function scaleFor(source){
  const owner=getCombatOwner(source);
  return owner?.isJuggernaut ? 1.5 : 1;
}
function getCombatOwner(source){
  let cur=source;
  for(let i=0;i<5&&cur;i++){
    if(cur.damageOwner&&cur.damageOwner!==cur){cur=cur.damageOwner;continue;}
    if(cur.owner&&cur.owner!==cur){cur=cur.owner;continue;}
    if(cur.source&&cur.source!==cur){cur=cur.source;continue;}
    break;
  }
  return cur;
}
function modeDamage(dmg,source){ return dmg*(getCombatOwner(source)?.damageMultiplier||1); }
function isFriendlySource(target,source){
  const owner=getCombatOwner(source);
  return owner && owner.side!==undefined && target.side===owner.side;
}

// Threeway Clash uses a 1.5x arena (900x840) with a flat-top/bottom hexagon boundary.
// Game objects keep their original 1v1 world sizes; only the arena and playable space grow.
function getArenaVertices(pad=0){
  const cx=W/2, cy=H/2;
  const radius=Math.min(W/2-pad,H/Math.sqrt(3)-pad);
  const verts=[];
  for(let i=0;i<6;i++){
    const a=i*Math.PI/3;
    let x=cx+Math.cos(a)*radius;
    // Juggernaut uses a stretched hexagon: moving each entire half sideways
    // lengthens only the horizontal top/bottom edges. The four angled edges
    // keep the same vectors and therefore the same lengths.
    if(gameMode==='juggernaut'){
      const horizontalExtension=Math.max(0,Math.min(120,(W/2-radius)-6));
      x+=(i===0||i===1||i===5)?horizontalExtension:-horizontalExtension;
    }
    verts.push({x,y:cy+Math.sin(a)*radius});
  }
  return verts;
}
function pointInArena(x,y){
  if(isDomainMode()){
    if(Math.hypot(x-DOMAIN_CENTERS[0].x,y-DOMAIN_CENTERS[0].y)<=DOMAIN_RADIUS)return true;
    if(rayHeptagonActive(1)){
      const v=rayHeptagonVertices();
      return v.every((a,i)=>{const b=v[(i+1)%7];return (b.x-a.x)*(y-a.y)-(b.y-a.y)*(x-a.x)>=0;});
    }
    return Math.hypot(x-DOMAIN_CENTERS[1].x,y-DOMAIN_CENTERS[1].y)<=DOMAIN_RADIUS;
  }
  if(!isHexArena()) return x>=0&&x<=W&&y>=0&&y<=H;
  const v=getArenaVertices(2);
  let inside=true;
  for(let i=0;i<6;i++){
    const a=v[i],b=v[(i+1)%6];
    if((b.x-a.x)*(y-a.y)-(b.y-a.y)*(x-a.x)<0){ inside=false; break; }
  }
  return inside;
}
function randomArenaPoint(margin=40){
  if(isDomainMode()){
    const angle=Math.random()*Math.PI*2,rad=Math.sqrt(Math.random())*(DOMAIN_RADIUS-margin);
    return {x:DOMAIN_CENTERS[0].x+rad*Math.cos(angle),y:DOMAIN_CENTERS[0].y+rad*Math.sin(angle)};
  }
  if(!isHexArena()) return {x:margin+Math.random()*(W-margin*2),y:margin+Math.random()*(H-margin*2)};
  const v=getArenaVertices(margin);
  const minX=Math.min(...v.map(p=>p.x)),maxX=Math.max(...v.map(p=>p.x));
  const minY=Math.min(...v.map(p=>p.y)),maxY=Math.max(...v.map(p=>p.y));
  for(let tries=0;tries<200;tries++){
    const x=minX+Math.random()*(maxX-minX), y=minY+Math.random()*(maxY-minY);
    if(pointInArena(x,y)) return {x,y};
  }
  return {x:W/2,y:H/2};
}
function keepPointInArena(obj,r=obj.r||0){
  if(isDomainMode()) return keepInCircle(obj,r,false);
  if(!isHexArena()) return false;
  const cx=W/2,cy=H/2;
  const v=getArenaVertices(r+2);
  let pushed=false;
  // For each inward-facing edge, keep the object's center far enough inside.
  for(let i=0;i<6;i++){
    const a=v[i],b=v[(i+1)%6];
    const ex=b.x-a.x, ey=b.y-a.y;
    const len=Math.hypot(ex,ey)||1;
    // left normal points toward the polygon center for CCW vertices
    const nx=-ey/len, ny=ex/len;
    const d=(obj.x-a.x)*nx+(obj.y-a.y)*ny;
    if(d<0){ obj.x-=nx*d; obj.y-=ny*d; pushed=true; }
  }
  return pushed;
}
function bouncePointOffArena(obj,r=obj.r||0){
  if(isDomainMode()) return keepInCircle(obj,r);
  if(!isHexArena()) return false;
  const cx=W/2,cy=H/2;
  const v=getArenaVertices(r+2);
  let bounced=false;
  for(let i=0;i<6;i++){
    const a=v[i],b=v[(i+1)%6];
    const ex=b.x-a.x, ey=b.y-a.y;
    const len=Math.hypot(ex,ey)||1;
    const nx=-ey/len, ny=ex/len;
    const d=(obj.x-a.x)*nx+(obj.y-a.y)*ny;
    if(d<0){
      obj.x-=nx*d; obj.y-=ny*d;
      const dot=obj.vx*nx+obj.vy*ny;
      if(dot<0){ obj.vx-=2*dot*nx; obj.vy-=2*dot*ny; }
      bounced=true;
    }
  }
  return bounced;
}


