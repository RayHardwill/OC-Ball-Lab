  }

  drawMattBall(ctx){
    const r=this.r;
    ctx.save();ctx.translate(this.x,this.y);
    if(this.mattBurstTimer>0||this.mattImmuneTimer>0){
      ctx.strokeStyle='rgba(114,255,170,.85)';ctx.shadowColor=MATT_GREEN;ctx.shadowBlur=18;
      ctx.lineWidth=3;ctx.beginPath();ctx.arc(0,0,r*1.22+Math.sin(performance.now()*.018)*3,0,Math.PI*2);ctx.stroke();ctx.shadowBlur=0;
    }
    if(this.mattSpinTimer>0){
      const elapsed=MATT_SPIN_DURATION-this.mattSpinTimer;
      const wind=Math.min(1,elapsed/.12);
      const sweep=Math.max(0,Math.min(1,(elapsed-.12)/.55));
      const fade=Math.min(1,this.mattSpinTimer/.13);
      const radius=r*6.95;
      const halo=ctx.createRadialGradient(0,0,r,0,0,r*7.3);
      halo.addColorStop(0,`rgba(180,255,210,${.12*fade})`);
      halo.addColorStop(.68,`rgba(72,255,152,${(.07+.09*wind)*fade})`);
      halo.addColorStop(1,'rgba(40,255,130,0)');
      ctx.fillStyle=halo;ctx.beginPath();ctx.arc(0,0,r*7.3,0,Math.PI*2);ctx.fill();
      // A short windup, a complete moving 360-degree blade trail, then a flash.
      ctx.shadowColor=MATT_GREEN;ctx.shadowBlur=23;
      ctx.strokeStyle=`rgba(128,255,177,${(.4+.45*wind)*fade})`;
      ctx.lineWidth=6;ctx.beginPath();ctx.arc(0,0,radius,0,Math.PI*2);ctx.stroke();
      ctx.lineCap='round';
      ctx.strokeStyle=`rgba(255,255,255,${.94*fade})`;ctx.lineWidth=12;
      ctx.beginPath();ctx.arc(0,0,radius,this.mattSpinStart,
        this.mattSpinStart+this.mattSpinDirection*Math.PI*2*sweep,this.mattSpinDirection<0);ctx.stroke();
      ctx.strokeStyle=`rgba(58,242,134,${.86*fade})`;ctx.lineWidth=21;
      ctx.shadowBlur=13;ctx.beginPath();ctx.arc(0,0,radius*.92,
        this.mattSwordAngle-this.mattSpinDirection*.73,
        this.mattSwordAngle+this.mattSpinDirection*.23,this.mattSpinDirection<0);ctx.stroke();
      ctx.shadowBlur=0;
      for(let i=5;i>=1;i--){
        ctx.globalAlpha=(1-sweep*.48)*(.045+i*.035)*fade;
        drawMattSword(ctx,this.mattSwordAngle-this.mattSpinDirection*i*.22,r);
      }
      ctx.globalAlpha=1;
      for(let i=0;i<15;i++){
        const a=i*2.399+this.id*23+this.mattSpinDirection*sweep*2;
        const distance=r*(1.7+(i%5)*.62+sweep*3.5);
        const size=r*(.055+(i%3)*.022)*fade;
        ctx.save();ctx.translate(Math.cos(a)*distance,Math.sin(a)*distance);
        ctx.rotate(a+sweep*6);ctx.fillStyle=i%3===0?'#fff':'#8dffc0';
        ctx.globalAlpha=(.35+.5*wind)*fade;ctx.fillRect(-size,-size,size*2,size*2);ctx.restore();
      }
      if(sweep>.75)for(let i=0;i<4;i++){
        const a=i*Math.PI/2+sweep*2.5;
        drawMattStar(ctx,Math.cos(a)*radius*.76,Math.sin(a)*radius*.76,r*.16,a,sweep*fade);
      }
    }
    drawMattSword(ctx,this.mattSwordAngle,r);
    drawMattIcon(ctx,0,0,r);
    ctx.restore();
  }

  drawMayhemBall(ctx){
