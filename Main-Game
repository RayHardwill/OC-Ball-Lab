let rayGraniteCharges = [];
let darkKnightPortals = [];
let darkKnightWindParticles = [];
let darkKnightShadowParticles = [];
let darkKnightSlashEffects = [];
let darkKnightStunTimers = {};
let emmyThrows = [];
let emmyUltBeams = [];
let artistBeams = [];
