  activateTreeUlt(){
    this.etUltActive = true;
    this.etUltDuration = 5;
    this.etUltExpandR = this.etGrowR;
    this.etUltExplosionDone = false;
    effects.push({type:'ult_flash',x:this.x,y:this.y,r:120,color:'#66ff88',t:0,dur:0.7});
    effects.push({type:'ult_flash',x:this.x,y:this.y,r:70,color:'#ffffff',t:0,dur:0.45});
    triggerScreenUltFlash('#003300', 0.65);
  }

  doTreeExplosion(enemies){
    const dmg = 250;
    const allActive = [...balls, ...copies].filter(b => b.alive && b.side !== this.side);
    allActive.forEach(e => {
      // Use a huge radius to guarantee full-arena coverage
      const fullCover = Math.hypot(W, H);
      if(Math.hypot(e.x - this.x, e.y - this.y) < fullCover + e.r){
        e.takeDamage(dmg,this);
        effects.push({type:'punch',x:e.x,y:e.y,t:0,dur:0.6});
        effects.push({type:'ring',x:e.x,y:e.y,r:e.r,maxR:e.r+80,color:'#aaff88',t:0,dur:0.55});
      }
    });
    const fullCover = Math.hypot(W, H);
    turrets.forEach(t=>{
      if(t.alive && t.side!==this.side && Math.hypot(t.x-this.x,t.y-this.y)<fullCover+t.r){
        t.takeDamage(dmg,this);
        effects.push({type:'punch',x:t.x,y:t.y,t:0,dur:0.6});
        effects.push({type:'ring',x:t.x,y:t.y,r:t.r,maxR:t.r+80,color:'#aaff88',t:0,dur:0.55});
      }
    });
    effects.push({type:'ring',x:this.x,y:this.y,r:this.etUltExpandR,maxR:fullCover+150,color:'#88ff66',t:0,dur:0.9});
    effects.push({type:'ring',x:this.x,y:this.y,r:this.etUltExpandR*0.5,maxR:fullCover+100,color:'#ffffff',t:0,dur:0.7});
    effects.push({type:'ult_flash',x:this.x,y:this.y,r:fullCover,color:'#aaff66',t:0,dur:0.9});
