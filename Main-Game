function drawRaySplash(ctx,x,y,dx,dy,size,time,seed=0,gray=false){
  // Broad, curling sheets of energy change shape and fade into detached drops.
  // The whole splash faces the incoming beam, so it spreads along the wall.
  const angle=Math.atan2(dy,dx),wake=Math.min(1,time*18);
  ctx.save();ctx.translate(x-dx*size*.18,y-dy*size*.18);ctx.rotate(angle);
  const pale=gray?'#ffffff':'#efffff',mid=gray?'#c5c5c5':'#a4f9ff';
  const glow=gray?'#dddddd':'#72eaff';
  const halo=ctx.createRadialGradient(-size*.14,0,3,-size*.14,0,size*.72);
  halo.addColorStop(0,gray?'rgba(250,250,250,.65)':'rgba(207,255,255,.69)');
  halo.addColorStop(.35,gray?'rgba(210,210,210,.28)':'rgba(94,220,255,.31)');
  halo.addColorStop(1,'rgba(90,190,240,0)');
  ctx.globalAlpha=.58*wake;ctx.fillStyle=halo;ctx.beginPath();ctx.arc(-size*.14,0,size*.72,0,Math.PI*2);ctx.fill();
  for(let i=0;i<9;i++){
    // Each sheet surges out and fades in a fraction of a second.
    const cycle=(time*(3.8+i%3*.3)+i*.117+seed*.163)%1;
    const shape=1-Math.pow(1-cycle,3);
    const alpha=Math.min(1,cycle*9)*Math.pow(1-cycle,1.3)*wake;
    const a=Math.PI*.48+i*Math.PI*.116+Math.sin(i*7.4+seed)*.18;
    const reach=size*(.55+(i%4)*.16)*(.2+shape);
    const tipX=Math.cos(a)*reach,tipY=Math.sin(a)*reach;
    const curl=(i%2?1:-1)*size*.16;
    const spread=size*(.105+(i%3)*.026);
    const startY=Math.sin(i*3.7)*size*.13;
    ctx.save();ctx.globalAlpha=alpha*(i%3===0?.91:.77);
    ctx.shadowColor=glow;ctx.shadowBlur=7;
    ctx.fillStyle=i%4===0?pale:mid;
    ctx.beginPath();ctx.moveTo(-size*.09,startY-spread);
    ctx.bezierCurveTo(-size*.26,tipY*.32-spread,tipX*.48-curl,tipY*.77-spread*.4,tipX,tipY);
    ctx.bezierCurveTo(tipX+curl*.75,tipY-spread*.6,tipX*.7+curl,tipY*.6+spread,tipX*.57,tipY*.51);
    ctx.bezierCurveTo(tipX*.35+spread,tipY*.23+spread,-size*.15,startY+spread,-size*.09,startY-spread);
    ctx.closePath();ctx.fill();
    // Irregular detached droplets, rather than equal spokes around a circle.
    for(let j=0;j<1;j++){
      const px=tipX*(1.14+j*.23)+Math.sin(i*13+j*3)*size*.075;
      const py=tipY*(1.12+j*.17)+Math.cos(i*9+j*5)*size*.08;
      ctx.globalAlpha=alpha*(.4-j*.12);ctx.beginPath();
      ctx.ellipse(px,py,size*(.018+j*.006),size*(.04+j*.009),a,0,Math.PI*2);ctx.fill();
    }
    ctx.restore();
  }
  ctx.globalAlpha=.76*wake;ctx.shadowColor=glow;ctx.shadowBlur=16;
  const core=ctx.createRadialGradient(-size*.2,0,1,-size*.2,0,size*.21);
  core.addColorStop(0,'#ffffff');core.addColorStop(.3,pale);core.addColorStop(1,gray?'rgba(210,210,210,0)':'rgba(130,250,255,0)');
  ctx.fillStyle=core;ctx.beginPath();ctx.arc(-size*.2,0,size*.21,0,Math.PI*2);ctx.fill();
  ctx.restore();
}
function rayArenaImpact(x,y,dx,dy,realm){
  if(Math.abs(dx)+Math.abs(dy)<1e-6){dx=1;dy=0;}
  const edges=rayHeptagonActive(realm)?rayHeptagonVertices():
    isHexArena()?getArenaVertices(2):null;
  if(edges){
    let nearest=Infinity;
    for(let i=0;i<edges.length;i++){
      const a=edges[i],b=edges[(i+1)%edges.length],ex=b.x-a.x,ey=b.y-a.y;
      const denom=dx*ey-dy*ex;
      if(Math.abs(denom)<1e-8)continue;
      const ox=a.x-x,oy=a.y-y,t=(ox*ey-oy*ex)/denom,u=(ox*dy-oy*dx)/denom;
      if(t>0.01&&u>=0&&u<=1&&t<nearest)nearest=t;
    }
    return {x:x+dx*(Number.isFinite(nearest)?nearest:0),y:y+dy*(Number.isFinite(nearest)?nearest:0)};
  }
  if(isDomainMode()){
    const c=DOMAIN_CENTERS[realm],ox=x-c.x,oy=y-c.y;
    const t=-(ox*dx+oy*dy)+Math.sqrt(Math.max(0,(ox*dx+oy*dy)**2+DOMAIN_RADIUS**2-ox*ox-oy*oy));
    return {x:x+dx*t,y:y+dy*t};
  }
  const ts=[];if(dx>0)ts.push((W-x)/dx);if(dx<0)ts.push(-x/dx);
  if(dy>0)ts.push((H-y)/dy);if(dy<0)ts.push(-y/dy);
  const t=Math.min(...ts.filter(n=>n>=0));return {x:x+dx*t,y:y+dy*t};
}

// ---- RAY LASER BOLT ----
function spawnRayTargetBeam(ray, enemies){
  // The alternate attack always locks onto the opponent's MAIN ball,
  // rather than copies or summoned units.
  const target = balls.filter(b=>b.alive && b.side!==ray.side && !b.isCopy && sameRealm(b,ray)).sort((a,b)=>Math.hypot(a.x-ray.x,a.y-ray.y)-Math.hypot(b.x-ray.x,b.y-ray.y))[0];
  if(!target) return;
  rayTargetBeams.push({
    owner: ray,
    target: target,
    side: ray.side,
    life: 0,
    dur: 3.5,charge:1,
    tickTimer: 0,
    chargeParticles:Array.from({length:32},(_,i)=>({
      angle:Math.random()*Math.PI*2,
      radius:ray.r*(3.8+Math.random()*2.5)+Math.random()*100,
      delay:Math.random()*.2,
      duration:.43+Math.random()*.32,
      bend:(Math.random()-.5)*.33,
      length:9+Math.random()*17,
      width:1+Math.random()*1.7
    })),
    tickInterval: 0.13,
    tickDamage: 4,
    alive: true,
    artistCopy: ray.char?.id==='maniac_artist'
  });
  effects.push({type:'ult_flash',x:ray.x,y:ray.y,r:55,color:ray.char?.id==='maniac_artist'?'#bbbbbb':'#00ffee',t:0,dur:0.3});
}

function spawnRayLasers(ray, enemies){
  if(!enemies.length) return;
  // Ray's projectile activation has a 33% chance to become the new
  // continuous target beam instead of the normal projectile volley.
  if(Math.random() < 0.33){
    spawnRayTargetBeam(ray, enemies);
    return;
  }
  const target = enemies[Math.floor(Math.random()*enemies.length)];
  const count = 4;
  for(let i=0;i<count;i++){
    setTimeout(()=>{
      if(!ray.alive || !gameRunning || !target.alive || !sameRealm(ray,target)) return;
      const dx = target.x - ray.x + (Math.random()-0.5)*40;
      const dy = target.y - ray.y + (Math.random()-0.5)*40;
      const dist = Math.hypot(dx,dy)||1;
      const spd = 10;
      rayLasers.push({
        x: ray.x, y: ray.y,
        realm:ray.realm||0,
        vx: dx/dist*spd, vy: dy/dist*spd,
        side: ray.side,
        r: R*0.9*scaleFor(ray),
        source: ray,
        damage: 28,
        bounces: 0,
        maxBounces: 8,
        alive: true,
        life: 0,
        maxLife: 12,
        color: ray.char?.id==='maniac_artist'?'#8d8d8d':RAY_WALL_COLORS[Math.floor(Math.random()*RAY_WALL_COLORS.length)],
        trail: [],
        hitCooldowns: {},
        turretHitCooldowns: {}
      });
      rayBurst(ray.x,ray.y,ray.realm||0,ray.char?.id==='maniac_artist'?'#c7c7c7':'#9ff9ff',28);
    }, i * 280);
  }
  effects.push({type:'ult_flash',x:ray.x,y:ray.y,r:60,color:'#00ffee',t:0,dur:0.35});
}

// Ray's fourth ability: a damage-triggered volley of six moving beam paths.
// The moving tip deals 35 once per enemy; its lingering path deals 8 every .2s.
const RAY_GRANITE_CHARGE_TIME=1.25;
const RAY_GRANITE_SPEED=345*1.75;

function beginRayGraniteCharge(ray){
  rayGraniteCharges.push({
    owner:ray,life:0,dur:RAY_GRANITE_CHARGE_TIME,
    particles:Array.from({length:38},()=>({
      angle:Math.random()*Math.PI*2,
      radius:ray.r*(3.8+Math.random()*2.8)+Math.random()*75,
      delay:Math.random()*.55,duration:.42+Math.random()*.4,
      bend:(Math.random()-.5)*.5,length:10+Math.random()*22,width:1+Math.random()*1.8
    }))
  });
  effects.push({type:'ring',x:ray.x,y:ray.y,r:ray.r,maxR:ray.r*2.5,color:'#c9a0ff',t:0,dur:.55});
}

function updateRayGraniteCharge(charge,dt){
  if(!charge.owner.alive)return false;
  charge.life+=dt;
  if(charge.life<charge.dur)return true;
  activateRayGraniteBlast(charge.owner);
  effects.push({type:'ult_flash',x:charge.owner.x,y:charge.owner.y,r:charge.owner.r*3.2,color:'#bd92f6',t:0,dur:.4});
  return false;
}

function drawRayGraniteCharge(ctx,charge){
  const ray=charge.owner,p=Math.min(1,charge.life/charge.dur),r=ray.r;
  const focusY=-r*1.4;
  ctx.save();ctx.translate(ray.x,ray.y);ctx.lineCap='round';
  ctx.shadowColor='#c5a0ff';ctx.shadowBlur=10;
  for(const particle of charge.particles){
    const q=(charge.life-particle.delay)/particle.duration;
    if(q<=0||q>=1)continue;
    const eased=1-Math.pow(1-q,2.4),a=particle.angle+particle.bend*(1-eased);
    const distance=particle.radius*(1-eased)+r*.13*eased;
    ctx.globalAlpha=Math.min(1,q*5)*Math.min(1,(1-q)*5)*(.55+.4*p);
    ctx.strokeStyle=particle.width>2.1?'#ffffff':'#d9b9ff';ctx.lineWidth=particle.width;
    ctx.beginPath();ctx.moveTo(Math.cos(a)*(distance+particle.length),focusY+Math.sin(a)*(distance+particle.length));
    ctx.lineTo(Math.cos(a)*distance,focusY+Math.sin(a)*distance);ctx.stroke();
  }
  ctx.shadowBlur=0;ctx.globalAlpha=.25+.52*p;
  ctx.strokeStyle='#c8a2ff';ctx.lineWidth=2.5+2*p;
  ctx.beginPath();ctx.arc(0,0,r*(1.35+.25*Math.sin(charge.life*9)),0,Math.PI*2);ctx.stroke();
  ctx.globalAlpha=.12+.42*p;ctx.lineWidth=1.4;
  ctx.beginPath();ctx.arc(0,0,r*(2.05-.28*p),0,Math.PI*2);ctx.stroke();
  ctx.globalAlpha=Math.max(0,(p-.35)/.65)*.7;ctx.strokeStyle='#f2e7ff';ctx.lineWidth=2.4;
  for(let i=0;i<6;i++){
    const a=i*Math.PI/3;
    ctx.beginPath();ctx.moveTo(Math.cos(a)*r*.82,Math.sin(a)*r*.82);
    ctx.lineTo(Math.cos(a)*r*(1.3+.55*p),Math.sin(a)*r*(1.3+.55*p));ctx.stroke();
  }
  const orb=ctx.createRadialGradient(0,focusY,r*.08,0,focusY,r*(.48+.32*p));
  orb.addColorStop(0,'rgba(255,255,255,.96)');orb.addColorStop(.38,'rgba(226,203,255,.85)');orb.addColorStop(1,'rgba(169,113,245,0)');
  ctx.globalAlpha=.7+.25*p;ctx.fillStyle=orb;ctx.shadowColor='#b483f1';ctx.shadowBlur=12+14*p;
  ctx.beginPath();ctx.arc(0,focusY,r*(.48+.32*p),0,Math.PI*2);ctx.fill();
  ctx.restore();
}

function activateRayGraniteBlast(ray){
  for(let i=0;i<6;i++){
    const angle=i*Math.PI/3;
    rayGraniteBlasts.push({
      owner:ray,side:ray.side,realm:ray.realm||0,
      x:ray.x+Math.cos(angle)*ray.r*.85,y:ray.y+Math.sin(angle)*ray.r*.85,
      angle,life:0,maxLife:2.7,active:true,target:null,
      seed:Math.random()*Math.PI*2,width:Math.max(10,ray.r*.43),
      trail:[],bodyHits:new Set(),trailCooldowns:new Map()
    });
  }
  effects.push({type:'ring',x:ray.x,y:ray.y,r:ray.r,maxR:ray.r*3.3,color:'#d5acff',t:0,dur:.5});
}

function rayGranitePointDistance(px,py,a,b){
  const dx=b.x-a.x,dy=b.y-a.y;
  const t=Math.max(0,Math.min(1,((px-a.x)*dx+(py-a.y)*dy)/(dx*dx+dy*dy||1)));
  return Math.hypot(px-a.x-dx*t,py-a.y-dy*t);
}

function updateRayGraniteBlast(beam,dt){
  beam.trail.forEach(segment=>segment.age+=dt);
  beam.trail=beam.trail.filter(segment=>segment.age<1.25);
  for(const [id,left] of beam.trailCooldowns){
    if(left<=dt)beam.trailCooldowns.delete(id);
    else beam.trailCooldowns.set(id,left-dt);
  }
  if(beam.active){
    beam.life+=dt;
    if(beam.life>=beam.maxLife || !beam.owner.alive)beam.active=false;
    else{
      if(beam.life>=.4){
        const candidates=[...balls,...copies].filter(e=>e.alive&&e.side!==beam.side&&sameRealm(e,beam));
        if(!beam.target || !candidates.includes(beam.target))beam.target=candidates[Math.floor(Math.random()*candidates.length)]||null;
        if(beam.target){
          const desired=Math.atan2(beam.target.y-beam.y,beam.target.x-beam.x);
          const turn=Math.atan2(Math.sin(desired-beam.angle),Math.cos(desired-beam.angle));
          const wobble=Math.sin(beam.life*12+beam.seed)*1.2+Math.sin(beam.life*21+beam.seed*2)*.65;
          beam.angle+=Math.max(-4.3*dt,Math.min(4.3*dt,turn*3.1*dt+wobble*dt));
        }
      }else beam.angle+=Math.sin(beam.life*16+beam.seed)*1.3*dt;
      // Substeps preserve the curved path and prevent a fast tip from skipping targets.
      const steps=Math.max(1,Math.ceil(dt*60));
      for(let i=0;i<steps;i++){
        const before={x:beam.x,y:beam.y};
        beam.x+=Math.cos(beam.angle)*RAY_GRANITE_SPEED*dt/steps;
        beam.y+=Math.sin(beam.angle)*RAY_GRANITE_SPEED*dt/steps;
        const probe={x:beam.x,y:beam.y,realm:beam.realm};
        const outside=isDomainMode()||isHexArena()
          ?bouncePointOffArena(probe,beam.width*.5)
          :beam.x<beam.width*.5||beam.x>W-beam.width*.5||beam.y<beam.width*.5||beam.y>H-beam.width*.5;
        if(outside){beam.x=probe.x;beam.y=probe.y;beam.active=false;break;}
        beam.trail.push({a:before,b:{x:beam.x,y:beam.y},age:0});
        for(const e of [...balls,...copies,...turrets]){
          if(!e.alive||e.side===beam.side||!sameRealm(e,beam)||beam.bodyHits.has(e.id))continue;
          const radius=e.char?.id==='elder_tree'?e.etGrowR:e.r;
          if(rayGranitePointDistance(e.x,e.y,before,beam)<radius+beam.width*.5){
            beam.bodyHits.add(e.id);
            e.takeDamage(35,beam.owner);
            effects.push({type:'ring',x:e.x,y:e.y,r:radius,maxR:radius+40,color:'#dfb9ff',t:0,dur:.35});
          }
        }
      }
    }
  }
  // Trail damage continues for 1.25 seconds after each piece of beam has passed.
  for(const e of [...balls,...copies,...turrets]){
    if(!e.alive||e.side===beam.side||!sameRealm(e,beam)||beam.trailCooldowns.has(e.id))continue;
    const radius=e.char?.id==='elder_tree'?e.etGrowR:e.r;
    if(beam.trail.some(segment=>rayGranitePointDistance(e.x,e.y,segment.a,segment.b)<radius+beam.width*.55)){
      beam.trailCooldowns.set(e.id,.2);
      e.takeDamage(8,beam.owner);
    }
  }
}

function drawRayGraniteBlast(ctx,beam){
  ctx.save();ctx.lineCap='round';ctx.lineJoin='round';
  // Six fading age bands keep the path continuous but need only 18 strokes,
  // instead of three shadowed strokes for every individual trail segment.
  for(let band=0;band<6;band++){
    ctx.beginPath();let hasSegments=false;
    for(const segment of beam.trail){
      if(Math.min(5,Math.floor(segment.age/1.25*6))!==band)continue;
      ctx.moveTo(segment.a.x,segment.a.y);ctx.lineTo(segment.b.x,segment.b.y);hasSegments=true;
    }
    if(!hasSegments)continue;
    const fade=1-(band+.5)/6;
    ctx.globalAlpha=fade*.42;ctx.strokeStyle='#9656d9';ctx.lineWidth=beam.width*2.5;ctx.shadowColor='#c295ff';ctx.shadowBlur=8;ctx.stroke();
    ctx.globalAlpha=fade*.88;ctx.strokeStyle='#d9b5ff';ctx.lineWidth=beam.width;ctx.shadowBlur=4;ctx.stroke();
    ctx.globalAlpha=fade;ctx.strokeStyle='#fff7e6';ctx.lineWidth=beam.width*.35;ctx.shadowBlur=0;ctx.stroke();
  }
  if(beam.active){
    ctx.globalAlpha=.95;ctx.beginPath();
    ctx.moveTo(beam.x-Math.cos(beam.angle)*beam.width*1.6,beam.y-Math.sin(beam.angle)*beam.width*1.6);
    ctx.lineTo(beam.x,beam.y);ctx.strokeStyle='#fffdf2';ctx.lineWidth=beam.width*.65;ctx.shadowColor='#ead0ff';ctx.shadowBlur=16;ctx.stroke();
  }
  ctx.restore();
}

function updateRayLaser(laser, dt){
  if(!laser.alive) return;
  const beforeBounces=laser.bounces;
  laser.life += dt;
  if(laser.life > laser.maxLife){ laser.alive=false; return; }

  laser.trail.push({x:laser.x, y:laser.y});
  if(laser.trail.length > 8) laser.trail.shift();

  laser.x += laser.vx;
  laser.y += laser.vy;

  if(isDomainMode()||isHexArena()){
    if(bouncePointOffArena(laser,laser.r))laser.bounces++;
  }else{
    if(laser.x - laser.r < 0){ laser.x=laser.r; laser.vx=Math.abs(laser.vx); laser.bounces++; }
    if(laser.x + laser.r > W){ laser.x=W-laser.r; laser.vx=-Math.abs(laser.vx); laser.bounces++; }
    if(laser.y - laser.r < 0){ laser.y=laser.r; laser.vy=Math.abs(laser.vy); laser.bounces++; }
    if(laser.y + laser.r > H){ laser.y=H-laser.r; laser.vy=-Math.abs(laser.vy); laser.bounces++; }
  }
  if(laser.bounces>beforeBounces)rayBurst(laser.x,laser.y,laser.realm,laser.color,laser.domainBeam?48:27);
  if(laser.bounces >= laser.maxBounces){ laser.alive=false; return; }

  const allActive = [...balls,...copies].filter(b=>b.alive&&b.side!==laser.side&&sameRealm(b,laser));
  for(const e of allActive){
    const eR = e.char.id==='elder_tree' ? e.etGrowR : e.r;
    if(Math.hypot(e.x-laser.x,e.y-laser.y) < eR+laser.r){
      const key = e.id;
      if(!laser.hitCooldowns[key] || laser.hitCooldowns[key]<=0){
        laser.hitCooldowns[key] = 0.4;
        e.takeDamage(laser.damage,laser.source);
        if(laser.source.char?.id==='ray'&&!laser.source.isCopy) domainCount(laser.source,'laserHits',1);
        effects.push({type:'ring',x:e.x,y:e.y,r:eR,maxR:eR+45,color:laser.color,t:0,dur:0.4});
        if(!laser.domainBeam)rayBurst(e.x,e.y,laser.realm,laser.color,30);
      }
    }
  }
  for(const t of turrets){
    if(!t.alive || t.side===laser.side || !sameRealm(t,laser)) continue;
    const key=t.id;
    if(Math.hypot(t.x-laser.x,t.y-laser.y)<t.r+laser.r &&
       (!laser.turretHitCooldowns[key] || laser.turretHitCooldowns[key]<=0)){
      laser.turretHitCooldowns[key]=0.4;
      t.takeDamage(laser.damage,laser.source);
      effects.push({type:'ring',x:t.x,y:t.y,r:t.r,maxR:t.r+45,color:laser.color,t:0,dur:0.4});
    }
  }
  for(const k in laser.hitCooldowns) laser.hitCooldowns[k]-=dt;
  for(const k in laser.turretHitCooldowns) laser.turretHitCooldowns[k]-=dt;
}

function updateRayTargetBeam(beam, dt){
  if(!beam.alive) return;
  beam.life += dt;

  if(beam.life >= beam.dur || !beam.owner || !beam.owner.alive || !beam.target || !beam.target.alive || !sameRealm(beam.owner,beam.target)){
    beam.alive = false;
    return;
  }

  if(beam.life<beam.charge)return;
  beam.tickTimer += dt;

  while(beam.tickTimer >= beam.tickInterval){
    beam.tickTimer -= beam.tickInterval;

    // Damage every enemy ball the beam passes through, while still locking
    // the beam's direction onto the main enemy. This includes summons/copies
    // such as Manic Lion spawns and Engineer turrets.
    const x1=beam.owner.x, y1=beam.owner.y;
    const x2=beam.target.x, y2=beam.target.y;
    const vx=x2-x1, vy=y2-y1;
    const lenSq=vx*vx+vy*vy || 1;

    balls.forEach(enemy=>{
      if(!enemy.alive || enemy.side===beam.owner.side || !sameRealm(enemy,beam.owner)) return;
      const wx=enemy.x-x1, wy=enemy.y-y1;
      const t=Math.max(0,Math.min(1,(wx*vx+wy*vy)/lenSq));
      const px=x1+vx*t, py=y1+vy*t;
      const hitRadius=(enemy.r||R)+5;
      if(Math.hypot(enemy.x-px,enemy.y-py) <= hitRadius){
        enemy.takeDamage(beam.tickDamage,beam.owner);
        if(!beam.domainCredited && beam.owner.char.id==='ray' && !beam.owner.isCopy){
          beam.domainCredited=true;
          domainCount(beam.owner,'directLasers',1);
        }
        effects.push({type:'ring',x:enemy.x,y:enemy.y,r:enemy.r,maxR:enemy.r+16,color:beam.artistCopy?'#bbbbbb':'#00ffee',t:0,dur:0.18});
      }
    });
  }
}

function drawRayTargetBeam(ctx, beam){
  if(!beam.alive || !beam.owner || !beam.target) return;
  const dx=beam.target.x-beam.owner.x;
  const dy=beam.target.y-beam.owner.y;
  const dist=Math.hypot(dx,dy)||1;
  const angle=Math.atan2(dy,dx);
  if(beam.life<beam.charge){
    const p=beam.life/beam.charge,r=beam.owner.r;
    const glow=beam.artistCopy?'#dedede':'#a4ffff';
    ctx.save();ctx.translate(beam.owner.x,beam.owner.y);
    ctx.lineCap='round';ctx.shadowColor=glow;ctx.shadowBlur=11;
    for(const particle of beam.chargeParticles){
      const q=(beam.life-particle.delay)/particle.duration;
      if(q<=0||q>=1)continue;
      const eased=1-Math.pow(1-q,2.4);
      const a=particle.angle+particle.bend*(1-eased);
      const distance=particle.radius*(1-eased)+r*.16*eased;
      const tail=particle.length*(1-q*.4);
      ctx.globalAlpha=Math.min(1,q*5)*Math.min(1,(1-q)*5)*(.4+.45*p);
      ctx.strokeStyle=particle.width>2.1?'#ffffff':glow;
      ctx.lineWidth=particle.width;ctx.beginPath();
      ctx.moveTo(Math.cos(a)*(distance+tail),Math.sin(a)*(distance+tail));
      ctx.lineTo(Math.cos(a)*distance,Math.sin(a)*distance);ctx.stroke();
    }
    // Particles visibly sink into this orb before the beam is released.
    ctx.globalAlpha=.6+.4*p;ctx.shadowBlur=18+22*p;
    const orb=ctx.createRadialGradient(0,0,1,0,0,r*(.44+.25*p));
    orb.addColorStop(0,'#ffffff');orb.addColorStop(.46,beam.artistCopy?'#ececec':'#b8ffff');
    orb.addColorStop(1,beam.artistCopy?'rgba(180,180,180,0)':'rgba(0,243,239,0)');
    ctx.fillStyle=orb;ctx.beginPath();ctx.arc(0,0,r*(.44+.25*p),0,Math.PI*2);ctx.fill();
    ctx.restore();return;
  }
  const frac=beam.life/beam.dur;
  const alpha=frac>0.82 ? (1-frac)/0.18 : 1;
  const length=dist;
  const gray=beam.artistCopy;

  ctx.save();
  ctx.globalAlpha=alpha;
  ctx.translate(beam.owner.x,beam.owner.y);
  ctx.rotate(angle);
  ctx.lineCap='round';ctx.shadowColor=gray?'#dddddd':'#44dcff';ctx.shadowBlur=15;
  ctx.strokeStyle=gray?'rgba(190,190,190,.59)':'rgba(67,228,255,.51)';
  ctx.lineWidth=10;ctx.beginPath();ctx.moveTo(0,0);ctx.lineTo(length,0);ctx.stroke();
  ctx.strokeStyle=gray?'#d6d6d6':'#9df5ff';ctx.lineWidth=4.2;ctx.stroke();
  ctx.strokeStyle='#ffffff';ctx.lineWidth=1.7;ctx.shadowBlur=7;ctx.stroke();
  ctx.fillStyle=gray?'#eeeeee':'#d8ffff';ctx.shadowBlur=10;
  ctx.beginPath();ctx.arc(length,0,3,0,Math.PI*2);ctx.fill();
  ctx.restore();
}

function drawRayLaser(ctx, laser){
  if(!laser.alive) return;
  ctx.save();
  if(laser.domainBeam){
    const vx=laser.vx,vy=laser.vy,angle=Math.atan2(vy,vx),length=70+laser.r*3;
    ctx.translate(laser.x,laser.y);ctx.rotate(angle);ctx.lineCap='round';
    ctx.shadowColor='#bdeeff';ctx.shadowBlur=21;
    ctx.strokeStyle='rgba(97,181,255,.34)';ctx.lineWidth=laser.r*1.8;
    ctx.beginPath();ctx.moveTo(-length,0);ctx.lineTo(laser.r,0);ctx.stroke();
    ctx.strokeStyle='#e9ffff';ctx.lineWidth=Math.max(4,laser.r*.54);ctx.stroke();
    for(let i=0;i<3;i++){
      const v=performance.now()*.014+i*2.1;
      ctx.strokeStyle='rgba(185,231,255,.8)';ctx.lineWidth=2;
      ctx.beginPath();ctx.ellipse(-length*.3+i*22,0,laser.r*.28,laser.r*.9,v,0,Math.PI*2);ctx.stroke();
    }
    ctx.restore();return;
  }
  // Traveling energy pulses grow from each projectile instead of appearing
  // only at launch or on collision.
  for(let ring=0;ring<2;ring++){
    const p=(laser.life*2.9+ring*.5)%1;
    const radius=laser.r*(1.1+p*2.3);
    ctx.globalAlpha=(1-p)*.66;
    ctx.shadowColor=laser.color;ctx.shadowBlur=11;
    ctx.strokeStyle=laser.color;ctx.lineWidth=3.3*(1-p)+.65;
    ctx.beginPath();ctx.ellipse(laser.x,laser.y,radius,radius*.82,Math.atan2(laser.vy,laser.vx),0,Math.PI*2);ctx.stroke();
  }
  ctx.shadowBlur=0;
  for(let i=0;i<laser.trail.length;i++){
    const a = (i/laser.trail.length)*0.65;
    ctx.globalAlpha=a;
    ctx.beginPath();
    ctx.arc(laser.trail[i].x,laser.trail[i].y,laser.r*(0.3+0.7*i/laser.trail.length),0,Math.PI*2);
    ctx.fillStyle=laser.color;
    ctx.fill();
  }
  ctx.globalAlpha=1;
  ctx.shadowColor=laser.color;
  ctx.shadowBlur=20;
  const grad = ctx.createRadialGradient(laser.x,laser.y,0,laser.x,laser.y,laser.r);
  grad.addColorStop(0,'#ffffff');
  grad.addColorStop(0.3,laser.color);
  grad.addColorStop(1,laser.color+'44');
  ctx.beginPath();
  ctx.arc(laser.x,laser.y,laser.r,0,Math.PI*2);
  ctx.fillStyle=grad;
  ctx.fill();
  ctx.beginPath();
  ctx.arc(laser.x,laser.y,laser.r*0.35,0,Math.PI*2);
  ctx.fillStyle='#ffffff';
  ctx.fill();
  ctx.shadowBlur=0;
  ctx.globalAlpha=0.8;
  ctx.fillStyle='#ffffff';
  ctx.font='bold 10px Rajdhani';
  ctx.textAlign='center';
  ctx.fillText(laser.maxBounces-laser.bounces, laser.x, laser.y+3);
  ctx.restore();
}

// ---- RAY ULT: SPINNING CROSS LASER ----
function activateRayUlt(ray){
  rayUltBeams.push({
    x: ray.x, y: ray.y,
    angle: 0,
    orbAngle: 0,
    spinSpeed: 2.5,
    side: ray.side,
    owner: ray,
    life: 0,
    dur: 7,charge:3,
    alive: true,
    armLength: Math.max(Math.hypot(W,H)*1.25,DOMAIN_RADIUS*2.5),
    armWidth: R*1.1,
    slowEffect: 0.5
  });
  effects.push({type:'ult_flash',x:ray.x,y:ray.y,r:120,color:'#00ffee',t:0,dur:0.7});
  effects.push({type:'ult_flash',x:ray.x,y:ray.y,r:70,color:'#ffffff',t:0,dur:0.45});
  triggerScreenUltFlash('#003333', 0.6);
}

function updateRayUlt(beam, dt){
  if(!beam.alive) return;
  const previousLife=beam.life;
  beam.life += dt;
  if(beam.life >= beam.dur){ beam.alive=false; return; }

  if(beam.life<beam.charge){
    const p=beam.life/beam.charge;
    beam.orbAngle+=(.13+.35*p+24*p*p*p)*dt;
  }else{
    beam.angle+=beam.spinSpeed*dt;
    if(previousLife<beam.charge){
      rayBurst(beam.x,beam.y,beam.owner.realm||0,'#b0ffff',beam.owner.r*3);
    }
  }

  if(beam.owner && beam.owner.alive){
    beam.x = beam.owner.x;
    beam.y = beam.owner.y;
  }

  if(beam.life<beam.charge)return;

  const allActive = [...balls,...copies].filter(b=>b.alive&&b.side!==beam.side&&sameRealm(b,beam.owner));
  allActive.forEach(e=>{
    const eR = e.char.id==='elder_tree' ? e.etGrowR : e.r;
    if(isInCrossBeam(e.x,e.y,eR,beam)){
      // Use takeDamage so Ray's ultimate damage is credited to Ray's
      // damage-dealt counter just like every other attack.
      e.takeDamage(3 * dt * 60,beam.owner);
      if(!e.alive) return;
      e.rayCrossSlowTimer=.18;
      const spd=Math.hypot(e.vx,e.vy)||1,targetSpd=e.getSpeed();
      e.vx=e.vx/spd*targetSpd;e.vy=e.vy/spd*targetSpd;
      if(Math.random()<0.04){
        effects.push({type:'ring',x:e.x,y:e.y,r:eR,maxR:eR+20,color:'#00ffee',t:0,dur:0.25});
      }
    }
  });
  turrets.forEach(t=>{
    if(!t.alive || t.side===beam.side || !sameRealm(t,beam.owner)) return;
    if(isInCrossBeam(t.x,t.y,t.r,beam)){
      t.takeDamage(4 * dt * 60,beam.owner);
      if(Math.random()<0.04) effects.push({type:'ring',x:t.x,y:t.y,r:t.r,maxR:t.r+20,color:'#00ffee',t:0,dur:0.25});
    }
  });
}

function rayUltTaper(beam){return Math.max(0,Math.min(1,(beam.dur-beam.life)/.35));}
function isInCrossBeam(ex, ey, er, beam){
  const dx = ex - beam.x;
  const dy = ey - beam.y;
  const halfW = beam.armWidth*rayUltTaper(beam);
  const armLen = beam.armLength;
  for(let arm=0;arm<4;arm++){
    const a = beam.angle + arm * Math.PI/2;
    const cos = Math.cos(-a), sin = Math.sin(-a);
    const lx = dx*cos - dy*sin;
    const ly = dx*sin + dy*cos;
    if(lx >= -er && lx <= armLen+er && Math.abs(ly) <= halfW+er) return true;
  }
  return false;
}

function drawRayUltBeam(ctx, beam){
  if(!beam.alive)return;
  const r=beam.owner.r;
  if(beam.life<beam.charge){
    const p=beam.life/beam.charge;
    const collapse=Math.max(0,(p-.92)/.08);
    const orbit=r*(2.65-.45*p)*(1-collapse);
    const trailLength=.05+p*p*1.2;
    ctx.save();ctx.translate(beam.x,beam.y);
    for(let i=0;i<4;i++){
      const a=beam.orbAngle+i*Math.PI/2;
      const px=Math.cos(a)*orbit,py=Math.sin(a)*orbit;
      const rr=r*(.27+.12*p);
      if(p>.22){
        ctx.strokeStyle=i%2?'rgba(150,235,255,.52)':'rgba(104,255,236,.55)';
        ctx.shadowColor='#71fff5';ctx.shadowBlur=12+10*p;
        ctx.lineWidth=rr*(.5+p*.65);ctx.lineCap='round';
        ctx.beginPath();ctx.arc(0,0,orbit,a-trailLength,a);ctx.stroke();
      }
      ctx.shadowColor=i%2?'#c6faff':'#6affea';ctx.shadowBlur=17+17*p;
      const orb=ctx.createRadialGradient(px-rr*.25,py-rr*.25,1,px,py,rr*1.75);
      orb.addColorStop(0,'#ffffff');orb.addColorStop(.28,i%2?'#e6ffff':'#c5fff3');
      orb.addColorStop(.65,i%2?'#7ae9ff':'#59eedb');orb.addColorStop(1,'rgba(50,229,245,0)');
      ctx.fillStyle=orb;ctx.beginPath();ctx.arc(px,py,rr*1.75,0,Math.PI*2);ctx.fill();
    }
    if(collapse>0){
      ctx.fillStyle=`rgba(230,255,255,${collapse*.8})`;
      ctx.shadowColor='#8affff';ctx.shadowBlur=35;
      ctx.beginPath();ctx.arc(0,0,r*(.5+collapse*.34),0,Math.PI*2);ctx.fill();
    }
    ctx.restore();return;
  }
  const active=beam.life-beam.charge;
  const taper=rayUltTaper(beam);
  const endAlpha=Math.min(1,(beam.dur-beam.life)/.35);
  const startAlpha=Math.min(1,active/.14);
  const alpha=Math.max(0,Math.min(startAlpha,endAlpha));
  const now=performance.now()*.001;
  ctx.save();ctx.translate(beam.x,beam.y);
  ctx.globalAlpha=alpha;ctx.globalCompositeOperation='lighter';
  for(let arm=0;arm<4;arm++){
    const a=beam.angle+arm*Math.PI/2;
    const impact=rayArenaImpact(beam.x,beam.y,Math.cos(a),Math.sin(a),beam.owner.realm||0);
    const length=Math.min(beam.armLength,Math.hypot(impact.x-beam.x,impact.y-beam.y)+5);
    ctx.save();ctx.rotate(a);ctx.lineCap='round';
    const w=beam.armWidth*taper;
    ctx.shadowColor='#45f4ff';ctx.shadowBlur=39;
    ctx.strokeStyle='rgba(35,223,244,.62)';ctx.lineWidth=w*3.4;
    ctx.beginPath();ctx.moveTo(0,0);ctx.lineTo(length,0);ctx.stroke();
    ctx.shadowBlur=20;ctx.strokeStyle='rgba(65,255,224,.65)';ctx.lineWidth=w*1.9;ctx.stroke();
    // A thick, shaped band with a white core and moving energy along its edges.
    const face=ctx.createLinearGradient(0,-w,0,w);
    face.addColorStop(0,'#43dff7');face.addColorStop(.24,'#69fff1');
    face.addColorStop(.5,'#efffff');face.addColorStop(.76,'#62faff');face.addColorStop(1,'#20bddc');
    ctx.fillStyle=face;ctx.shadowColor='#aaffff';ctx.shadowBlur=13;
    ctx.beginPath();ctx.moveTo(0,-w*.72);
    for(let k=1;k<=22;k++){
      const x=length*k/22;
      ctx.lineTo(x,-w*(.73+.095*Math.sin(now*12-k*.95+arm)));
    }
    for(let k=22;k>=0;k--){
      const x=length*k/22;
      ctx.lineTo(x,w*(.73+.095*Math.sin(now*11+k*1.14+arm)));
    }
    ctx.closePath();ctx.fill();
    ctx.shadowBlur=17;ctx.strokeStyle='#ffffff';ctx.lineWidth=w*.40;
    ctx.beginPath();ctx.moveTo(0,0);ctx.lineTo(length,0);ctx.stroke();
    // Bright streams race from Ray to the wall. A darker outline keeps
    // their movement readable against the beam's solid white center.
    ctx.save();ctx.globalCompositeOperation='source-over';
    for(let i=0;i<20;i++){
      const speed=1450+(i%6)*190;
      const head=(active*speed+i*length/20)%Math.max(1,length);
      const tail=Math.max(0,head-(64+i%5*24));
      const lane=((i%8)-3.5)*w*.18;
      const bend=Math.sin(now*19+i*2.5)*w*.045;
      ctx.globalAlpha=alpha*(.62+(i%4)*.11);
      ctx.shadowBlur=0;ctx.strokeStyle='#079fc0';ctx.lineWidth=(i%3===0?5:4)*taper;
      ctx.beginPath();ctx.moveTo(tail,lane-bend);
      ctx.quadraticCurveTo((tail+head)*.5,lane+bend,head,lane);ctx.stroke();
      ctx.shadowColor='#abffff';ctx.shadowBlur=8*taper;
      ctx.strokeStyle='#f5ffff';ctx.lineWidth=(i%3===0?2.6:1.8)*taper;ctx.stroke();
    }
    ctx.restore();
    ctx.restore();
  }
  ctx.shadowColor='#bdffff';ctx.shadowBlur=34;
  const cg=ctx.createRadialGradient(0,0,1,0,0,r*1.25);
  cg.addColorStop(0,'#ffffff');cg.addColorStop(.45,'#a8fff9');cg.addColorStop(1,'rgba(30,215,240,0)');
  ctx.fillStyle=cg;ctx.beginPath();ctx.arc(0,0,r*1.25,0,Math.PI*2);ctx.fill();
  ctx.restore();
  // Four fluid wall impacts are clipped by the arena but spread back inside it.
  for(let arm=0;arm<4&&taper>.1;arm++){
    const a=beam.angle+arm*Math.PI/2,ux=Math.cos(a),uy=Math.sin(a);
    const impact=rayArenaImpact(beam.x,beam.y,ux,uy,beam.owner.realm||0);
    drawRaySplash(ctx,impact.x,impact.y,ux,uy,Math.max(18,160*taper),active,arm);
  }
}

// ---- ELDER TREE DRAW ----
function drawElderTree(ctx, x, y, r, growBonus, ultActive){
  ctx.save();
  ctx.translate(x, y);
  const effectiveR = r;

  const tendrils = 6;
  ctx.strokeStyle = '#3a2208';
  ctx.lineWidth = Math.max(1.5, r * 0.12);
  for(let i = 0; i < tendrils; i++){
    const baseAngle = (i / tendrils) * Math.PI * 2 + Math.PI * 0.15;
    ctx.beginPath();
    ctx.moveTo(Math.cos(baseAngle) * r * 0.75, Math.sin(baseAngle) * r * 0.75);
    const cx1 = Math.cos(baseAngle + 0.4) * r * 1.1;
    const cy1 = Math.sin(baseAngle + 0.4) * r * 1.1;
    const ex = Math.cos(baseAngle - 0.2) * r * 1.35;
    const ey = Math.sin(baseAngle - 0.2) * r * 1.35;
    ctx.quadraticCurveTo(cx1, cy1, ex, ey);
    ctx.stroke();
  }

  const barkGrad = ctx.createRadialGradient(-r*0.2, -r*0.2, r*0.1, 0, 0, r);
  barkGrad.addColorStop(0, '#7a5230');
  barkGrad.addColorStop(0.5, '#5a3a18');
  barkGrad.addColorStop(1, '#2e1c08');
  ctx.beginPath();
  ctx.arc(0, 0, r, 0, Math.PI * 2);
  ctx.fillStyle = barkGrad;
  ctx.fill();

  ctx.strokeStyle = 'rgba(30, 15, 5, 0.55)';
  ctx.lineWidth = 1;
  for(let i = 0; i < 5; i++){
    const a = (i / 5) * Math.PI * 2;
    ctx.beginPath();
    ctx.moveTo(Math.cos(a) * r * 0.35, Math.sin(a) * r * 0.35);
    ctx.bezierCurveTo(
      Math.cos(a + 0.5) * r * 0.6, Math.sin(a + 0.5) * r * 0.6,
      Math.cos(a + 0.8) * r * 0.8, Math.sin(a + 0.8) * r * 0.8,
      Math.cos(a + 1.1) * r * 0.95, Math.sin(a + 1.1) * r * 0.95
    );
    ctx.stroke();
  }

  ctx.beginPath();
  ctx.arc(0, 0, r, 0, Math.PI * 2);
  ctx.strokeStyle = 'rgba(150, 90, 40, 0.5)';
  ctx.lineWidth = 2;
  ctx.stroke();

  const gemR = r * 0.28;
  const gemX = 0, gemY = -r * 0.15;
  const gemGrad = ctx.createRadialGradient(gemX - gemR*0.3, gemY - gemR*0.3, gemR*0.05, gemX, gemY, gemR);
  gemGrad.addColorStop(0, '#aaffbb');
  gemGrad.addColorStop(0.4, '#22cc55');
  gemGrad.addColorStop(0.8, '#116622');
  gemGrad.addColorStop(1, '#0a3311');
  ctx.beginPath();
  for(let i = 0; i < 6; i++){
    const ga = (i / 6) * Math.PI * 2 - Math.PI / 6;
    const gx = gemX + Math.cos(ga) * gemR;
    const gy = gemY + Math.sin(ga) * gemR;
    if(i === 0) ctx.moveTo(gx, gy); else ctx.lineTo(gx, gy);
  }
  ctx.closePath();
  ctx.fillStyle = gemGrad;
  ctx.fill();
  ctx.strokeStyle = '#88ffaa';
  ctx.lineWidth = 1.5;
  ctx.stroke();
  ctx.beginPath();
  ctx.moveTo(gemX - gemR*0.4, gemY - gemR*0.15);
  ctx.lineTo(gemX - gemR*0.05, gemY - gemR*0.5);
  ctx.lineTo(gemX + gemR*0.1, gemY - gemR*0.1);
  ctx.closePath();
  ctx.fillStyle = 'rgba(200,255,220,0.6)';
  ctx.fill();

  if(ultActive){
    const t = Date.now() / 300;
    const ar = r * (1.5 + 0.2 * Math.sin(t));
    const ag = ctx.createRadialGradient(0, 0, r * 0.7, 0, 0, ar);
    ag.addColorStop(0, 'rgba(50,200,80,0.45)');
    ag.addColorStop(1, 'rgba(0,0,0,0)');
    ctx.beginPath();
    ctx.arc(0, 0, ar, 0, Math.PI * 2);
    ctx.fillStyle = ag;
    ctx.fill();
    ctx.beginPath();
    ctx.arc(0, 0, r * (1.1 + 0.08 * Math.sin(t * 2)), 0, Math.PI * 2);
    ctx.strokeStyle = `rgba(80,255,100,${0.7 + 0.3 * Math.sin(t)})`;
    ctx.lineWidth = 3;
    ctx.stroke();
  }

  if(growBonus > 0){
    const defPct = Math.min(growBonus / 75, 1);
    const dotCount = Math.floor(defPct * 12);
    for(let i = 0; i < dotCount; i++){
      const da = (i / 12) * Math.PI * 2 - Math.PI / 2;
      const dr = r + 6;
      ctx.beginPath();
      ctx.arc(Math.cos(da) * dr, Math.sin(da) * dr, 2.5, 0, Math.PI * 2);
      ctx.fillStyle = '#44ff88';
      ctx.fill();
    }
  }

  ctx.restore();
}

