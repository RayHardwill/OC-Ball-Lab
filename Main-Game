const selected = [];
// Add future modes here. Character logic only sees teams, enemies and arena helpers.
const GAME_MODES = {
  duel:{name:'1V1 CLASH',selectionCount:2,teams:[0,1],arena:'rectangle',width:600,height:560,win:'last-team'},
  threeway:{name:'THREEWAY CLASH',selectionCount:3,teams:[0,1,2],arena:'hexagon',width:900,height:840,win:'last-team'},
  juggernaut:{name:'JUGGERNAUT',selectionCount:4,teams:[0,1,1,1],arena:'hexagon',width:1080,height:720,win:'last-team',randomJuggernaut:true},
  '2v2':{name:'2V2',selectionCount:4,teams:[0,0,1,1],arena:'rectangle',width:1000,height:650,win:'last-team'},
  '3v3':{name:'3V3',selectionCount:6,teams:[0,0,0,1,1,1],arena:'rectangle',width:1100,height:700,win:'last-team'},
  domain:{name:'DOMAIN MODE',selectionCount:CHARS.length,minSelection:2,teams:CHARS.map((_,i)=>i),arena:'circles',width:1700,height:900,win:'last-team'}
};
let gameMode = 'duel';
let matchRoster=[];
let balls = [];
let copies = [];
let effects = [];
let spikes = [];
let chains = [];
let abilityTrails = [];
let turrets = [];
let bullets = [];
