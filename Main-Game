      }
      this.spikeTimer+=dt;
      if(this.spikeTimer>=this.spikeInterval){
        this.spikeTimer=0;
        this.spikeInterval=10+Math.random()*4;
        if(enemies.length>0){
          const target=enemies[Math.floor(Math.random()*enemies.length)];
          spawnSpike(target,this);
        }
      }
    }
    const spd=this.getSpeed();
    const cur=Math.hypot(this.vx,this.vy);
    if(cur>0.01){const f=spd/cur;this.vx*=f;this.vy*=f;}
    else{const a=Math.random()*Math.PI*2;this.vx=Math.cos(a)*spd;this.vy=Math.sin(a)*spd;}
    if(this.ultActive){
