function triggerLionBite(lion,target){
  if(!lion || lion.char.id!=='manic_lion' || lion.isCopy || !target || !target.alive) return;
  if(Math.random()>=0.20) return;
  target.takeDamage(50,lion);
  darkKnightStunTimers[target.id]=Math.max(darkKnightStunTimers[target.id]||0,1.5);
  const targetR=target.char.id==='elder_tree'?target.etGrowR:target.r;
  effects.push({type:'text',x:target.x,y:target.y-targetR-14,text:'Chomp',color:'#ffffff',t:0,dur:0.42});
  effects.push({type:'ring',x:target.x,y:target.y,r:targetR,maxR:targetR+50,color:'#ffffff',t:0,dur:0.35});
  // Store the bitten enemy's post-bounce location. Copies use this only when they
  // themselves hit a wall or another enemy.
  lionBiteRedirectTarget={x:target.x,y:target.y,side:target.side};
  copies.forEach(c=>{
    if(c.alive && c.char.id==='manic_lion' && c.side===lion.side) c.lionBiteRedirectTarget={x:target.x,y:target.y};
  });
}

function redirectLionCopyAfterBounce(copy){
  if(!copy || !copy.lionBiteRedirectTarget) return;
  const p=copy.lionBiteRedirectTarget;
  const dx=p.x-copy.x,dy=p.y-copy.y,d=Math.hypot(dx,dy)||1;
  const spd=copy.getSpeed();
  copy.vx=dx/d*spd; copy.vy=dy/d*spd;
  // Redirect the copy's travel direction only. Moving its position here caused
  // the old teleport-to-Chomp behavior instead of waiting for a real bounce.
  copy.lionBiteRedirectTarget=null;
}

function handleCollision(a,b){
  if(isDomainMode() && !sameRealm(a,b)) return;
  if(Math.hypot(a.x-b.x,a.y-b.y)<=a.r+b.r){
    hyperboleOmenTouch(a);hyperboleOmenTouch(b);
  }
  if(isEmmyDomainParticipant(a)){
    // Volleyball players still bounce off each other, without contact attacks.
    const dx=b.x-a.x,dy=b.y-a.y,dist=Math.hypot(dx,dy);
    if(dist>=a.r+b.r||dist<.001)return;
    const nx=dx/dist,ny=dy/dist,overlap=(a.r+b.r-dist)/2+.5;
    a.x-=nx*overlap;a.y-=ny*overlap;b.x+=nx*overlap;b.y+=ny*overlap;
    const dot=(b.vx-a.vx)*nx+(b.vy-a.vy)*ny;
    if(dot<0){
      a.vx+=dot*nx;a.vy+=dot*ny;b.vx-=dot*nx;b.vy-=dot*ny;
      for(const fighter of [a,b]){
        const speed=fighter.getSpeed(),length=Math.hypot(fighter.vx,fighter.vy)||1;
        fighter.vx=fighter.vx/length*speed;fighter.vy=fighter.vy/length*speed;
        domainEmmyRedirectAfterBounce(fighter);
      }
    }
    return;
  }
  // Domain lions deal a fixed percentage of the victim's original maximum HP.
  if(domainState?.phase==='active'&&a.realm===1&&(a.domainLion||b.domainLion)){
    const lion=a.domainLion?a:b,target=a.domainLion?b:a;
    if(lion.side!==target.side&&lion.hitCooldown<=0&&Math.hypot(lion.x-target.x,lion.y-target.y)<=lion.r+target.r){
      target.takeDamage(target.maxHp*.0075,lion.damageOwner);
      lion.hitCooldown=.5;
      lion.vx*=-1;lion.vy*=-1;
    }
    return;
  }
  // Dark Knight phases through enemies during his ultimate. His dedicated
  // ultimate-contact handler applies exactly 30 damage on each contact.
  if((a.char.id==='dark_knight' && a.dkUltActive) ||
     (b.char.id==='dark_knight' && b.dkUltActive) ||
     (a.char.id==='emmy' && a.emmyUltActive) ||
     (b.char.id==='emmy' && b.emmyUltActive)) return;

  const aR = a.char.id==='elder_tree' ? a.etGrowR : a.r;
  const bR = b.char.id==='elder_tree' ? b.etGrowR : b.r;
  const dx=b.x-a.x, dy=b.y-a.y;
  const dist=Math.hypot(dx,dy);
  if(dist>aR+bR||dist<0.01) return;
  // Fire Charge has its own fixed 40-damage contact event. Its one-second
  // per-target cooldown prevents high speed from turning contact into tick damage.
  const aFireCharge=(a.char.id==='mayhem'&&a.mayhemState==='fire_charge')||(a.char.id==='maniac_artist'&&a.artistMayhemCharge>0);
  const bFireCharge=(b.char.id==='mayhem'&&b.mayhemState==='fire_charge')||(b.char.id==='maniac_artist'&&b.artistMayhemCharge>0);
  if(aFireCharge) triggerMayhemChargeHit(a,b);
  if(bFireCharge) triggerMayhemChargeHit(b,a);
  // Driller passes through its victim without redirecting either fighter.
  const drillA=a.char.id==='maniac_artist'&&a.artistState==='drill';
  const drillB=b.char.id==='maniac_artist'&&b.artistState==='drill';
  if(drillA||drillB){
    if(drillA&&(a.artistHitCooldowns[b.id]||0)<=0){a.artistHitCooldowns[b.id]=.45;b.takeDamage(50,a);darkKnightStunTimers[b.id]=Math.max(darkKnightStunTimers[b.id]||0,.35);a.artistRegisterContact(b);effects.push({type:'ring',x:b.x,y:b.y,r:bR,maxR:bR+50,color:'#ff9dce',t:0,dur:.35});}
    if(drillB&&(b.artistHitCooldowns[a.id]||0)<=0){b.artistHitCooldowns[a.id]=.45;a.takeDamage(50,b);darkKnightStunTimers[a.id]=Math.max(darkKnightStunTimers[a.id]||0,.35);b.artistRegisterContact(a);effects.push({type:'ring',x:a.x,y:a.y,r:aR,maxR:aR+50,color:'#ff9dce',t:0,dur:.35});}
    return;
  }
  const overlap=(aR+bR-dist)/2+0.5;
  const nx=dx/dist, ny=dy/dist;
  a.x-=nx*overlap;
  a.y-=ny*overlap;
  b.x+=nx*overlap;
  b.y+=ny*overlap;
  const aIsElderTree = a.char.id==='elder_tree';
  const bIsElderTree = b.char.id==='elder_tree';

  const dvx=b.vx-a.vx, dvy=b.vy-a.vy;
  const dot=dvx*nx+dvy*ny;
  if(dot>=0) return;

  const aWasAttacking=(a.vx*nx+a.vy*ny)>0.5;
  const bWasAttacking=(b.vx*nx+b.vy*ny)<-0.5;
  const aVillainyUlt=a.char.id==='villainy' && a.thrustUltActive;
  const bVillainyUlt=b.char.id==='villainy' && b.thrustUltActive;

  // Elder Tree is immovable in normal character-to-character collisions.
  // Other characters can still bounce off the tree, but the tree itself
  // keeps its velocity. It can still bounce from the arena/ray walls.
  if(aIsElderTree){
    b.vx-=dot*nx;
    b.vy-=dot*ny;
  } else if(bIsElderTree){
    a.vx+=dot*nx;
    a.vy+=dot*ny;
  } else {
    a.vx+=dot*nx;
    a.vy+=dot*ny;
    b.vx-=dot*nx;
    b.vy-=dot*ny;
  }

  if(!aIsElderTree){
    const spdA=a.getSpeed();
    const curA=Math.hypot(a.vx,a.vy)||1;
    a.vx=a.vx/curA*spdA;
    a.vy=a.vy/curA*spdA;
  }
  if(!bIsElderTree){
    const spdB=b.getSpeed();
    const curB=Math.hypot(b.vx,b.vy)||1;
    b.vx=b.vx/curB*spdB;
    b.vy=b.vy/curB*spdB;
  }
  if(a.hitCooldown>0 || b.hitCooldown>0) return;
  a.hitCooldown=0.5;
  b.hitCooldown=0.5;
  const fallback=!aWasAttacking && !bWasAttacking;
  if(aWasAttacking || fallback){
    const baseDmg=a.getDamage()+(a.cloneDamageBonus||0);
    let dA=baseDmg*(a.isCrit()?a.char.critMult:1);
    if(a.char.id==='maniac_artist'&&a.artistVillainyCopy>0&&!a.artistVillainyHit){dA=baseDmg*3;a.artistVillainyHit=true;a.artistVillainyCopy=0;}
    if(!bVillainyUlt&&!aFireCharge) b.takeDamage(dA,a);
    if(a.char.id==='maniac_artist'&&!aFireCharge) a.artistRegisterContact(b);
  }
  if(bWasAttacking || fallback){
    const baseDmg=b.getDamage()+(b.cloneDamageBonus||0);
    let dB=baseDmg*(b.isCrit()?b.char.critMult:1);
    if(b.char.id==='maniac_artist'&&b.artistVillainyCopy>0&&!b.artistVillainyHit){dB=baseDmg*3;b.artistVillainyHit=true;b.artistVillainyCopy=0;}
    if(!aVillainyUlt&&!bFireCharge) a.takeDamage(dB,b);
    if(b.char.id==='maniac_artist'&&!bFireCharge) b.artistRegisterContact(a);
  }

  // Main Manic Lion has a 20% bite chance on every contact hit.
  if(a.char.id==='manic_lion' && !a.isCopy && a.alive && b.alive && (aWasAttacking || fallback)) triggerLionBite(a,b);
  if(b.char.id==='manic_lion' && !b.isCopy && b.alive && a.alive && (bWasAttacking || fallback)) triggerLionBite(b,a);

  // A lion copy that had been told to redirect only does so after this bounce.
  if(a.isCopy && a.char.id==='manic_lion') redirectLionCopyAfterBounce(a);
  if(b.isCopy && b.char.id==='manic_lion') redirectLionCopyAfterBounce(b);

