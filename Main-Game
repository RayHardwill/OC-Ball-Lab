function drawUltOverlays(ctx){
  const harperDominion=[...balls,...copies].find(b=>b.alive&&b.char.id==='harper'&&b.harperUltActive&&!b.isCopy);
  if(harperDominion){
    const pulse=.10+.055*Math.sin(Date.now()/150);
    ctx.save();
    ctx.fillStyle=colorWithAlpha(HARPER_ROSE,pulse);
    ctx.fillRect(0,0,W,H);
    ctx.strokeStyle=colorWithAlpha(HARPER_ROSE,.72+.20*Math.sin(Date.now()/110));
    ctx.lineWidth=6;
    if(isHexArena()){
      const v=getArenaVertices(5);ctx.beginPath();
      v.forEach((point,i)=>i===0?ctx.moveTo(point.x,point.y):ctx.lineTo(point.x,point.y));
      ctx.closePath();ctx.stroke();
    }else ctx.strokeRect(3,3,W-6,H-6);
    ctx.restore();
  }
  const blueFire=[...balls,...copies].find(b=>b.alive&&b.char.id==='mayhem'&&b.mayhemUltActive&&!b.isCopy);
  if(blueFire){
    const pulse=.10+.045*Math.sin(Date.now()/120);
    ctx.save();
    const glow=ctx.createRadialGradient(blueFire.x,blueFire.y,blueFire.r,blueFire.x,blueFire.y,Math.hypot(W,H));
    glow.addColorStop(0,`rgba(44,90,242,${pulse*1.45})`);
    glow.addColorStop(1,`rgba(8,20,80,${pulse*.70})`);
    ctx.fillStyle=glow;ctx.fillRect(0,0,W,H);
    ctx.strokeStyle=`rgba(72,104,255,${.72+.2*Math.sin(Date.now()/90)})`;ctx.lineWidth=6;
    if(isHexArena()){
      const v=getArenaVertices(5);ctx.beginPath();v.forEach((point,i)=>i?ctx.lineTo(point.x,point.y):ctx.moveTo(point.x,point.y));ctx.closePath();ctx.stroke();
    }else ctx.strokeRect(3,3,W-6,H-6);
    ctx.restore();
  }
  const mattShower=balls.find(b=>b.alive&&b.char.id==='matt'&&b.mattUltActive);
  if(mattShower){
    const glow=ctx.createRadialGradient(mattShower.x,mattShower.y,20,mattShower.x,mattShower.y,Math.hypot(W,H));
    glow.addColorStop(0,'rgba(70,240,144,.19)');glow.addColorStop(1,'rgba(27,140,92,.07)');
    ctx.save();ctx.fillStyle=glow;ctx.fillRect(0,0,W,H);
    ctx.strokeStyle='rgba(116,255,170,.75)';ctx.lineWidth=5;ctx.shadowColor=MATT_GREEN;ctx.shadowBlur=16;
    if(isHexArena()){
      const v=getArenaVertices(4);ctx.beginPath();v.forEach((p,i)=>i?ctx.lineTo(p.x,p.y):ctx.moveTo(p.x,p.y));ctx.closePath();ctx.stroke();
    }else ctx.strokeRect(3,3,W-6,H-6);
    ctx.restore();
  }
  [...balls,...copies].forEach(b=>{
    if(!b.alive) return;
    let inUlt=false;
    let color='#ffffff';
    if(b.char.id==='manic_lion' && b.ultActive && !b.isCopy){inUlt=true;color='#7700cc';}
    if(b.char.id==='villainy' && b.thrustUltActive && !b.isCopy){inUlt=true;color='#4488ff';}
    if(b.char.id==='devourer' && b.devUltActive && !b.isCopy){inUlt=true;color='#ffee44';}
    if(b.char.id==='engineer' && b.engUltActive && !b.isCopy){inUlt=true;color='#ffcc00';}
    if(b.char.id==='elder_tree' && b.etUltActive && !b.isCopy){inUlt=true;color='#33cc55';}
    if(b.char.id==='ray' && b.rayUltActive && !b.isCopy){inUlt=true;color='#00ffee';}
    if(b.char.id==='dark_knight' && b.dkUltActive && !b.isCopy){inUlt=true;color='#8d1018';}
    if(b.char.id==='emmy' && b.emmyUltActive && !b.isCopy){inUlt=true;color='#ffffff';}
    if(b.char.id==='maniac_artist' && b.artistUltType && !b.isCopy){inUlt=true;color='#ffffff';}
    if(b.char.id==='plasma' && b.plasmaUltActive && !b.isCopy){inUlt=true;color='#983cff';}
    if(b.char.id==='harper' && b.harperUltActive && !b.isCopy){inUlt=true;color=HARPER_ROSE;}
    if(b.char.id==='mayhem' && b.mayhemUltActive && !b.isCopy){inUlt=true;color=MAYHEM_BLUE;}
    if(b.char.id==='matt' && b.mattUltActive && !b.isCopy){inUlt=true;color=MATT_GREEN;}
    if(!inUlt) return;
    const t=Date.now()/400;
    const alpha=0.15+0.1*Math.sin(t);
    const side=b.side;
    if(side===0){
      const g2=ctx.createLinearGradient(0,0,W*0.4,0);
      g2.addColorStop(0,colorWithAlpha(color,alpha*2));
      g2.addColorStop(1,'rgba(0,0,0,0)');
      ctx.fillStyle=g2;
    } else {
      const g2=ctx.createLinearGradient(W,0,W*0.6,0);
      g2.addColorStop(0,colorWithAlpha(color,alpha*2));
      g2.addColorStop(1,'rgba(0,0,0,0)');
      ctx.fillStyle=g2;
    }
    ctx.fillRect(0,0,W,H);
    ctx.strokeStyle=colorWithAlpha(color,0.6+0.3*Math.sin(t*2));
    ctx.lineWidth=4+2*Math.sin(t);
    if(isHexArena()){
      const v=getArenaVertices(4);
      ctx.beginPath();
      v.forEach((p,i)=>i===0?ctx.moveTo(p.x,p.y):ctx.lineTo(p.x,p.y));
      ctx.closePath();
      ctx.stroke();
    }else{
      ctx.strokeRect(2,2,W-4,H-4);
    }
  });
}

function colorWithAlpha(hex, alpha){
  const r=parseInt(hex.slice(1,3),16);
  const g=parseInt(hex.slice(3,5),16);
  const b=parseInt(hex.slice(5,7),16);
  return `rgba(${r},${g},${b},${alpha})`;
}

function render(){
  ctx.clearRect(0,0,W,H);
  ctx.fillStyle='#0d0b1a';
  ctx.fillRect(0,0,W,H);

  if(isDomainMode()){
    drawDomainBackdrop(ctx);
    ctx.save();ctx.beginPath();
    ctx.arc(DOMAIN_CENTERS[0].x,DOMAIN_CENTERS[0].y,DOMAIN_RADIUS,0,Math.PI*2);
    if(rayHeptagonActive(1))rayHeptagonVertices().forEach((p,i)=>i?ctx.lineTo(p.x,p.y):ctx.moveTo(p.x,p.y));
    else ctx.arc(DOMAIN_CENTERS[1].x,DOMAIN_CENTERS[1].y,DOMAIN_RADIUS,0,Math.PI*2);
    if(rayHeptagonActive(1))ctx.closePath();
    ctx.clip();
  }

  if(isHexArena()){
    const v=getArenaVertices(2);
    ctx.save();
    ctx.beginPath();
    v.forEach((p,i)=>i===0?ctx.moveTo(p.x,p.y):ctx.lineTo(p.x,p.y));
    ctx.closePath();
    ctx.fillStyle='#0d0b1a';
    ctx.fill();
    ctx.clip();

  }

  // Shared arena grid. In hex modes the active clip keeps it inside the
  // polygon; rectangular modes draw it across the full arena.
  const paperDomain=isDomainMode()&&domainState?.phase==='active'&&domainState.owner.char.id==='maniac_artist';
  if(paperDomain){ctx.save();ctx.beginPath();ctx.arc(DOMAIN_CENTERS[0].x,DOMAIN_CENTERS[0].y,DOMAIN_RADIUS,0,Math.PI*2);ctx.clip();}
  ctx.strokeStyle='rgba(60,40,100,0.25)';
  ctx.lineWidth=1;
  for(let gx=0;gx<W;gx+=40){ctx.beginPath();ctx.moveTo(gx,0);ctx.lineTo(gx,H);ctx.stroke();}
  for(let gy=0;gy<H;gy+=40){ctx.beginPath();ctx.moveTo(0,gy);ctx.lineTo(W,gy);ctx.stroke();}
  if(paperDomain)ctx.restore();

  // Everything below is shared by rectangular and hexagonal arenas.
  // Hex modes remain clipped because their canvas state is restored afterward.
  if(!isDomainMode()) drawUltOverlays(ctx);
  drawHyperboleArena(ctx);
  drawHyperboleEffects(ctx);
  mayhemPuddles.forEach(p=>domainClip(ctx,p,()=>drawMayhemPuddle(ctx,p)));
  mattZones.forEach(z=>domainClip(ctx,z,()=>drawMattZone(ctx,z)));
  const dkUlt=balls.find(b=>b.alive&&b.char.id==='dark_knight'&&b.dkUltActive);
  if(dkUlt&&!isDomainMode()) drawDarkKnightUltArena(ctx,dkUlt);
  drawDarkKnightEffects(ctx);
  drawLionAuraParticles(ctx);

  spiritOrbs.forEach(orb => domainClip(ctx,orb,()=>drawSpiritOrb(ctx,orb)));

  devourerRockWalls.forEach(w=>domainClip(ctx,w,()=>drawDevourerRockWall(ctx,w)));
  harperBloodstones.forEach(stone=>domainClip(ctx,stone,()=>drawHarperBloodstone(ctx,stone)));
  rayWalls.forEach(w=>domainClip(ctx,w,()=>drawRayWall(ctx,w)));
  rayTargetBeams.forEach(b=>domainClip(ctx,b.owner,()=>drawRayTargetBeam(ctx,b)));
  rayUltBeams.forEach(b=>domainClip(ctx,b.owner||b,()=>drawRayUltBeam(ctx,b)));
  drawPlasmaFields(ctx);
  emmyUltBeams.forEach(b=>domainClip(ctx,b.owner||b,()=>drawEmmyUltBeam(ctx,b)));
  emmyThrows.forEach(p=>domainClip(ctx,p,()=>drawEmmyThrow(ctx,p)));
  artistBeams.forEach(b=>domainClip(ctx,b.owner,()=>drawArtistBeam(ctx,b)));
  mayhemGeysers.forEach(g=>domainClip(ctx,g,()=>drawMayhemGeyser(ctx,g)));
  mayhemExplosions.forEach(ex=>domainClip(ctx,ex,()=>drawMayhemExplosion(ctx,ex)));
  mayhemFireballs.forEach(p=>domainClip(ctx,p,()=>drawMayhemFireball(ctx,p)));
  mattSlashes.forEach(s=>domainClip(ctx,s,()=>drawMattSlash(ctx,s)));
  mattStars.forEach(s=>domainClip(ctx,s,()=>drawMattStar(ctx,s.x,s.y,s.r,s.rotation)));

  // Omni Drill's center lane flashes one second before impact.
  [...balls,...copies].forEach(b=>{
    if(!b.alive||b.char.id!=='maniac_artist'||b.artistUltType!=='omni_drill'||b.artistUltPhase!=='telegraph')return;
    const pulse=.12+.18*Math.abs(Math.sin(Date.now()/75));ctx.save();ctx.fillStyle=`rgba(255,255,255,${pulse})`;ctx.fillRect(W/2-Math.max(95,W*.16),0,Math.max(190,W*.32),H);ctx.strokeStyle='rgba(255,255,255,.9)';ctx.lineWidth=4;ctx.strokeRect(W/2-Math.max(95,W*.16),0,Math.max(190,W*.32),H);ctx.restore();
  });

  abilityTrails.forEach(tr=>{
    const alpha=1-tr.t/tr.dur;
    ctx.save();
    if(isDomainMode()){
      const c=DOMAIN_CENTERS[tr.realm??(tr.points[0]?.x>W/2?1:0)];
      ctx.beginPath();ctx.arc(c.x,c.y,DOMAIN_RADIUS,0,Math.PI*2);ctx.clip();
    }
    ctx.globalAlpha=alpha*0.7;
    if(tr.dot){
      ctx.beginPath();
      ctx.arc(tr.points[0].x,tr.points[0].y,4,0,Math.PI*2);
      ctx.fillStyle=tr.color;
      ctx.fill();
    } else {
      ctx.strokeStyle=tr.color;
      ctx.lineWidth=tr.lineWidth||2;
      ctx.lineCap='round';
      ctx.beginPath();
      tr.points.forEach((p,i)=>i===0?ctx.moveTo(p.x,p.y):ctx.lineTo(p.x,p.y));
      ctx.stroke();
    }
    ctx.restore();
  });

  spikes.forEach(sp=>{
    const prog=sp.t/sp.dur;
    const phase=prog<0.5?prog/0.5:1-(prog-0.5)/0.5;
    ctx.save();
    if(isDomainMode()){const c=circleFor(sp.owner||sp);ctx.beginPath();ctx.arc(c.x,c.y,DOMAIN_RADIUS,0,Math.PI*2);ctx.clip();}
    ctx.globalAlpha=phase;
    const h=60*phase;
    ctx.fillStyle=sp.artistCopy?'#333333':'#111111';
    ctx.strokeStyle=sp.artistCopy?'#eeeeee':'#440022';
    ctx.lineWidth=2;
    ctx.beginPath();
    ctx.moveTo(sp.x,sp.y-h);
    ctx.lineTo(sp.x-10,sp.y+10);
    ctx.lineTo(sp.x+10,sp.y+10);
    ctx.closePath();
    ctx.fill();ctx.stroke();
    ctx.restore();
  });

  effects.forEach(ef=>{
    if(ef.type==='domain_shatter')return;
    const p=ef.t/ef.dur;
    ctx.save();
    if(isDomainMode()){const c=circleFor(ef);ctx.beginPath();ctx.arc(c.x,c.y,DOMAIN_RADIUS,0,Math.PI*2);ctx.clip();}
    if(ef.type==='ring'){
      const r=ef.r+(ef.maxR-ef.r)*p;
      ctx.globalAlpha=(1-p)*0.8;
      ctx.beginPath();ctx.arc(ef.x,ef.y,r,0,Math.PI*2);
      ctx.strokeStyle=ef.color;ctx.lineWidth=2;ctx.stroke();
    } else if(ef.type==='shockwave'){
      const r=ef.r+(ef.maxR-ef.r)*p;
      ctx.globalAlpha=(1-p)*0.9;
      ctx.beginPath();ctx.arc(ef.x,ef.y,r,0,Math.PI*2);
      ctx.strokeStyle=ef.color;ctx.lineWidth=4+4*(1-p);ctx.stroke();
      ctx.globalAlpha=(1-p)*0.08;
      ctx.beginPath();ctx.arc(ef.x,ef.y,r,0,Math.PI*2);
      ctx.fillStyle=ef.color;ctx.fill();
    } else if(ef.type==='mayhem_charge_wave'){
      const r=ef.r+(ef.maxR-ef.r)*p;
      ctx.globalAlpha=(1-p)*.92;ctx.shadowColor=ef.color;ctx.shadowBlur=14;
      ctx.beginPath();ctx.arc(ef.x,ef.y,r,0,Math.PI*2);
      ctx.strokeStyle=ef.color;ctx.lineWidth=7*(1-p)+2;ctx.stroke();
      ctx.globalAlpha=(1-p)*.10;ctx.fillStyle=ef.color;ctx.fill();ctx.shadowBlur=0;
    } else if(ef.type==='harper_roar'){
      // Visual-only roar wave: damage and hit processing intentionally omitted.
      const r=ef.r+(ef.maxR-ef.r)*p;
      ctx.globalAlpha=(1-p)*.72;
      ctx.beginPath();ctx.arc(ef.x,ef.y,r,0,Math.PI*2);
      ctx.strokeStyle=ef.color;ctx.lineWidth=7*(1-p)+2;ctx.stroke();
      ctx.globalAlpha=(1-p)*.055;
      ctx.beginPath();ctx.arc(ef.x,ef.y,r,0,Math.PI*2);
      ctx.fillStyle=ef.color;ctx.fill();
    } else if(ef.type==='ult_flash'){
      const r=ef.r*p;
      ctx.globalAlpha=(1-p)*0.6;
      ctx.beginPath();ctx.arc(ef.x,ef.y,r,0,Math.PI*2);
      ctx.strokeStyle=ef.color;ctx.lineWidth=3;ctx.stroke();
      ctx.globalAlpha=(1-p)*0.15;
      ctx.fillStyle=ef.color;ctx.fill();
    } else if(ef.type==='spike_warn'){
      ctx.globalAlpha=(1-p)*0.7;
      ctx.beginPath();ctx.arc(ef.x,ef.y,25*(1-p)+5,0,Math.PI*2);
      ctx.fillStyle=ef.artistCopy?'rgba(210,210,210,.3)':'rgba(200,0,50,0.3)';ctx.fill();
    } else if(ef.type==='text'){
      ctx.globalAlpha=(1-p);
      ctx.font='700 24px Rajdhani, sans-serif';
      ctx.textAlign='center';
      ctx.textBaseline='middle';
      ctx.fillStyle=ef.color||'#ffffff';
      ctx.shadowColor='#000000'; ctx.shadowBlur=8;
      ctx.fillText(ef.text,ef.x,ef.y-28*p);
    } else if(ef.type==='punch'){
      ctx.globalAlpha=(1-p)*0.9;
      const spokes=10;
      ctx.save();
      ctx.translate(ef.x,ef.y);
      ctx.rotate(p*0.8);
      ctx.beginPath();
      for(let s=0;s<spokes;s++){
        const a=s/spokes*Math.PI*2;
        const r1=(30+120*p)*(0.7+0.3*(s%2));
        const r2=(30+120*p)*0.45;
        const aHalf=a+Math.PI/spokes;
        ctx.lineTo(Math.cos(a)*r1,Math.sin(a)*r1);
        ctx.lineTo(Math.cos(aHalf)*r2,Math.sin(aHalf)*r2);
      }
      ctx.closePath();
      ctx.fillStyle=ef.gray?`rgba(150,150,150,${(1-p)*0.55})`:`rgba(180,80,255,${(1-p)*0.55})`;
      ctx.fill();
      ctx.strokeStyle=ef.gray?`rgba(245,245,245,${(1-p)*0.9})`:`rgba(255,200,255,${(1-p)*0.9})`;
      ctx.lineWidth=2;
      ctx.stroke();
      ctx.restore();
    } else if(ef.type==='artist_wind'){
      ctx.globalAlpha=1-p;ctx.strokeStyle='#ffffff';ctx.lineWidth=2;ctx.beginPath();ctx.moveTo(ef.x-Math.cos(ef.angle)*30,ef.y-Math.sin(ef.angle)*30);ctx.lineTo(ef.x+Math.cos(ef.angle)*12,ef.y+Math.sin(ef.angle)*12);ctx.stroke();
    } else if(ef.type==='copy_aura'){
      ctx.globalAlpha=1-p;ctx.filter='grayscale(1)';ctx.beginPath();ctx.arc(ef.x,ef.y,ef.r*(1+1.8*p),0,Math.PI*2);ctx.strokeStyle='#ffffff';ctx.lineWidth=5*(1-p)+1;ctx.stroke();ctx.filter='none';
    }
    ctx.restore();
  });

  chains.forEach(ch=>{
    if(!ch.target.alive) return;
    const tR = ch.target.char.id==='elder_tree' ? ch.target.etGrowR : ch.target.r;
    ctx.save();
    ctx.strokeStyle=ch.state==='freeze'?'rgba(160,60,255,0.8)':'rgba(160,60,255,0.3)';
    ctx.lineWidth=ch.state==='freeze'?2:1;
    ctx.setLineDash([6,4]);
    ctx.beginPath();
    ctx.arc(ch.target.x,ch.target.y,tR+10+5*Math.sin(Date.now()/80),0,Math.PI*2);
    ctx.stroke();
    if(ch.state==='freeze'){
      ctx.globalAlpha=0.4;
      ctx.beginPath();
      ctx.moveTo(ch.devourer.x,ch.devourer.y);
      ctx.lineTo(ch.target.x,ch.target.y);
      ctx.stroke();
    }
    ctx.restore();
  });

  // Burn flames are deliberately drawn behind their attached fighter/turret.
  [...turrets,...copies,...balls].forEach(entity=>{if(!isHiddenByPaperRip(entity))domainClip(ctx,entity,()=>drawMayhemStatusFlames(ctx,entity));});
  turrets.forEach(t=>domainClip(ctx,t,()=>t.draw(ctx)));
  bullets.forEach(b=>domainClip(ctx,b,()=>b.draw(ctx)));

  rayLasers.forEach(l=>domainClip(ctx,l,()=>drawRayLaser(ctx,l)));
  rayGraniteBlasts.forEach(beam=>domainClip(ctx,beam,()=>drawRayGraniteBlast(ctx,beam)));
  drawRayVisuals(ctx);

  harperShards.forEach(shard=>domainClip(ctx,shard,()=>drawHarperShard(ctx,shard)));

  copies.forEach(c=>domainClip(ctx,c,()=>c.draw(ctx)));
  balls.forEach(b=>domainClip(ctx,b,()=>b.draw(ctx)));
  rayGraniteCharges.forEach(charge=>domainClip(ctx,charge.owner,()=>drawRayGraniteCharge(ctx,charge)));

  if(isDomainMode()){domainClip(ctx,{realm:1},()=>drawDomainPowerVisuals(ctx));ctx.restore();drawDomainFrame(ctx);}

  if(isHexArena()) ctx.restore();

  if(isHexArena()){
    const v=getArenaVertices(2);
    ctx.save();
    ctx.beginPath();
    v.forEach((p,i)=>i===0?ctx.moveTo(p.x,p.y):ctx.lineTo(p.x,p.y));
    ctx.closePath();
    ctx.strokeStyle='rgba(80,50,150,0.75)';
    ctx.lineWidth=4;
    ctx.shadowColor='#1a0a30';
    ctx.shadowBlur=30;
    ctx.stroke();
    ctx.shadowBlur=0;
    ctx.strokeStyle='rgba(120,80,190,0.55)';
    ctx.lineWidth=2;
    ctx.stroke();
    ctx.restore();
  }
}

function animSelect(){
  if(document.getElementById('screen-select').style.display==='none'){
    requestAnimationFrame(animSelect);
    return;
  }
  document.querySelectorAll('.char-card canvas').forEach((cv,i)=>{
    const c=CHARS[i];
    const ctx2=cv.getContext('2d');
    ctx2.clearRect(0,0,90,90);
    if(c.id==='manic_lion') drawLion(ctx2,45,45,30);
    else if(c.id==='villainy'){
      ctx2.save();ctx2.translate(45,45);
      const a=(Date.now()/800)%(Math.PI*2);
      drawKnife(ctx2,0,0,30,1,a);
      ctx2.restore();
    }
    else if(c.id==='devourer') drawFlame(ctx2,45,45,30,1,0);
    else if(c.id==='engineer') drawEngineerIcon(ctx2,45,45,30);
    else if(c.id==='elder_tree'){
      ctx2.clearRect(0,0,90,90);
      drawElderTree(ctx2,45,45,30,0,false);
    }
    else if(c.id==='ray'){
      ctx2.clearRect(0,0,90,90);
      drawRayIcon(ctx2,45,45,30);
    }
    else if(c.id==='dark_knight'){
      ctx2.clearRect(0,0,90,90);
      const t=(Date.now()/800)%(Math.PI*2);
      ctx2.save();ctx2.translate(45,45);
      drawDarkKnightSword(ctx2,t,30,false);
      drawDarkKnightHelmet(ctx2,0,0,30,t,false,false);
      drawDarkKnightShield(ctx2,0,0,30,false,false);
      ctx2.restore();
    }
    else if(c.id==='emmy'){
      ctx2.clearRect(0,0,90,90);
      drawEmmyIcon(ctx2,45,45,28,false);
      const a=-(Date.now()/900)%(Math.PI*2);
      drawVolleyball(ctx2,45+Math.cos(a)*50,35+Math.sin(a)*41,21,-a*2,false);
    }
    else if(c.id==='maniac_artist'){
      ctx2.clearRect(0,0,90,90);drawManiacArtistIcon(ctx2,45,45,30);
    }
    else if(c.id==='plasma'){
      ctx2.clearRect(0,0,90,90);ctx2.save();ctx2.translate(45,48);
      const targetAngle=Math.sin(Date.now()/1400)*.45;drawPlasmaSword(ctx2,targetAngle,22);
      drawPlasmaIcon(ctx2,0,0,25);ctx2.restore();
    }
    else if(c.id==='harper'){
      ctx2.clearRect(0,0,90,90);drawHarperIcon(ctx2,45,45,30,false);
    }
    else if(c.id==='mayhem'){
      ctx2.clearRect(0,0,90,90);drawMayhemIcon(ctx2,45,51,26,false,false);
    }
    else if(c.id==='matt'){
      ctx2.clearRect(0,0,90,90);ctx2.save();ctx2.translate(45,48);
      drawMattSword(ctx2,Date.now()*.0017,12);drawMattIcon(ctx2,0,0,26);ctx2.restore();
    }
    else if(c.id==='hyperbole')drawHyperboleIcon(ctx2,45,45,30);
  });
  requestAnimationFrame(animSelect);
}
animSelect();
</script>
</body>
</html>
