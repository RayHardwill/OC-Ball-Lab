    c.x=lion.x+(Math.random()-0.5)*50;
    c.y=lion.y+(Math.random()-0.5)*50;
    const ang=Math.random()*Math.PI*2;
    const spd=lion.getSpeed()*(0.7+Math.random()*0.5);
    c.vx=Math.cos(ang)*spd;
    c.vy=Math.sin(ang)*spd;
    c.fromUlt=false;
    c.hp=85;c.maxHp=85;
