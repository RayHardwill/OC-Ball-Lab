function drawMayhemIcon(ctx,x,y,r,ultActive=false){
  ctx.save();ctx.translate(x,y);ctx.lineJoin='round';ctx.lineCap='round';

  // Round face.
  const face=ctx.createRadialGradient(-r*.32,-r*.38,r*.08,r*.12,r*.18,r*1.12);
  face.addColorStop(0,'#D9DADE');face.addColorStop(.58,'#D9DADE');face.addColorStop(1,'#D9DADE');
  ctx.beginPath();ctx.arc(0,0,r,0,Math.PI*2);ctx.fillStyle=face;ctx.fill();
  ctx.strokeStyle='#464B59';ctx.lineWidth=Math.max(1.5,r*.06);ctx.stroke();

  // ================================================================
  // SIDE HAIR — one mirrored design, drawn once for each side.
  // side = -1 draws the left side; side = 1 draws the right side.
  // Change the numbers inside this loop to reshape both sides together.
  // ================================================================
  const hair=ctx.createLinearGradient(-r,-r,r,r*.5);
  hair.addColorStop(0,'#bd4f08');hair.addColorStop(.42,'#bd4f08');hair.addColorStop(1,'#bd4f08');
  ctx.fillStyle=hair;ctx.strokeStyle='#743005';ctx.lineWidth=Math.max(1.2,r*.045);
  for(const side of [-1,1]){
    ctx.beginPath();
    ctx.moveTo(side*r*.54,-r*.62);                         // Point 1: top inner
    ctx.quadraticCurveTo(side*r*.88,-r*.50,side*r*1.26,-r*.20);
    ctx.quadraticCurveTo(side*r*1.12,-r*.04,side*r*1.06,-r*.05);
    ctx.quadraticCurveTo(side*r*1.28,r*.12,side*r*.92,r*.55); 
    ctx.lineTo(side*r*.66,r*.34);                          // Point 4: lower inside
    ctx.quadraticCurveTo(side*r*.84,-r*.02,side*r*.54,-r*.62); // Return to Point 1
    ctx.closePath();
    ctx.fill();ctx.stroke();
  }

  // ================================================================
  // WIZARD HAT — one connected, closed, fillable path.
  // The cone and brim now belong to the same shape. Add lineTo() or
  // quadraticCurveTo() points anywhere between beginPath and closePath.
  // ================================================================
  const hat=ctx.createLinearGradient(-r,-r*1.6,r,-r*.35);
  hat.addColorStop(0,'#202230');hat.addColorStop(1,'#202230');
  ctx.fillStyle=hat;ctx.strokeStyle='#0F1017';ctx.lineWidth=Math.max(1.5,r*.06);
  ctx.beginPath();
  ctx.moveTo(-r*1.62,-r*.52);                             // Point 1: far-left brim
  ctx.quadraticCurveTo(-r*.98,-r*.66,-r*1.03,-r*.70);    // Point 2: left cone base
  ctx.lineTo(-r*1.15,-r*.88);
  ctx.lineTo(-r*.7,-r*1.18);
  ctx.lineTo(-r*.35,-r*1.58);
  ctx.lineTo(r*.2,-r*1.38);
  ctx.lineTo(r*.93,-r*1.47);                              // Point 4: bent tip
  ctx.lineTo(r*.83,-r*1.77);
  ctx.lineTo(r*1.3,-r*1.17);
  ctx.quadraticCurveTo(r*.48,-r*.91,r*.98,-r*.70);        // Point 5: right cone base
  ctx.quadraticCurveTo(r*.98,-r*.62,r*1.62,-r*.52);       // Point 6: far-right brim
  ctx.quadraticCurveTo(r*.72,-r*.17,0,-r*.27);            // Point 7: lower-right brim
  ctx.quadraticCurveTo(-r*.72,-r*.27,-r*1.62,-r*.52);     // Return along lower-left brim
  ctx.closePath();ctx.fill();ctx.stroke();
  ctx.strokeStyle=ultActive?MAYHEM_BLUE:'#ff7a18';ctx.lineWidth=Math.max(1.2,r*.08);
  ctx.beginPath();ctx.moveTo(-r*.95,-r*.67);ctx.quadraticCurveTo(0,-r*.32,r*.95,-r*.67);ctx.stroke();

  // ================================================================
  // FRONT BANG — drawn after the hat so it appears over the brim.
  // ================================================================
  ctx.fillStyle=hair;ctx.strokeStyle='#743005';ctx.lineWidth=Math.max(1.2,r*.045);
  ctx.beginPath();
  ctx.moveTo(-r*.32,-r*.26);                              // Point 1: left root
  ctx.quadraticCurveTo(r*0.25,-r*1,r*.4,r*.1);      // Point 2: top sweep
  ctx.lineTo(r*.0,r*.1);        // Point 3: right root
  ctx.quadraticCurveTo(-r*.01,-r*.35,-r*.32,-r*.26);        // Point 4: right inner tip
       
  ctx.closePath();ctx.fill();ctx.stroke();

  // Eyes and round glasses are drawn after the bang so they stay visible.
  ctx.fillStyle='#ffffff';
  for(const side of [-1,1]){ctx.beginPath();ctx.arc(side*r*.44,r*.14,r*.34,0,Math.PI*2);ctx.fill();}
  ctx.strokeStyle='#111015';ctx.lineWidth=Math.max(1.2,r*.045);
  ctx.fillStyle='#000000';
  for(const side of [-1,1]){ctx.beginPath();ctx.arc(side*r*.34,r*.14,r*.085,0,Math.PI*2);ctx.fill();}
  // Explicit glasses settings before drawing the first (left) lens.
  ctx.strokeStyle='#111015';ctx.lineWidth=Math.max(1.2,r*.045);
  for(const side of [-1,1]){
    ctx.fillStyle='rgba(205,179,255,.10)';ctx.beginPath();ctx.arc(side*r*.44,r*.14,r*.355,0,Math.PI*2);ctx.fill();ctx.stroke();
    ctx.strokeStyle='rgba(255,255,255,.52)';ctx.lineWidth=Math.max(1,r*.025);ctx.beginPath();ctx.arc(side*r*.34-r*.05,r*.03,r*.13,Math.PI*1.05,Math.PI*1.62);ctx.stroke();
    ctx.strokeStyle='#111015';ctx.lineWidth=Math.max(1.2,r*.045);
  }
  // Restore the glasses outline for the bridge.
  ctx.strokeStyle='#111015';ctx.lineWidth=Math.max(1.2,r*.045);
  ctx.beginPath();ctx.moveTo(-r*.085,r*.08);ctx.lineTo(r*.085,r*.08);ctx.stroke();
  ctx.beginPath();ctx.moveTo(-r*.16,r*.7);ctx.quadraticCurveTo(0,r*.5,r*.16,r*.7);
  ctx.strokeStyle='#464B59';ctx.lineWidth=Math.max(1.2,r*.045);ctx.stroke();

  // EYEBROWS ARE DRAWN AFTER THE HAT, SO THEY APPEAR ON TOP OF IT.
  ctx.save();
  ctx.strokeStyle='#111015';
  ctx.lineWidth=Math.max(2,r*.045);
  ctx.lineCap='round';
  ctx.beginPath();ctx.moveTo(-r*.58,-r*.45);ctx.lineTo(-r*.22,-r*.245);ctx.stroke();
  ctx.beginPath();ctx.moveTo(r*.58,-r*.45);ctx.lineTo(r*.22,-r*.245);ctx.stroke();
  ctx.restore();

  // Animated glowing orb; switches from orange to blue with Ultimate ON.
  const orbX=r*.69,orbY=-r*1.80,orbColor=ultActive?MAYHEM_BLUE:'#ff7a18';
  ctx.shadowColor=orbColor;ctx.shadowBlur=r*.48;
  ctx.beginPath();ctx.arc(orbX,orbY,r*.15,0,Math.PI*2);ctx.fillStyle='#ffffff';ctx.fill();
  ctx.shadowBlur=0;ctx.strokeStyle=orbColor;ctx.lineWidth=Math.max(1.2,r*.045);ctx.stroke();
  const now=Date.now()/600;
  for(let i=0;i<7;i++){
    const a=i/7*Math.PI*2+now*(i%2?1:-1),rr=r*(.29+.08*Math.sin(now*3+i)),s=r*.035;
    ctx.save();ctx.translate(orbX+Math.cos(a)*rr,orbY+Math.sin(a)*rr);ctx.rotate(a+now);ctx.globalAlpha=.68;
    ctx.fillStyle=i%3===0?'#ffffff':orbColor;ctx.shadowColor=orbColor;ctx.shadowBlur=6;ctx.fillRect(-s,-s,s*2,s*2);ctx.restore();
  }
  ctx.restore();
}


