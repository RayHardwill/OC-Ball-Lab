      if(!this.dkUltActive) return c.baseSpeed*voltageSlow;
      // Keep the existing 10.5 ultimate top speed, but ramp into it.
      const ramp=Math.min(1,Math.max(0,this.dkUltRamp||0));
      return (c.baseSpeed+(15.5-c.baseSpeed)*ramp)*voltageSlow;
    }
    return c.baseSpeed*voltageSlow;
  }

  getDamage(){
    const c=this.char;
    if(isDomainMode()&&domainState?.phase==='active'&&domainState.owner===this&&this.realm===1&&c.id==='devourer') return c.damage*9;
    let damage;
    if(c.id==='devourer') damage=c.damage*Math.min(1+this.devBonus/100, 5.0);
    else if(c.id==='elder_tree') damage=c.damage;
    else if(c.id==='dark_knight') damage=10*(1-(this.damageDebuff||0));
    else if(c.id==='harper') damage=(this.harperForm==='demon'?16:c.damage)*(1-(this.damageDebuff||0));
    else damage=c.damage*(1-(this.damageDebuff||0));
    return damage;
  }

  updateHyperbole(dt,enemies){
    this.hyperboleAfterimages=this.hyperboleAfterimages.filter(ghost=>(ghost.age+=dt)<.33);
    if(Math.hypot(this.vx,this.vy)>.5){
      this.hyperboleGhostTimer-=dt;
      if(this.hyperboleGhostTimer<=0){
        this.hyperboleGhostTimer=.055;
        this.hyperboleAfterimages.push({x:this.x,y:this.y,age:0});
        if(this.hyperboleAfterimages.length>8)this.hyperboleAfterimages.shift();
      }
    }
    if(this.hyperboleSplit){
      const split=this.hyperboleSplit;split.elapsed+=dt;
      const target=enemies.slice().sort((a,b)=>Math.hypot(a.x-this.x,a.y-this.y)-Math.hypot(b.x-this.x,b.y-this.y))[0];
      if(target){split.target=target;split.dx=target.x-this.x;split.dy=target.y-this.y;}
      split.end=hyperboleLineEnd(this,split.dx,split.dy);
      if(split.elapsed>=1)finishHyperboleSplit(this);
    }else{
      this.hyperboleSplitTimer=Math.min(this.hyperboleSplitInterval,this.hyperboleSplitTimer+dt);
      if(this.hyperboleSplitTimer>=this.hyperboleSplitInterval&&enemies.length&&this.hyperboleUltDuration<=0){
        this.hyperboleSplitTimer=0;beginHyperboleSplit(this);
      }
    }
    if(this.hyperboleVolley){
      this.hyperboleVolley.timer-=dt;
      while(this.hyperboleVolley&&this.hyperboleVolley.timer<=0){
        spawnHyperboleMeteor(this);this.hyperboleVolley.remaining--;
        if(!this.hyperboleVolley.remaining)this.hyperboleVolley=null;
        else this.hyperboleVolley.timer+=.58+Math.random()*.12;
      }
    }
    this.hyperboleMeteorTimer=Math.min(this.hyperboleMeteorInterval,this.hyperboleMeteorTimer+dt);
    if(this.hyperboleMeteorTimer>=this.hyperboleMeteorInterval&&enemies.length&&
       !this.hyperboleVolley&&this.hyperboleUltDuration<=0){
      this.hyperboleMeteorTimer=0;
      if(Math.random()<.60)startHyperboleRiftCharge(this);
      else {this.hyperboleVolley={remaining:8,timer:0,positions:[]};}
    }
    if(!isDomainMode()){
      if(this.hyperboleUltDuration>0){
        this.hyperboleUltDuration=Math.max(0,this.hyperboleUltDuration-dt);
        if(this.hyperboleUltDuration===0)endHyperboleUlt(this);
      }else{
        this.hyperboleUltTimer=Math.min(this.hyperboleUltInterval,this.hyperboleUltTimer+dt);
        if(this.hyperboleUltTimer>=this.hyperboleUltInterval&&enemies.length)startHyperboleUlt(this);
      }
      this.ultProgress=this.hyperboleUltDuration>0?1:Math.min(1,this.hyperboleUltTimer/this.hyperboleUltInterval);
    }
  }

  // ---- MATT: sword combo, alternating special, and star shower ----
  updateMatt(dt){
    const wasSpinning=this.mattSpinTimer>0;
    this.mattSpinTimer=Math.max(0,this.mattSpinTimer-dt);
    this.mattBurstTimer=Math.max(0,this.mattBurstTimer-dt);
    this.mattImmuneTimer=Math.max(0,this.mattImmuneTimer-dt);
    if(this.mattComboTimer>0){
      this.mattComboTimer=Math.max(0,this.mattComboTimer-dt);
      if(this.mattComboTimer===0)this.mattCombo=0;
    }
    if(wasSpinning){
      // Pause briefly to wind up, then actually turn the blade a full circle.
      const elapsed=MATT_SPIN_DURATION-this.mattSpinTimer;
      const sweep=Math.max(0,Math.min(1,(elapsed-.12)/.55));
      const eased=sweep*sweep*(3-2*sweep);
      this.mattSwordAngle=this.mattSpinStart+this.mattSpinDirection*(Math.PI*2*eased-(1-sweep)*Math.min(1,elapsed/.12)*.28);
    }else this.mattSwordAngle+=this.mattSwordDirection*5.2*dt;
    mattSwordHits(this,dt);
    if(this.isCopy)return;

    if(!isDomainMode()){
      if(this.mattUltActive){
        this.mattUltDuration-=dt;
        this.mattStarTimer-=dt;
        while(this.mattStarTimer<=0&&this.mattUltDuration>0){
          mattSpawnShowerStar(this);this.mattStarTimer+=.5;
        }
        if(this.mattUltDuration<=0){this.mattUltActive=false;this.mattUltTimer=0;this.ultProgress=0;}
      }else{
        this.mattUltTimer+=dt;
        this.ultProgress=Math.min(1,this.mattUltTimer/this.mattUltInterval);
        if(this.mattUltTimer>=this.mattUltInterval){
          this.mattUltActive=true;this.mattUltDuration=12;this.mattStarTimer=0;
          this.mattUltDamageByTarget={};this.mattUltZoneLastHit={};
          triggerScreenUltFlash('#63ffa2',.7);
          effects.push({type:'text',x:this.x,y:this.y-this.r-25,text:'STAR SHOWER',color:MATT_GREEN,t:0,dur:1});
        }
      }
    }

    this.mattAbilityTimer+=dt;
    if(this.mattAbilityTimer>=this.mattAbilityInterval){
      this.mattAbilityTimer-=this.mattAbilityInterval;
      if(Math.random()<.5){
        const p=isDomainMode()&&this.realm===1?domainCirclePoint(1,this.r*5):randomArenaPoint(this.r*5);
        mattCreateZone(this,p.x,p.y);
      }else this.mattSequence={remaining:6,timer:0};
    }
    if(this.mattSequence){
      this.mattSequence.timer-=dt;
      while(this.mattSequence.remaining>0&&this.mattSequence.timer<=0){
        mattFireSlash(this);this.mattSequence.remaining--;this.mattSequence.timer+=.25;
      }
      if(this.mattSequence.remaining===0)this.mattSequence=null;
    }
  }

  // ---- MAYHEM UPDATE / BLUE FIRE ULTIMATE ----
  activateMayhemAmplifier(target){
    this.mayhemState='amplifier_charge';
    this.mayhemStateTimer=0;
    this.mayhemAmpAngle=target?Math.atan2(target.y-this.y,target.x-this.x):Math.atan2(this.vy,this.vx);
    effects.push({type:'text',x:this.x,y:this.y-this.r-18,text:'AMPLIFIER',color:'#ff9a35',t:0,dur:.8});
  }

  activateMayhemFireCharge(){
    this.mayhemState='fire_charge';
    this.mayhemStateTimer=6;
    this.mayhemChargeHits={};
    const speed=this.char.baseSpeed*4,angle=Math.atan2(this.vy,this.vx);
    this.vx=Math.cos(angle)*speed;this.vy=Math.sin(angle)*speed;
    effects.push({type:'ult_flash',x:this.x,y:this.y,r:this.r*2.2,color:'#ff6a00',t:0,dur:.45});
    effects.push({type:'text',x:this.x,y:this.y-this.r-18,text:'FIRE CHARGE',color:'#ffb13b',t:0,dur:.8});
  }

  activateMayhemUltimate(){
    this.mayhemUltActive=true;
    this.mayhemUltDuration=16;
    this.mayhemUltShotTimer=.05;
    this.ultProgress=1;
    effects.push({type:'ult_flash',x:this.x,y:this.y,r:this.r*3.2,color:MAYHEM_BLUE,t:0,dur:.8});
    effects.push({type:'text',x:this.x,y:this.y-this.r-24,text:'BLUE FIRE',color:MAYHEM_BLUE,t:0,dur:1});
    triggerScreenUltFlash('#0b1d69',.72);
  }

  updateMayhem(dt,enemies){
    for(const key in this.mayhemChargeHits){
      this.mayhemChargeHits[key]-=dt;
      if(this.mayhemChargeHits[key]<=0) delete this.mayhemChargeHits[key];
    }

    if(this.mayhemUltActive){
      this.mayhemUltDuration-=dt;
      this.ultProgress=1;
      if(this.mayhemUltDuration<=0){
        this.mayhemUltActive=false;this.mayhemUltTimer=0;this.ultProgress=0;
      }
    }else{
      this.mayhemUltTimer+=dt;
      this.ultProgress=Math.min(1,this.mayhemUltTimer/this.mayhemUltInterval);
      if(this.mayhemUltTimer>=this.mayhemUltInterval) this.activateMayhemUltimate();
    }

    this.mayhemAbilityTimer+=dt;
    if(this.mayhemState==='normal'){
      if(this.mayhemAbilityTimer>=this.mayhemAbilityInterval){
        const target=getNearestMayhemTarget(this);
        if(target){
          this.mayhemAbilityTimer=0;
          if(Math.random()<.40) this.activateMayhemFireCharge();
          else this.activateMayhemAmplifier(target);
        }
      }
    }else if(this.mayhemState==='amplifier_charge'){
      const target=getNearestMayhemTarget(this);
      if(target) this.mayhemAmpAngle=turnTowardAngle(this.mayhemAmpAngle,Math.atan2(target.y-this.y,target.x-this.x),dt*5.2);
      this.mayhemStateTimer+=dt;
      if(this.mayhemStateTimer>=2){
        scheduleMayhemAmplifier(this,this.mayhemAmpAngle);
        this.mayhemState='normal';this.mayhemStateTimer=0;
      }
    }else if(this.mayhemState==='fire_charge'){
      this.mayhemStateTimer-=dt;
      if(Math.random()<dt*38) abilityTrails.push({points:[{x:this.x,y:this.y}],dot:true,t:0,dur:.38,color:Math.random()<.35?'#ffd067':'#ff6500'});
      if(this.mayhemStateTimer<=0){
        this.mayhemState='normal';this.mayhemStateTimer=0;this.mayhemChargeHits={};
        const speed=this.char.baseSpeed,angle=Math.atan2(this.vy,this.vx);
        this.vx=Math.cos(angle)*speed;this.vy=Math.sin(angle)*speed;
      }
    }

    // Neither regular nor Blue Fire projectiles may charge or launch while
    // Amplifier or Fire Charge is active. Both clocks pause until Mayhem is free.
    if(this.mayhemState==='normal'){
      if(this.mayhemUltActive){
        this.mayhemUltShotTimer-=dt;
        while(this.mayhemUltShotTimer<=0&&this.mayhemUltDuration>0){
          spawnMayhemFireball(this,true);
          this.mayhemUltShotTimer+=4;
        }
      }
      this.mayhemFireballTimer+=dt;
      if(this.mayhemFireballTimer>=this.mayhemFireballInterval&&getNearestMayhemTarget(this)){
        this.mayhemFireballTimer=0;
        spawnMayhemFireball(this,false);
      }
    }
  }

  updateHarperAfterimages(dt){
    // Every saved pose ages out at exactly half a second.
    this.harperAfterimages.forEach(image=>image.age+=dt);
    this.harperAfterimages=this.harperAfterimages.filter(image=>image.age<=.5);
    if(this.harperForm!=='demon'){
      this.harperAfterimages=[];
      this.harperAfterimageTimer=0;
      return;
    }

    // Record roughly fifteen poses per second. This creates a readable trail
    // without filling the arena with dozens of overlapping silhouettes.
    this.harperAfterimageTimer+=dt;
    const snapshotRate=.067;
    while(this.harperAfterimageTimer>=snapshotRate){
      this.harperAfterimageTimer-=snapshotRate;
      this.harperAfterimages.push({x:this.x,y:this.y,angle:this.angle,age:0});
    }
  }

  emitHarperRoarPulse(){
    // The roar never deals damage. It refreshes a short 50% movement slow so
    // the effect remains continuous across the first four seconds.
    for(const enemy of [...balls,...copies]){
      if(!enemy.alive||enemy.side===this.side) continue;
      enemy.harperRoarSlowTimer=Math.max(enemy.harperRoarSlowTimer||0,.7);
    }
    effects.push({type:'harper_roar',x:this.x,y:this.y,r:this.r,maxR:Math.hypot(W,H)*1.08,color:HARPER_ROSE,t:0,dur:.7});
  }

  finishHarperUlt(){
    this.harperUltActive=false;
    this.harperUltPhase='';
    this.harperUltTimer=0;
    this.ultProgress=0;
    this.harperRoarTimer=0;
    effects.push({type:'ring',x:this.x,y:this.y,r:this.r,maxR:this.r+78,color:HARPER_ROSE,t:0,dur:.5});
  }

  updateHarperUltimate(dt){
    this.ultProgress=1;

    if(this.harperRoarTimer>0){
      this.harperRoarTimer=Math.max(0,this.harperRoarTimer-dt);
      this.harperRoarPulseTimer-=dt;
      while(this.harperRoarPulseTimer<=0&&this.harperRoarTimer>0){
        this.harperRoarPulseTimer+=.5;
        this.emitHarperRoarPulse();
      }
    }

    if(this.harperUltPhase==='spawn'){
      this.harperUltSpawnTimer+=dt;
      while(this.harperUltSpawnTimer>=.1&&this.harperUltSpawned<40){
        this.harperUltSpawnTimer-=.1;
        spawnHarperUltimateFieldGem(this);
        this.harperUltSpawned++;
      }
      if(this.harperUltSpawned>=40){
        this.harperUltPhase='hold';
        this.harperUltWaitTimer=1;
      }
      return;
    }

    if(this.harperUltPhase==='hold'){
      this.harperUltWaitTimer-=dt;
      if(this.harperUltWaitTimer<=0){
        launchHarperUltimateWave(this);
        this.harperUltWavesSent=1;
        this.harperUltWaveTimer=1;
        this.harperUltPhase='waves';
      }
      return;
    }

    if(this.harperUltPhase==='waves'){
      this.harperUltWaveTimer-=dt;
      while(this.harperUltWaveTimer<=0&&this.harperUltWavesSent<4){
        launchHarperUltimateWave(this);
        this.harperUltWavesSent++;
        this.harperUltWaveTimer+=this.harperUltWaveInterval;
      }
      if(this.harperUltWavesSent>=4) this.finishHarperUlt();
    }
  }

  updateHarper(dt,enemies){
    this.harperTransformIFrames=Math.max(0,this.harperTransformIFrames-dt);

    // During Gem Dominion all ordinary shard and special-ability production
    // pauses. Only the 40 arena gems are managed until all four waves launch.
    if(this.harperUltActive){
      this.updateHarperUltimate(dt);
      return;
    }

    // Ultimate charge survives the form change, but Gem Dominion can only
    // activate after Daemon Install.
    this.harperUltTimer+=dt;
    this.ultProgress=Math.min(1,this.harperUltTimer/this.harperUltInterval);
    if(this.harperForm==='demon'&&this.harperUltTimer>=this.harperUltInterval){
      this.activateHarperUlt();
      return;
    }

    // Both forms accelerate smoothly as HP falls. Production is always
    // consecutive: exactly one automatic shard per completed interval.
    this.harperShardInterval=getHarperShardInterval(this);
    this.harperShardTimer+=dt;
    while(this.harperShardTimer>=this.harperShardInterval){
      this.harperShardTimer-=this.harperShardInterval;
      spawnHarperShard(this,1);
    }

    this.harperSpecialTimer+=dt;
    if(this.harperSpecialTimer>=this.harperSpecialInterval&&enemies.length){
      this.harperSpecialTimer=0;
      const target=enemies.reduce((a,b)=>
        Math.hypot(a.x-this.x,a.y-this.y)<Math.hypot(b.x-this.x,b.y-this.y)?a:b
      );
      // Shared replacement ability: exactly 50% Gem Shatter, 50% Bloodstone.
      if(Math.random()<.5) activateHarperGemShatter(this,target);
      else spawnHarperBloodstone(this,{x:target.x,y:target.y});
    }
  }

  activateHarperUlt(){
    if(this.harperForm!=='demon'||this.harperUltActive) return;
    this.harperUltActive=true;
    this.harperUltPhase='spawn';
    this.harperUltSpawnTimer=0;
    this.harperUltSpawned=0;
    this.harperUltWaitTimer=0;
    this.harperUltWavesSent=0;
    this.harperUltWaveTimer=0;
    this.harperRoarTimer=4;
    this.harperRoarPulseTimer=.5;

    // Clear Harper's normal shards so the harmless arena-gem setup is clean.
    harperShards.forEach(shard=>{if(shard.owner===this) shard.alive=false;});
    this.emitHarperRoarPulse();
    effects.push({type:'text',x:this.x,y:this.y-this.r-24,text:'ROAR!',color:'#ffffff',t:0,dur:1});
    effects.push({type:'ult_flash',x:this.x,y:this.y,r:135,color:HARPER_ROSE,t:0,dur:.8});
    effects.push({type:'ring',x:this.x,y:this.y,r:this.r,maxR:this.r+95,color:'#ffffff',t:0,dur:.7});
    triggerScreenUltFlash('#4a1026',.78);
  }

  activateDaemonInstall(){
    this.harperInstalled=true;
    this.harperForm='demon';
    this.maxHp=800*(this.isJuggernaut?2.15:1);
    this.maxHpFull=this.maxHp;
    this.hp=this.maxHp;
    this.harperTransformIFrames=1.2;
    this.harperShardTimer=0;
    this.harperSpecialTimer=0;
    this.harperAfterimages=[];
    this.harperAfterimageTimer=0;
    effects.push({type:'ult_flash',x:this.x,y:this.y,r:130,color:'#ff3366',t:0,dur:.85});
    effects.push({type:'ring',x:this.x,y:this.y,r:this.r,maxR:this.r+95,color:'#ffd0dd',t:0,dur:.7});
    effects.push({type:'text',x:this.x,y:this.y-this.r-20,text:'DAEMON INSTALL',color:'#ffd5df',t:0,dur:.9});
    triggerScreenUltFlash('#22000a',.82);
  }

  drawHarperBall(ctx){
    ctx.save();
    const demon=this.harperForm==='demon';
    // Draw old daemon poses first so Harper's current body is always crisp.
    if(demon){
      this.harperAfterimages
        .slice()
        .sort((a,b)=>b.age-a.age)
        .forEach(image=>drawHarperDaemonAfterimage(ctx,image,this.r));
    }
    if(this.harperTransformIFrames>0){
      ctx.beginPath();ctx.arc(this.x,this.y,this.r*1.75,0,Math.PI*2);
      ctx.fillStyle='rgba(255,90,130,.16)';ctx.fill();
      ctx.beginPath();ctx.arc(this.x,this.y,this.r*1.35,0,Math.PI*2);
      ctx.strokeStyle='rgba(255,220,230,.9)';ctx.lineWidth=3;ctx.stroke();
    }
    if(this.harperUltActive){
      const pulse=1+.08*Math.sin(Date.now()/70);
      ctx.beginPath();ctx.arc(this.x,this.y,this.r*1.8*pulse,0,Math.PI*2);
      ctx.strokeStyle='rgba(232,95,141,.95)';ctx.lineWidth=3;
      ctx.shadowColor=HARPER_ROSE;ctx.shadowBlur=20;ctx.stroke();ctx.shadowBlur=0;
    }
    // Match the rest of the roster's slow ball rotation.
    ctx.translate(this.x,this.y);ctx.rotate(this.angle);
    drawHarperIcon(ctx,0,0,this.r,demon);
    ctx.restore();
  }

  isCrit(){
    if(this.char.id==='villainy') return this.thrustUltActive || this.inBlitz;
    return Math.random()<0.15;
  }

  update(dt,enemies,allBalls){
    if(!this.alive) return;
    if(this.char.id==='ray'&&!this.isCopy){
      this.rayPanicClock+=dt;
      this.rayGraniteCooldown=Math.max(0,this.rayGraniteCooldown-dt);
      this.rayPanicDamage=this.rayPanicDamage.filter(hit=>this.rayPanicClock-hit.time<3);
      this.rayPanicTotal=this.rayPanicDamage.reduce((sum,hit)=>sum+hit.amount,0);
    }
    this.angle+=this.spinSpeed;
    this.flashTimer=Math.max(0,this.flashTimer-dt);
    this.hitCooldown=Math.max(0,this.hitCooldown-dt);
    this.lionSpawnImmunity=Math.max(0,this.lionSpawnImmunity-dt);
    this.harperRoarSlowTimer=Math.max(0,(this.harperRoarSlowTimer||0)-dt);
    this.domainSlowTimer=Math.max(0,(this.domainSlowTimer||0)-dt);
    this.rayCrossSlowTimer=Math.max(0,(this.rayCrossSlowTimer||0)-dt);
    this.mattZoneSlowTimer=Math.max(0,(this.mattZoneSlowTimer||0)-dt);
    this.mattKnockbackTimer=Math.max(0,(this.mattKnockbackTimer||0)-dt);
    if(this.char.id==='matt')this.mattClock+=dt;
    if(this.char.id==='harper') this.updateHarperAfterimages(dt);

    if(this.isCopy && this.char.id==='manic_lion' && !this.fromUlt){
      this.decayTimer+=dt;
      const frac=this.decayTimer/this.decayDuration;
      this.hp=this.maxHp*(1-frac);
      if(frac>=1){this.alive=false;return;}
    }

    // Plasma's ultimate freezes opposing ability and ultimate timers. Movement
    // remains active and is normalized to 25% speed below.
    if(!this.plasmaChargePaused && !(isDomainMode()&&domainState?.phase==='active'&&this.realm===1&&domainState.owner.char.id==='emmy')){
      if(this.char.id==='manic_lion') this.updateLion(dt,enemies);
      if(this.char.id==='villainy') this.updateVillainy(dt,enemies);
      if(this.char.id==='devourer') this.updateDevourer(dt,enemies);
      if(this.char.id==='engineer') this.updateEngineer(dt,enemies);
      if(this.char.id==='elder_tree') this.updateElderTree(dt,enemies);
      if(this.char.id==='ray') this.updateRay(dt,enemies);
      if(this.char.id==='dark_knight') updateDarkKnight.call(this,dt,enemies);
      if(this.char.id==='emmy') this.updateEmmy(dt,enemies);
      if(this.char.id==='maniac_artist') this.updateManiacArtist(dt,enemies);
      if(this.char.id==='plasma') this.updatePlasma(dt,enemies);
      if(this.char.id==='harper') this.updateHarper(dt,enemies);
      if(this.char.id==='mayhem') this.updateMayhem(dt,enemies);
      if(this.char.id==='matt') this.updateMatt(dt);
      if(this.char.id==='hyperbole') this.updateHyperbole(dt,enemies);
    }

    // Artist's grayscale copy uses the same timed Split without Hyperbole's cooldowns.
    if(this.char.id==='maniac_artist'&&this.hyperboleSplit){
      this.hyperboleSplit.elapsed+=dt;
      const target=enemies.slice().sort((a,b)=>Math.hypot(a.x-this.x,a.y-this.y)-Math.hypot(b.x-this.x,b.y-this.y))[0];
      if(target){this.hyperboleSplit.target=target;this.hyperboleSplit.dx=target.x-this.x;this.hyperboleSplit.dy=target.y-this.y;}
      this.hyperboleSplit.end=hyperboleLineEnd(this,this.hyperboleSplit.dx,this.hyperboleSplit.dy);
      if(this.hyperboleSplit.elapsed>=1)finishHyperboleSplit(this);
    }
    if(this.hyperboleRiftCharge){
      const charge=this.hyperboleRiftCharge;
      charge.elapsed+=dt;
      if(charge.elapsed>=charge.duration){
        this.hyperboleRiftCharge=null;
        spawnHyperboleRift(this,charge.gray);
      }
    }

    if(this.artistLaunch){
      this.artistLaunch.time-=dt;
      const factor=Math.max(1,1+3*(this.artistLaunch.time/2));
      const cur=Math.hypot(this.vx,this.vy)||1;
      this.vx=this.vx/cur*this.artistLaunch.baseSpeed*factor;
      this.vy=this.vy/cur*this.artistLaunch.baseSpeed*factor;
      if(this.artistLaunch.time<=0)this.artistLaunch=null;
    }

    // The 0.25x voltage slow also applies to dashes and other special motion,
    // not only ordinary roaming speed.
    if(this.plasmaSlowed){
      const slowedSpeed=this.getSpeed(),cur=Math.hypot(this.vx,this.vy)||1;
      this.vx=this.vx/cur*slowedSpeed;this.vy=this.vy/cur*slowedSpeed;
    }

    // The DON'T MOVE omen also caps movement from special dashes and knockback.
    const activeOmen=domainState?.phase==='active'&&this.realm===1&&domainState.owner.char.id==='hyperbole'&&this.side!==domainState.owner.side?domainState.data.omen:null;
    if(activeOmen?.type==='DON\'T MOVE'){
      const stopAt=activeOmen.stopTimes.get(this.id)??1;
      const fraction=stopAt<=0?0:Math.max(0,1-(1-activeOmen.remaining)/stopAt);
      const cap=this.char.baseSpeed*fraction;
      const current=Math.hypot(this.vx,this.vy);
      if(current>cap&&current>0){this.vx*=cap/current;this.vy*=cap/current;}
    }

    if(!this.inThrust || this.plasmaChargePaused){
      this.x+=this.vx;
      this.y+=this.vy;
    }

    const myR = this.char.id==='elder_tree' ? this.etGrowR : this.r;
    let didBounce=false;
    if(isDomainMode()){
      didBounce=bouncePointOffArena(this,myR);
    }else if(isHexArena()){
      didBounce=bouncePointOffArena(this,myR);
    }else{
      const minX=myR, maxX=W-myR, minY=myR, maxY=H-myR;
      if(this.x<minX){this.x=minX;this.vx=Math.abs(this.vx);didBounce=true;}
      if(this.x>maxX){this.x=maxX;this.vx=-Math.abs(this.vx);didBounce=true;}
      if(this.y<minY){this.y=minY;this.vy=Math.abs(this.vy);didBounce=true;}
      if(this.y>maxY){this.y=maxY;this.vy=-Math.abs(this.vy);didBounce=true;}
    }
    if(didBounce && this.isCopy && this.char.id==='manic_lion'){
      if(this.domainLion){
        const target=balls.filter(b=>b.alive&&b.side!==this.side&&sameRealm(b,this)).sort((a,b)=>Math.hypot(a.x-this.x,a.y-this.y)-Math.hypot(b.x-this.x,b.y-this.y))[0];
        if(target){const a=Math.atan2(target.y-this.y,target.x-this.x);this.vx=Math.cos(a)*this.getSpeed();this.vy=Math.sin(a)*this.getSpeed();}
      }else redirectLionCopyAfterBounce(this);
    }
    if(didBounce) domainEmmyRedirectAfterBounce(this);
    if(didBounce)hyperboleOmenTouch(this);
    // Plasma and Maniac Artist's copied Current both place an anchor when
    // they bounce from an arena wall while the Current is armed.
    if(didBounce && this.plasmaCurrentArmed) registerPlasmaWallPoint(this);
    if(didBounce && this.artistLaunch && this.artistWallHitCooldown<=0){
      this.takeDamage(10,this.artistLaunch.owner);this.artistWallHitCooldown=.15;
    }
    this.artistWallHitCooldown=Math.max(0,(this.artistWallHitCooldown||0)-dt);

    if(!this.inChainDash && !this.inThrust && !this.inBlitz && !this.artistLaunch && !(this.mattKnockbackTimer>0)){
      if(this.domainThrownTimer>0) this.domainThrownTimer=Math.max(0,this.domainThrownTimer-dt);
      const spd=this.getSpeed()*(this.domainThrownTimer>0?1+4*this.domainThrownTimer/2:1);
      const cur=Math.hypot(this.vx,this.vy);
      if(cur>0.01){this.vx=this.vx/cur*spd;this.vy=this.vy/cur*spd;}
      else{const a=Math.random()*Math.PI*2;this.vx=Math.cos(a)*spd;this.vy=Math.sin(a)*spd;}
    }
  }

  // ---- MANIAC ARTIST UPDATE ----
  updateManiacArtist(dt,enemies){
    const shieldWasActive=this.artistForceActive>0;
    this.artistForceActive=Math.max(0,this.artistForceActive-dt);
    this.artistCopyFlash=Math.max(0,this.artistCopyFlash-dt);
    this.artistGrayAbility=Math.max(0,this.artistGrayAbility-dt);
    this.artistForceGray=Math.max(0,this.artistForceGray-dt);
    if(this.artistMattSequence){
      this.artistMattSequence.timer-=dt;
      while(this.artistMattSequence.remaining>0&&this.artistMattSequence.timer<=0){
        mattFireSlash(this,true);this.artistMattSequence.remaining--;
        this.artistMattSequence.timer+=.25;
      }
      if(this.artistMattSequence.remaining===0)this.artistMattSequence=null;
    }
    this.artistCopiedShieldGlow=Math.max(0,(this.artistCopiedShieldGlow||0)-dt);
    this.updateArtistHarperBloodstoneCopy(dt);
    for(const key in this.artistMayhemChargeHits){
      this.artistMayhemChargeHits[key]-=dt;
      if(this.artistMayhemChargeHits[key]<=0) delete this.artistMayhemChargeHits[key];
    }
    if(this.artistMayhemCharge>0){
      this.artistMayhemCharge=Math.max(0,this.artistMayhemCharge-dt);
      if(Math.random()<dt*32) abilityTrails.push({points:[{x:this.x,y:this.y}],dot:true,t:0,dur:.35,color:Math.random()<.3?'#f2f2f2':'#8c8c8c'});
      if(this.artistMayhemCharge<=0) this.artistMayhemChargeHits={};
    }
    if(this.artistVillainyCopy>0){
      this.artistVillainyCopy=Math.max(0,this.artistVillainyCopy-dt);
      // Villainy copy leaves a fast grayscale trail until the first enemy hit.
      // Renderable dot trail. The old object had no points array and crashed render().
      if(Math.random()<dt*35) abilityTrails.push({points:[{x:this.x,y:this.y}],dot:true,t:0,dur:.32,color:'#d8d8d8'});
      if(this.artistVillainyCopy<=0) this.artistVillainyHit=false;
    }
    for(const k in this.artistHitCooldowns) this.artistHitCooldowns[k]-=dt;
    if(!shieldWasActive)this.artistForceTimer+=dt;
    if(this.artistForceTimer>=this.artistForceInterval){
      this.artistForceTimer=0;this.artistForceActive=4;
      effects.push({type:'ring',x:this.x,y:this.y,r:this.r,maxR:this.r*2,color:'#ff8fca',t:0,dur:.45});
    }
    if(this.artistUltType){this.updateArtistUltimate(dt,enemies);return;}
    // Copied Fire Charge temporarily replaces Artist's normal drill/swipe cycle.
    if(this.artistMayhemCharge>0) return;

    this.artistUltTimer+=dt;
    this.ultProgress=Math.min(1,this.artistUltTimer/this.artistUltInterval);
    if(this.artistUltTimer>=this.artistUltInterval){this.activateArtistUltimate(enemies);return;}

    if(this.artistState==='normal'){
      this.artistAbilityTimer+=dt;
      if(this.artistAbilityTimer>=this.artistAbilityInterval && enemies.length){
        this.artistAbilityTimer=0;
        const target=enemies.reduce((a,b)=>Math.hypot(a.x-this.x,a.y-this.y)<Math.hypot(b.x-this.x,b.y-this.y)?a:b);
        this.artistAim=Math.atan2(target.y-this.y,target.x-this.x);
        this.artistState=Math.random()<.5?'drill_charge':'swipe_ready';
        this.artistStateTimer=0;this.artistHitIds.clear();
      }
    }else if(this.artistState==='drill_charge'){
      this.artistStateTimer+=dt;
      if(this.artistStateTimer>=1.25){
        this.artistState='drill';this.artistStateTimer=0;
        const s=this.char.baseSpeed*3;this.vx=Math.cos(this.artistAim)*s;this.vy=Math.sin(this.artistAim)*s;
      }
    }else if(this.artistState==='drill'){
      this.artistStateTimer+=dt;
      if(Math.random()<dt*28){
        const travelAngle=Math.atan2(this.vy,this.vx);
        const sideOffset=(Math.random()-.5)*this.r*1.25;
        effects.push({type:'artist_wind',x:this.x-Math.cos(travelAngle)*this.r+Math.cos(travelAngle+Math.PI/2)*sideOffset,y:this.y-Math.sin(travelAngle)*this.r+Math.sin(travelAngle+Math.PI/2)*sideOffset,angle:travelAngle,t:0,dur:.42});
      }
      if(this.artistStateTimer>=5){this.artistState='normal';this.artistStateTimer=0;this.artistHitCooldowns={};}
    }else if(this.artistState==='swipe_ready'){
      this.artistStateTimer+=dt;
      const live=enemies.filter(e=>e.alive);
      if(!live.length){this.artistState='normal';return;}
      const target=live.reduce((a,b)=>Math.hypot(a.x-this.x,a.y-this.y)<Math.hypot(b.x-this.x,b.y-this.y)?a:b);
      this.artistAim=Math.atan2(target.y-this.y,target.x-this.x);
      if(Math.hypot(target.x-this.x,target.y-this.y)<=this.r+target.r+65){
        this.artistState='swipe';this.artistStateTimer=0;this.artistHitIds.clear();
        target.takeDamage(80,this);
        applyArtistLaunch(target,this,Math.atan2(target.y-this.y,target.x-this.x));
        effects.push({type:'shockwave',x:this.x,y:this.y,r:this.r,maxR:this.r+145,color:'#ff9bce',t:0,dur:.42,damage:0,side:this.side,owner:this,hit:new Set(),turretHit:new Set()});
      }
    }else if(this.artistState==='swipe'){
      this.artistStateTimer+=dt;
      if(this.artistStateTimer>=.5){this.artistState='normal';this.artistStateTimer=0;}
    }
  }

  updateArtistHarperBloodstoneCopy(dt){
    const stone=this.artistHarperBloodstone;
    if(!stone||!stone.alive){
      this.artistHarperBloodstone=null;
      this.artistHarperSource=null;
      this.artistHarperGemTimer=0;
      return;
    }

    // Re-read Harper's current interval continuously, so the copied production
    // speeds up at exactly the same HP breakpoints as Harper during the round.
    const source=this.artistHarperSource;
    if(source&&source.char?.id==='harper') this.artistHarperInterval=getHarperShardInterval(source);
    const interval=Math.max(.05,this.artistHarperInterval||1);
    this.artistHarperGemTimer+=dt;
    while(this.artistHarperGemTimer>=interval){
      this.artistHarperGemTimer-=interval;
      spawnHarperShard(this,1,null,{
        artistGrayCopy:true,
        formSource:source||this,
        onlyTargetStone:true,
        forcedStoneId:stone.id
      });
    }
  }

  artistRegisterContact(target){
    if(!target||!target.alive)return;
    this.artistDodge=Math.min(.60,this.artistDodge+.02);
    this.artistCopyHits++;
    this.artistCopyTarget=getCombatOwner(target)||target;
    const domainCopy=isDomainMode()&&domainState?.phase==='active'&&domainState.owner===this;
    if(this.artistCopyHits>=(domainCopy?1:4)){
      this.artistCopyHits=0;this.artistCopyFlash=1;
      effects.push({type:'text',x:this.x,y:this.y-this.r-15,text:'COPY!',color:'#ffffff',t:0,dur:.7});
