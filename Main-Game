function drawMattDomainDash(ctx,dash){
  const p=Math.min(1,dash.life/dash.dur),fade=(1-p)**1.45;
  const dx=dash.x2-dash.x1,dy=dash.y2-dash.y1,length=Math.hypot(dx,dy)||1;
  const nx=-dy/length,ny=dx/length;
  ctx.save();ctx.lineCap='round';
  // The broad green glow fades behind a shorter, bright travelling streak.
  for(const [width,color,blur,alpha] of [[27,'#72ffad',25,.22],[11,'#b0ffd1',14,.55],[3,'#ffffff',8,.92]]){
    ctx.globalAlpha=fade*alpha;ctx.strokeStyle=color;ctx.lineWidth=width;ctx.shadowColor=color;ctx.shadowBlur=blur;
    ctx.beginPath();ctx.moveTo(dash.x1,dash.y1);ctx.lineTo(dash.x2,dash.y2);ctx.stroke();
  }
  const head=Math.min(1,p*3.3),tail=Math.max(0,head-.22);
  ctx.globalAlpha=fade;ctx.strokeStyle='#f5fff9';ctx.lineWidth=5;ctx.shadowColor='#caffdf';ctx.shadowBlur=19;
  ctx.beginPath();ctx.moveTo(dash.x1+dx*tail,dash.y1+dy*tail);
  ctx.lineTo(dash.x1+dx*head,dash.y1+dy*head);ctx.stroke();
  ctx.shadowBlur=0;
  for(const particle of dash.particles){
    const along=Math.min(1,particle.along+p*.25),side=particle.side+particle.drift*p;
    const x=dash.x1+dx*along+nx*side,y=dash.y1+dy*along+ny*side;
    ctx.globalAlpha=fade*(.55+.45*particle.along);
    ctx.fillStyle=particle.along>.65?'#ffffff':'#89ffc1';
    ctx.fillRect(x-particle.size/2,y-particle.size/2,particle.size,particle.size);
  }
  for(const [x,y,age] of [[dash.x1,dash.y1,1],[dash.x2,dash.y2,.8]]){
    ctx.globalAlpha=fade*age;ctx.strokeStyle='#d8ffeb';ctx.lineWidth=2.4;
    ctx.shadowColor='#63ffaa';ctx.shadowBlur=21;
    ctx.beginPath();ctx.arc(x,y,dash.r*(.85+p*.8),0,Math.PI*2);ctx.stroke();
  }
  ctx.shadowBlur=0;
  // Faint copies of Matt mark departure and arrival, then disappear quickly.
  ctx.globalAlpha=fade*.48;drawMattIcon(ctx,dash.x1,dash.y1,dash.r);
  ctx.globalAlpha=fade*.31;drawMattIcon(ctx,dash.x2,dash.y2,dash.r);
  ctx.restore();
}
