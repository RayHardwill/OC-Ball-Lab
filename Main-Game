  }

  updateVillainy(dt,enemies){
    const domainBlitz=isDomainMode()&&domainState?.phase==='active'&&domainState.owner===this&&this.realm===1;
    if(domainBlitz){
      // Keep the ordinary blitz movement and guaranteed crit throughout the
      // domain, including the time between predicted instant blitzes.
      this.inBlitz=true;
      const speed=this.getSpeed(),length=Math.hypot(this.vx,this.vy)||1;
      this.vx=this.vx/length*speed;this.vy=this.vy/length*speed;
    }
    if(!this.inBlitz){
      this.vPhaseTimer+=dt;
      if(this.vSpeedPhase===0){
        if(this.vPhaseTimer>=2){this.vSpeedPhase=1;this.vPhaseTimer=0;}
      } else if(this.vSpeedPhase===1){
        if(this.vPhaseTimer>=2.5){this.vSpeedPhase=2;this.vPhaseTimer=0;}
      } else {
        if(this.vPhaseTimer>=3){this.vSpeedPhase=0;this.vPhaseTimer=0;}
      }
    }

    // Each enemy has its own two-second cooldown after Villainy hits it.
    for(const k in this.villainUltTargetCooldowns){
      this.villainUltTargetCooldowns[k]-=dt;
      if(this.villainUltTargetCooldowns[k]<=0) delete this.villainUltTargetCooldowns[k];
    }

    if(!this.isCopy){
      this.thrustUltTimer+=dt;
      this.ultProgress=Math.min(1,this.thrustUltTimer/this.thrustUltInterval);
      if(!this.thrustUltActive && this.thrustUltTimer>=this.thrustUltInterval) this.activateVillainyUlt();

      if(!this.thrustUltActive && !this.inBlitz &&
         !(isDomainMode()&&domainState?.phase==='active'&&domainState.owner===this)){
        this.thrustTimer+=dt;
        if(this.thrustTimer>=this.thrustInterval){
          this.thrustTimer=0;
          this.thrustInterval=6+Math.random()*3;
          this.startBlitz();
        }
      }

      if(this.thrustUltActive){
        this.thrustUltDuration-=dt;
        const ballTargets=[...balls,...copies].filter(b=>b.alive&&b.side!==this.side);
        const turretTargets=turrets.filter(t=>t.alive&&t.side!==this.side);
        const targets=[...ballTargets,...turretTargets];

        if(!targets.length){
          this.thrustUltActive=false;this.thrustUltTimer=0;this.ultProgress=0;
          this.ultTargetRef=null;this.inThrust=false;
        }else{
          let target=this.ultTargetRef;
          if(!target||!target.alive||target.side===this.side||(this.villainUltTargetCooldowns[target.id]||0)>0){
            const eligible=targets.filter(e=>(this.villainUltTargetCooldowns[e.id]||0)<=0);
            target=eligible.length?eligible.reduce((a,b)=>
              Math.hypot(a.x-this.x,a.y-this.y)<Math.hypot(b.x-this.x,b.y-this.y)?a:b):null;
            this.ultTargetRef=target;
          }

          const spd=this.getSpeed();
          if(target){
            const dx=target.x-this.x,dy=target.y-this.y,dist=Math.hypot(dx,dy)||1;
            this.vx=dx/dist*spd;this.vy=dy/dist*spd;this.inThrust=true;
            const move=Math.min(spd,dist);
            this.x+=dx/dist*move;this.y+=dy/dist*move;

            const targetR=target.char?(target.char.id==='elder_tree'?target.etGrowR:target.r):target.r;
            if(Math.hypot(this.x-target.x,this.y-target.y)<=this.r+targetR+2){
              // One fixed damage instance: no crit and no tick damage.
              const dmg=55;
              target.takeDamage(dmg,this);
              this.villainUltTargetCooldowns[target.id]=2;

              effects.push({type:'ring',x:target.x,y:target.y,r:targetR,maxR:targetR+60,color:'#aaccff',t:0,dur:0.45});
              effects.push({type:'ult_flash',x:target.x,y:target.y,r:65,color:'#aaccff',t:0,dur:0.3});
              effects.push({type:'punch',x:target.x,y:target.y,t:0,dur:0.45});

              // Bounce away and immediately stop chasing this target.
              const ang=Math.atan2(this.y-target.y,this.x-target.x);
              this.vx=Math.cos(ang)*spd;this.vy=Math.sin(ang)*spd;
              this.x=target.x+Math.cos(ang)*(targetR+this.r+3);
              this.y=target.y+Math.sin(ang)*(targetR+this.r+3);
              this.inThrust=false;
              this.ultTargetRef=null;
            }
          }else{
            // If every target is cooling down, keep travelling in the last direction.
            this.inThrust=false;
            const cur=Math.hypot(this.vx,this.vy)||1;
            this.vx=this.vx/cur*spd;this.vy=this.vy/cur*spd;
          }
        }

        if(this.thrustUltDuration<=0){
          this.thrustUltActive=false;this.thrustUltTimer=0;this.ultProgress=0;
          this.ultTargetRef=null;this.inThrust=false;
          const spd2=this.getSpeed(),cur=Math.hypot(this.vx,this.vy)||1;
          this.vx=this.vx/cur*spd2;this.vy=this.vy/cur*spd2;
        }
      }
    }

    if(this.inBlitz){
      this.blitzTrailTimer-=dt;
      if(this.blitzTrailTimer<=0){
        this.blitzTrailTimer=0.04;
        abilityTrails.push({points:[{x:this.x,y:this.y}],t:0,dur:0.35,color:domainBlitz?'rgba(255,84,109,.85)':'rgba(180,220,255,0.9)',dot:true});
      }
      if(domainBlitz)return; // contact still receives Villainy's 3x blitz crit
      if(!this.blitzHitDone){
        const allActive=[...balls,...copies];
        const hit=allActive.find(b=>b.alive&&b.side!==this.side&&Math.hypot(b.x-this.x,b.y-this.y)<this.r+b.r+2);
        const hitTurret=!hit?turrets.find(t=>t.alive&&t.side!==this.side&&Math.hypot(t.x-this.x,t.y-this.y)<this.r+t.r+2):null;
        if(hit||hitTurret){
          this.blitzHitDone=true;this.inBlitz=false;
          const dmg=this.getDamage()*this.char.critMult;
          const hitObj=hit||hitTurret;
          hitObj.takeDamage(dmg,this);
          domainCount(this,'blitz',1);
          effects.push({type:'ring',x:hitObj.x,y:hitObj.y,r:hitObj.r,maxR:hitObj.r+70,color:'#aaccff',t:0,dur:0.45});
          effects.push({type:'ult_flash',x:hitObj.x,y:hitObj.y,r:60,color:'#ffffff',t:0,dur:0.25});
          const ang=Math.atan2(this.y-hitObj.y,this.x-hitObj.x),spd=this.char.baseSpeed;
          this.vx=Math.cos(ang)*spd;this.vy=Math.sin(ang)*spd;
          this.vSpeedPhase=0;this.vPhaseTimer=0;
        }
      }else this.inBlitz=false;
    }
  }

  startBlitz(){
    this.inBlitz=true;
    this.blitzHitDone=false;
    this.blitzTrailTimer=0;
    const cur=Math.hypot(this.vx,this.vy)||1;
    this.vx=this.vx/cur*20;
    this.vy=this.vy/cur*20;
    effects.push({type:'ult_flash',x:this.x,y:this.y,r:40,color:'#aaccff',t:0,dur:0.3});
  }

  startUltBounce(target){
    const dx=target.x-this.x, dy=target.y-this.y;
    const dist=Math.hypot(dx,dy)||1;
    const nx=dx/dist, ny=dy/dist;
    const targetR=target.char && target.char.id==='elder_tree' ? target.etGrowR : target.r;
    const aimX=target.x-nx*targetR;
    const aimY=target.y-ny*targetR;
    this.inThrust=true;
    this.thrustStartX=this.x;
    this.thrustStartY=this.y;
    this.thrustTargetX=aimX;
    this.thrustTargetY=aimY;
    this.thrustTargetRef=target;
    this.thrustProgress=0;
    this.thrustHit=false;
    const steps=[];
    for(let i=0;i<=20;i++) steps.push({x:this.x+(aimX-this.x)*i/20, y:this.y+(aimY-this.y)*i/20});
    abilityTrails.push({points:steps,t:0,dur:0.5,color:'rgba(150,200,255,0.85)'});
  }

  activateVillainyUlt(){
    this.thrustUltActive=true;
    this.thrustUltDuration=10;
    this.ultBounceWavesLeft=5;
    this.ultBounceWaveTimer=0.3;
    this.villainUltTargetCooldowns={};
    effects.push({type:'ult_flash',x:this.x,y:this.y,r:90,color:'#aaccff',t:0,dur:0.6});
    effects.push({type:'ult_flash',x:this.x,y:this.y,r:50,color:'#ffffff',t:0,dur:0.35});
    triggerScreenUltFlash('#001a44', 0.5);
    const spd=this.getSpeed();
    const cur=Math.hypot(this.vx,this.vy)||1;
    this.vx=this.vx/cur*spd;
    this.vy=this.vy/cur*spd;
  }

  updateDevourer(dt,enemies){
    if(!this.inChainDash){
      const spd=this.getSpeed();
      const cur=Math.hypot(this.vx,this.vy);
      if(cur>0.01){const f=spd/cur;this.vx*=f;this.vy*=f;}
      else{const a=Math.random()*Math.PI*2;this.vx=Math.cos(a)*spd;this.vy=Math.sin(a)*spd;}
    }
    if(!this.isCopy){
      this.chainTimer+=dt;
      this.devUltTimer+=dt;
      this.ultProgress=Math.min(1,this.devUltTimer/this.devUltInterval);
      if(!this.devUltActive && this.devUltTimer>=this.devUltInterval){
        this.activateDevourerUlt();
      }
      if(this.devUltActive){
        this.devUltDuration-=dt;
        this.devUltRockTimer+=dt;
        if(this.devUltRockTimer>=2.5){
          this.devUltRockTimer-=2.5;
          spawnDevourerRockWalls(this);
        }
        if(this.devUltDuration<=0){
          this.devUltActive=false;
          this.devUltTimer=0;
          this.ultProgress=0;
          effects.push({type:'ult_flash',x:this.x,y:this.y,r:80,color:'#ffcc00',t:0,dur:0.4});
        }
      }
      if(this.chainTimer>=this.chainInterval && enemies.length>0){
        this.chainTimer=0;
        this.chainInterval=12+Math.random()*5;
        const sorted=[...enemies].sort((a,b)=>
          Math.hypot(a.x-this.x,a.y-this.y)-Math.hypot(b.x-this.x,b.y-this.y)
        );
        const targetCount=this.isJuggernaut?Math.min(2,sorted.length):1;
        const chainGroup=Math.random();
        for(let i=0;i<targetCount;i++) doDevourerChain(this,sorted[i],chainGroup,i);
      }
    }
  }

  activateDevourerUlt(){
    this.devUltActive=true;
    this.devUltDuration=10;
    this.devUltRockTimer=0;
    effects.push({type:'ult_flash',x:this.x,y:this.y,r:100,color:'#ffee88',t:0,dur:0.7});
    effects.push({type:'ult_flash',x:this.x,y:this.y,r:70,color:'#ffffff',t:0,dur:0.5});
    triggerScreenUltFlash('#1a0044', 0.5);
  }

  updateEngineer(dt,enemies){
    const spd=this.getSpeed();
    const cur=Math.hypot(this.vx,this.vy);
    if(cur>0.01){const f=spd/cur;this.vx*=f;this.vy*=f;}
    else{const a=Math.random()*Math.PI*2;this.vx=Math.cos(a)*spd;this.vy=Math.sin(a)*spd;}
    if(!this.isCopy){
      this.engTurretTimer+=dt;
      this.engUltTimer+=dt;
      this.ultProgress=Math.min(1,this.engUltTimer/this.engUltInterval);
      if(!this.engUltActive && this.engTurretTimer>=this.engTurretInterval){
        this.engTurretTimer=0;
        this.engTurretInterval=8+Math.random()*4;
        this.spawnTurret(false);
        // Juggernaut Engineer produces a second regular turret per activation.
        if(this.isJuggernaut) this.spawnTurret(false);
      }
      if(!this.engUltActive && this.engUltTimer>=this.engUltInterval){
        this.activateEngineerUlt();
      }
      if(this.engUltActive){
        this.engUltDuration-=dt;
        // The second missile turret arrives halfway through the 10-second ultimate.
        if(!this.engUltSecondTurretSpawned && this.engUltDuration<=5){
          this.engUltSecondTurretSpawned=true;
          this.spawnTurret(true);
        }
        if(this.engUltDuration<=0){
          this.engUltActive=false;
          this.engUltTimer=0;
          this.ultProgress=0;
        }
      }
    }
  }

  spawnTurret(isMissile){
    // Normal Engineer turrets have a 50% chance to be melee turrets.
    // Missile turrets from the ultimate remain missile turrets.
    const isMelee=!isMissile && Math.random()<0.5;
    const t=new Turret(this,isMissile,isMelee);
    turrets.push(t);
    effects.push({type:'ring',x:t.x,y:t.y,r:0,maxR:50,color:isMissile?'#ff6622':(isMelee?'#3399ff':'#ffcc44'),t:0,dur:0.4});
  }

  activateEngineerUlt(){
    this.engUltActive=true;
    this.engUltDuration=10;
    this.engUltSecondTurretSpawned=false;
    this.spawnTurret(true);
    effects.push({type:'ult_flash',x:this.x,y:this.y,r:100,color:'#ffcc00',t:0,dur:0.7});
    effects.push({type:'ult_flash',x:this.x,y:this.y,r:60,color:'#ffffff',t:0,dur:0.45});
    triggerScreenUltFlash('#3a2800', 0.55);
  }

  draw(ctx){
    if(!this.alive || isHiddenByPaperRip(this)) return;
    ctx.save();
    if(this.flashTimer>0) ctx.globalAlpha=0.5+0.5*Math.sin(this.flashTimer*40);
    if(this.char.id==='manic_lion') this.drawLionBall(ctx);
    else if(this.char.id==='villainy') this.drawKnifeBall(ctx);
    else if(this.char.id==='devourer') this.drawFlameBall(ctx);
    else if(this.char.id==='engineer') this.drawEngineerBall(ctx);
    else if(this.char.id==='elder_tree') this.drawElderTreeBall(ctx);
    else if(this.char.id==='ray') this.drawRayBall(ctx);
    else if(this.char.id==='dark_knight') this.drawDarkKnightBall(ctx);
    else if(this.char.id==='emmy') this.drawEmmyBall(ctx);
    else if(this.char.id==='maniac_artist') this.drawManiacArtistBall(ctx);
    else if(this.char.id==='plasma') this.drawPlasmaBall(ctx);
    else if(this.char.id==='harper') this.drawHarperBall(ctx);
    else if(this.char.id==='mayhem') this.drawMayhemBall(ctx);
    else if(this.char.id==='matt') this.drawMattBall(ctx);
    else if(this.char.id==='hyperbole')drawHyperboleIcon(ctx,this.x,this.y,this.r);
    ctx.restore();
    if(!this.isCopy || this.fromUlt){
      const dispR = this.char.id==='elder_tree' ? (this.etUltActive ? this.etUltExpandR : this.etGrowR) : this.r;
      const bw=dispR*2.5, bh=10, bx=this.x-bw/2, by=this.y-dispR-14;
      ctx.fillStyle='#1a1830';
      ctx.fillRect(bx,by,bw,bh);
      const frac=Math.max(0,this.hp/this.maxHp);
      ctx.fillStyle=`hsl(${120*frac},80%,45%)`;
      ctx.fillRect(bx,by,bw*frac,bh);

    }
  }

  drawEmmyBall(ctx){
    ctx.save();
    drawEmmyIcon(ctx,this.x,this.y,this.r,this.emmyUltActive);
    if(!this.emmyDisarmed && !this.emmyUltActive){
      const p=getEmmyWeaponPos(this);
      drawVolleyball(ctx,p.x,p.y,getEmmyWeaponRadius(this),-this.emmyBallAngle*1.7,false);
