      if(beam.hits[e.id]<=0){beam.hits[e.id]=.10;e.takeDamage(10,beam.owner);}
    }
  }
  turrets.forEach(t=>{if(t.alive&&t.side!==beam.side&&sameRealm(t,beam.owner)&&pointSegmentDistance(t.x,t.y,beam.x1,beam.y1,beam.x2,beam.y2)<=beam.width/2+t.r){const k='t'+t.id;beam.hits[k]=(beam.hits[k]||0)-dt;if(beam.hits[k]<=0){beam.hits[k]=.12;t.takeDamage(9,beam.owner);}}});
}

