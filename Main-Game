  drawManiacArtistBall(ctx){
    ctx.save();
    let alpha=1;
    if(this.artistUltType==='omni_drill'&&(this.artistUltPhase==='fade'||this.artistUltPhase==='wait')) alpha=this.artistUltPhase==='fade'?Math.max(0,1-this.artistUltPhaseTimer):0;
