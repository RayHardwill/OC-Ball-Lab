      const pulse=1.55+.12*Math.sin(Date.now()/70);ctx.beginPath();ctx.arc(0,0,this.r*pulse,0,Math.PI*2);
      ctx.strokeStyle='rgba(171,73,255,.92)';ctx.lineWidth=4;ctx.shadowColor='#a33cff';ctx.shadowBlur=22;ctx.stroke();ctx.shadowBlur=0;
