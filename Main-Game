    const lift=Math.sin(Math.PI*q)*g.width*(.45+.7*mayhemRand(seed+i));
    const side=(mayhemRand(seed+i*17)-.5)*g.width*1.2;
    const x=g.x1+dx*q+px*(side+lift),y=g.y1+dy*q+py*(side+lift),s=g.width*(.035+.07*mayhemRand(seed-i));
    ctx.save();ctx.translate(x,y);ctx.rotate(i+now*3);ctx.globalAlpha=fade*(1-q*.55);ctx.fillStyle=i%4===0?'#aebeff':'#2C5AF2';ctx.fillRect(-s,-s,s*2,s*2);ctx.restore();
  }
  for(let i=0;i<12;i++){
    const q=(g.life*(.15+.04*mayhemRand(seed+i))+i/12)%1;
    const drift=(now*.15+i/12)%1,x=g.x1+dx*q+px*Math.sin(q*28+seed)*g.width*.25,y=g.y1+dy*q+py*Math.sin(q*28+seed)*g.width*.25;
    const size=g.width*(.14+.17*drift);ctx.save();ctx.translate(x+px*drift*g.width,y+py*drift*g.width);ctx.rotate(now*.6+i);
    ctx.globalAlpha=fade*.16*(1-drift);ctx.fillStyle='#10152d';ctx.fillRect(-size,-size,size*2,size*2);ctx.restore();
  }
  ctx.restore();
}

function drawMayhemStatusFlames(ctx,target){
  if(!target?.alive) return;
  const orange=(target.onFireTimer||0)>0,blue=(target.inextinguishableStacks||0)>0;
  if(!orange&&!blue) return;
  const r=mayhemEntityRadius(target),now=Date.now()/1000,seed=target.id*97;
  const gray=orange&&!blue&&!!target.onFireGray;
  const outer=gray?'#303030':(blue?MAYHEM_BLUE_DARK:'#a82400');
  const mid=gray?'#8a8a8a':(blue?MAYHEM_BLUE:'#ff4b00');
  const inner=gray?'#f0f0f0':(blue?'#7089ff':'#ffc02d');
  const intensity=blue?1+Math.min(5,target.inextinguishableStacks)*.055:1;
  ctx.save();

  // Heavy smoke sits behind the fighter and follows their current position.
  for(let i=0;i<9;i++){
    const q=(now*.18+i/9)%1,x=target.x+(mayhemRand(seed+i)-.5)*r*1.65;
    const y=target.y+r*.15-q*r*2.15,size=r*(.18+.28*q)*(1+.18*Math.sin(now*3+i));
    ctx.globalAlpha=.20*(1-q);ctx.fillStyle=gray?(i%2?'#242424':'#353535'):(blue?(i%2?'#10152e':'#172251'):(i%2?'#21181a':'#32201b'));
    ctx.beginPath();ctx.arc(x,y,size,0,Math.PI*2);ctx.fill();
  }

  // Wide ground glow anchors the fire rather than pasting tiny icons on the ball.
  const ground=ctx.createRadialGradient(target.x,target.y,r*.15,target.x,target.y,r*1.6);
  ground.addColorStop(0,gray?'rgba(180,180,180,.32)':(blue?'rgba(44,90,242,.42)':'rgba(255,88,0,.38)'));ground.addColorStop(1,'rgba(0,0,0,0)');
  ctx.fillStyle=ground;ctx.globalAlpha=.9;ctx.beginPath();ctx.arc(target.x,target.y,r*1.65,0,Math.PI*2);ctx.fill();

  // Large, overlapping flame bodies curl around the target. Their different
  // angles and depths copy the rounded core + flowing tongues of the reference.
  const tongues=[
    [-.92,.56,.64,1.78,-.34],[-.52,.82,.72,2.05,.18],[-.08,.88,.70,2.28,-.16],
    [.39,.82,.68,1.92,.27],[.83,.58,.58,1.62,-.25],[-.72,.05,.50,1.48,.42],[.68,.02,.48,1.42,-.40]
  ];
  tongues.forEach((f,i)=>{
    const sway=Math.sin(now*5.2+i*1.9)*.18;
    ctx.save();ctx.translate(target.x+f[0]*r,target.y+f[1]*r);ctx.rotate(f[4]+sway);
    drawMayhemFlameTongue(ctx,0,0,r*f[2]*intensity,r*(f[3]+.16*Math.sin(now*6+i))*intensity,outer,i%3===0?inner:mid,sway,.80);
    ctx.restore();
  });

  // A molten spiral wraps around the fighter instead of reading as a flat row.
  const ribbonPaths=[
    {w:.54,c:outer,a:.90,off:0},
    {w:.32,c:mid,a:.96,off:.10},
    {w:.13,c:inner,a:.98,off:.20}
  ];
  ribbonPaths.forEach((band,i)=>{
    const wob=Math.sin(now*4.4+i)*r*.10;
    ctx.globalAlpha=band.a;ctx.strokeStyle=band.c;ctx.lineWidth=r*band.w*intensity;
    ctx.lineCap='round';ctx.lineJoin='round';ctx.shadowColor=mid;ctx.shadowBlur=r*(.28-i*.06);
    ctx.beginPath();
    ctx.moveTo(target.x-r*1.12,target.y+r*(.26+band.off));
    ctx.bezierCurveTo(target.x-r*.82,target.y+r*(1.12+band.off),target.x+r*.72,target.y+r*(1.08-band.off),target.x+r*1.08,target.y+r*(.14-band.off));
    ctx.bezierCurveTo(target.x+r*.88,target.y-r*(.48+band.off)+wob,target.x+r*.44,target.y-r*(.78+band.off),target.x+r*.10,target.y-r*(.92+band.off));
    ctx.stroke();
  });
  ctx.shadowBlur=0;

  // Detached side wisps make the silhouette irregular and three-dimensional.
  for(let i=0;i<7;i++){
    const side=i%2?-1:1,q=(now*(.42+.04*i)+i/7)%1;
    const x=target.x+side*r*(.82+q*.78),y=target.y+r*(.34-q*1.82);
    const w=r*(.20+.08*(1-q)),h=r*(.45+.32*(1-q));
    ctx.save();ctx.translate(x,y);ctx.rotate(side*(.46+.20*Math.sin(now*4+i)));
    drawMayhemFlameTongue(ctx,0,0,w,h,outer,i%3===0?inner:mid,side*.25,(1-q)*.78);ctx.restore();
  }

  // Large square embers break away from the main flame wall.
  for(let i=0;i<18;i++){
    const q=(now*(.45+.15*mayhemRand(i))+i/18)%1;
    const x=target.x+(mayhemRand(seed+i*13)-.5)*r*2.25,y=target.y+r*.72-q*r*2.7;
    const size=r*(.045+.075*(1-q));ctx.save();ctx.translate(x,y);ctx.rotate(now*3+i);
    ctx.globalAlpha=(1-q)*.9;ctx.fillStyle=i%4===0?inner:mid;ctx.shadowColor=mid;ctx.shadowBlur=7;ctx.fillRect(-size,-size,size*2,size*2);ctx.restore();
  }
  ctx.restore();
}

