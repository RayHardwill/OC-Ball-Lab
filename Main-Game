function updateArtistBeam(beam,dt){
  beam.life-=dt;if(beam.life<=0){beam.alive=false;return;}
  for(const e of [...balls,...copies]){
    if(!e.alive||e.side===beam.side||!sameRealm(e,beam.owner)) continue;
    const er=e.char.id==='elder_tree'?e.etGrowR:e.r;
