      for(let i=0;i<8;i++){
        const a=i*2.399+now*.35,dist=r*(1.58+.23*Math.sin(now*4+i)),s=r*(.035+.045*(i%3)/2);
        ctx.save();ctx.translate(Math.cos(a)*dist,Math.sin(a)*dist);ctx.rotate(now*4+i);ctx.globalAlpha=.55+.35*Math.sin(now*6+i);
        ctx.fillStyle=i%4===0?'#ffffff':'#9a9a9a';ctx.fillRect(-s,-s,s*2,s*2);ctx.restore();
      }
      ctx.restore();
    }
    if(this.artistForceActive>0){
      const gray=this.artistForceGray>0;
      ctx.beginPath();ctx.arc(this.x,this.y,this.r*2,0,Math.PI*2);ctx.fillStyle=gray?'rgba(210,210,210,.14)':'rgba(255,100,190,.14)';ctx.fill();ctx.strokeStyle=gray?'rgba(235,235,235,.85)':'rgba(255,150,215,.85)';ctx.lineWidth=3;ctx.shadowColor=gray?'#ffffff':'#ff83c8';ctx.shadowBlur=16;ctx.stroke();ctx.shadowBlur=0;
    }
    if(this.artistCopyFlash>0||this.artistCopiedShieldGlow>0){ctx.shadowColor='#ffffff';ctx.shadowBlur=this.artistCopiedShieldGlow>0?38:30;}
    const a=Math.atan2(this.vy,this.vx);
    if(this.artistGrayAbility>0)ctx.filter='grayscale(1)';
    if(this.artistState==='drill_charge'||this.artistState==='drill'||this.artistUltType==='omni_drill'&&this.artistUltPhase==='strike') drawArtistPencil(ctx,this.x,this.y,this.r,a,'drill');
    else if(this.artistState==='swipe_ready'||this.artistState==='swipe'){
      const swing=this.artistState==='swipe'?Math.min(1,this.artistStateTimer/.35)*2.2:0;
      drawArtistPencil(ctx,this.x,this.y,this.r,this.artistAim+Math.PI*2/3-swing,'swipe');
    }
    ctx.filter='none';
    if(this.artistMayhemCharge>0) ctx.filter='grayscale(1) brightness(.82)';
    drawManiacArtistIcon(ctx,this.x,this.y,this.r,isDomainMode()&&domainState?.phase==='active'&&domainState.owner===this);
    ctx.filter='none';
    if(this.artistUltType&&(this.artistUltPhase==='charge'||this.artistUltPhase==='telegraph'||(this.artistUltType==='all_out'&&this.artistUltPhase==='beam'))){
      const intoBeam=this.artistUltType==='all_out';
      const gatherX=this.x+(intoBeam?Math.cos(this.artistAim)*this.r*1.8:0);
      const gatherY=this.y+(intoBeam?Math.sin(this.artistAim)*this.r*1.8:0);
      const pulse=1+.12*Math.sin(Date.now()/70);ctx.beginPath();ctx.arc(gatherX,gatherY,this.r*.62*pulse,0,Math.PI*2);ctx.fillStyle='#ffffff';ctx.shadowColor='#ffffff';ctx.shadowBlur=25;ctx.fill();ctx.shadowBlur=0;
      // Particles gather only while charging. At release the ball remains fixed
      // at the locked firing angle for the beam's full duration.
      if(this.artistUltPhase!=='beam'){
        const now=Date.now()/1000;
        for(let i=0;i<16;i++){
          const phase=(now*1.7+i/16)%1;
          const q=i*2.399+now*.22;
          const radius=this.r*(3.2*(1-phase)+.7);
          const px=gatherX+Math.cos(q)*radius,py=gatherY+Math.sin(q)*radius;
          ctx.globalAlpha=.25+.75*phase;ctx.beginPath();ctx.arc(px,py,1.2+phase*1.7,0,Math.PI*2);ctx.fill();
        }
      }
      ctx.globalAlpha=1;
    }
    ctx.restore();
  }

  drawPlasmaBall(ctx){
