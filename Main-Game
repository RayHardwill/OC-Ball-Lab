      const hit=domainEnemies(owner,true).find(e=>Math.hypot(e.x-star.x,e.y-star.y)<mattRadius(e)+star.r);
      if(hit){mattExplodeStar(star,true);data.stars[i]=mattNewDomainStar(owner,data.stars);}
    }
    if(d.elapsed>=1.5){
      data.teleportClock-=dt;
      while(data.teleportClock<=0){
        data.teleportClock+=.33;
        const candidates=data.stars.filter(s=>s.age>=.55&&s!==data.lastStar);
        if(!candidates.length)break;
        const next=candidates[Math.floor(Math.random()*candidates.length)];
        const x1=owner.x,y1=owner.y,x2=next.x,y2=next.y;
