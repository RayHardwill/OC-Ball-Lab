  ctx.shadowColor=p.artistCopy?'#bdbdbd':'#ff3b00';ctx.shadowBlur=18;
  ctx.beginPath();ctx.arc(0,0,p.r,0,Math.PI*2);ctx.fillStyle=p.artistCopy?'rgba(32,32,32,.88)':'rgba(34,10,5,.88)';ctx.fill();ctx.shadowBlur=0;
