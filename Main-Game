function selectChar(id,card){
  const idx=selected.indexOf(id);
  if(idx>-1){
    selected.splice(idx,1);
    card.classList.remove('selected');
  } else {
    const max=getMode().selectionCount;
    if(selected.length>=max) return;
    selected.push(id);
    card.classList.add('selected');
  }
