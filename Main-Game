function domainRayPath(owner,angle){
  // Reflect each segment from a face of Ray's rotating heptagon.
  let x=owner.x,y=owner.y,vx=Math.cos(angle),vy=Math.sin(angle);
  const path=[{x,y}];
  for(let i=0;i<6;i++){
    const verts=rayHeptagonVertices(8);let distance=Infinity,nx=0,ny=0;
    for(let k=0;k<verts.length;k++){
