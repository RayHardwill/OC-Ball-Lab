function spawnDevourerRockWalls(devourer){
  for(let i=0;i<3;i++){
    let pos=null;
    const size=42;
    for(let tries=0;tries<200;tries++){
      const p=isDomainMode()?domainCirclePoint(devourer.realm||0,size+10):randomArenaPoint(size+10);
      const blocked=[...balls,...copies].some(e=>e.alive&&Math.abs(e.x-p.x)<size/2+e.r&&Math.abs(e.y-p.y)<size/2+e.r);
      if(!blocked){ pos=p; break; }
    }
    if(!pos) continue;
    devourerRockWalls.push({x:pos.x-size/2,y:pos.y-size/2,w:size,h:size,side:devourer.side,owner:devourer,alive:true,id:Math.random()});
    effects.push({type:'ult_flash',x:pos.x,y:pos.y,r:35,color:'#c49a62',t:0,dur:0.3});
  }
}

function updateDevourerRockWalls(){
  for(const wall of devourerRockWalls){
    if(!wall.alive) continue;
    for(const e of [...balls,...copies]){
      if(!e.alive || e.side===wall.side || !sameRealm(e,wall.owner)) continue;
      const eR=e.char.id==='elder_tree'?e.etGrowR:e.r;
      if(e.x+eR>wall.x && e.x-eR<wall.x+wall.w && e.y+eR>wall.y && e.y-eR<wall.y+wall.h){
        wall.alive=false;
        e.takeDamage(15,wall.owner);
        effects.push({type:'punch',x:e.x,y:e.y,t:0,dur:0.3});
        effects.push({type:'ring',x:e.x,y:e.y,r:eR,maxR:eR+35,color:'#c49a62',t:0,dur:0.35});
        break;
      }
    }
  }
  devourerRockWalls=devourerRockWalls.filter(w=>w.alive);
}

