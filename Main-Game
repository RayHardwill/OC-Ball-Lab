  updateArtistUltimate(dt,enemies){
    this.ultProgress=1;this.artistUltPhaseTimer+=dt;
    if(this.artistUltType==='omni_drill'){
      if(this.artistUltPhase==='fade'&&this.artistUltPhaseTimer>=1){this.artistUltPhase='wait';this.artistUltPhaseTimer=0;}
      else if(this.artistUltPhase==='wait'){
        if(this.artistUltPhaseTimer>=1){this.artistUltPhase='telegraph';this.artistUltPhaseTimer=0;}
      }else if(this.artistUltPhase==='telegraph'&&this.artistUltPhaseTimer>=1){
        this.artistUltPhase='strike';this.artistUltPhaseTimer=0;this.x=W/2;this.y=-this.r*2;this.vx=0;this.vy=28;
      }else if(this.artistUltPhase==='strike'){
        const lane=Math.max(95,W*.16);
        if(!this.artistOmniHit){
          this.artistOmniHit=true;
          // Lock in every fighter/copy caught by the center lane. Omni Drill's
          // full 300 damage is delivered as four 75-damage impacts.
          this.artistOmniTargets=[...balls,...copies].filter(e=>e.alive&&e.side!==this.side&&Math.abs(e.x-W/2)<=lane+e.r);
          this.artistOmniBurstsLeft=4;
          this.artistOmniBurstTimer=0;
          for(const e of this.artistOmniTargets) darkKnightStunTimers[e.id]=Math.max(darkKnightStunTimers[e.id]||0,2);
          effects.push({type:'shockwave',x:W/2,y:H/2,r:20,maxR:lane*1.7,color:'#ffffff',t:0,dur:.7,damage:0,side:this.side,owner:this,hit:new Set(),turretHit:new Set()});
        }
        this.artistOmniBurstTimer-=dt;
        if(this.artistOmniBurstsLeft>0&&this.artistOmniBurstTimer<=0){
          for(const e of this.artistOmniTargets) if(e.alive) e.takeDamage(75,this);
          this.artistOmniBurstsLeft--;
          this.artistOmniBurstTimer+=0.2;
        }
        if(this.y>H+this.r||this.artistUltPhaseTimer>=1.2){this.x=W/2;this.y=H/2;this.finishArtistUlt();}
      }
    }else if(this.artistUltType==='all_out'){
      if(this.artistUltPhase==='charge'){
        // During the charge, the energy ball revolves around Maniac Artist and
        // continuously faces the nearest currently-living enemy.
        const nearest=enemies.filter(e=>e.alive).sort((a,b)=>Math.hypot(a.x-this.x,a.y-this.y)-Math.hypot(b.x-this.x,b.y-this.y))[0];
        if(nearest){
          this.artistAim=Math.atan2(nearest.y-this.y,nearest.x-this.x);
          this.artistUltTarget={x:nearest.x,y:nearest.y};
        }
      }
      if(this.artistUltPhase==='charge'&&this.artistUltPhaseTimer>=3){
        this.artistUltPhase='beam';this.artistUltPhaseTimer=0;
        const a=Math.atan2(this.artistUltTarget.y-this.y,this.artistUltTarget.x-this.x),len=Math.hypot(W,H)*1.4;
        // Lock the angle at release; neither the ball nor beam tracks afterward.
        this.artistAim=a;
        artistBeams.push({owner:this,side:this.side,x1:this.x,y1:this.y,x2:this.x+Math.cos(a)*len,y2:this.y+Math.sin(a)*len,width:this.r*8.8,life:4,alive:true,hits:{}});
      }else if(this.artistUltPhase==='beam'&&this.artistUltPhaseTimer>=4)this.finishArtistUlt();
    }else if(this.artistUltType==='expung'&&this.artistUltPhaseTimer>=3&&!this.artistExpungDone){
      this.artistExpungDone=true;
      for(const e of [...balls,...copies])if(e.alive&&e.side!==this.side){e.takeDamage(e.maxHp*.20/(this.damageMultiplier||1),{damageOwner:this,ignoreDefense:true});applyArtistLaunch(e,this,Math.atan2(e.y-this.y,e.x-this.x));}
      // Expung also removes 20% of every enemy Engineer turret's maximum HP.
      for(const t of turrets)if(t.alive&&t.side!==this.side)t.takeDamage(t.maxHp*.20/(this.damageMultiplier||1),{damageOwner:this,ignoreDefense:true});
      effects.push({type:'shockwave',x:this.x,y:this.y,r:this.r,maxR:Math.hypot(W,H),color:'#ff58bd',t:0,dur:.9,damage:0,side:this.side,owner:this,hit:new Set(),turretHit:new Set()});
      this.finishArtistUlt();
    }
  }

  finishArtistUlt(){
    this.artistUltType='';this.artistUltPhase='';this.artistUltPhaseTimer=0;this.artistUltTimer=0;this.ultProgress=0;
    const s=this.getSpeed(),a=Math.random()*Math.PI*2;this.vx=Math.cos(a)*s;this.vy=Math.sin(a)*s;
  }

  // ---- PLASMA UPDATE ----
  updatePlasma(dt,enemies){
    const swordTargets=[...enemies,...turrets.filter(t=>t.alive&&t.side!==this.side)];
    if(swordTargets.length){
      const target=swordTargets.reduce((a,b)=>Math.hypot(a.x-this.x,a.y-this.y)<Math.hypot(b.x-this.x,b.y-this.y)?a:b);
      const wanted=Math.atan2(target.y-this.y,target.x-this.x);
      this.plasmaSwordAngle=turnTowardAngle(this.plasmaSwordAngle,wanted,PLASMA_SWORD_STEER_SPEED*dt);
    }
    for(const key in this.plasmaSwordHits)this.plasmaSwordHits[key]-=dt;
    const seg=getPlasmaSwordSegment(this);
    for(const e of enemies){
      if(!e.alive)continue;const er=e.char.id==='elder_tree'?e.etGrowR:e.r,key=e.id;
      if(pointSegmentDistance(e.x,e.y,seg.x1,seg.y1,seg.x2,seg.y2)<=er+this.r*.30&&(this.plasmaSwordHits[key]||0)<=0){
        this.plasmaSwordHits[key]=PLASMA_SWORD_HIT_COOLDOWN;e.takeDamage(PLASMA_SWORD_DAMAGE,this);
        effects.push({type:'ring',x:e.x,y:e.y,r:er,maxR:er+38,color:'#42fbff',t:0,dur:.3});
      }
    }
    for(const t of turrets){
      if(!t.alive||t.side===this.side)continue;const key='t'+t.id;
      if(pointSegmentDistance(t.x,t.y,seg.x1,seg.y1,seg.x2,seg.y2)<=t.r+this.r*.30&&(this.plasmaSwordHits[key]||0)<=0){
        this.plasmaSwordHits[key]=PLASMA_SWORD_HIT_COOLDOWN;t.takeDamage(PLASMA_SWORD_DAMAGE,this);
      }
    }

    this.plasmaBlinkTimer+=dt;
    if(this.plasmaBlinkTimer>=this.plasmaBlinkInterval){this.plasmaBlinkTimer=0;activatePlasmaBlink(this,enemies);}

    if(!this.plasmaCurrentArmed){
      this.plasmaCurrentTimer+=dt;
      if(this.plasmaCurrentTimer>=this.plasmaCurrentInterval){this.plasmaCurrentTimer=this.plasmaCurrentInterval;this.plasmaCurrentArmed=true;this.plasmaCurrentPoints=[];}
    }

    if(this.plasmaUltActive){
      this.ultProgress=1;
    }else{
      this.plasmaUltTimer+=dt;this.ultProgress=Math.min(1,this.plasmaUltTimer/this.plasmaUltInterval);
      if(this.plasmaUltTimer>=this.plasmaUltInterval){
        this.plasmaUltActive=true;this.plasmaUltDuration=10;this.plasmaUltTickTimer=0;this.ultProgress=1;
        effects.push({type:'ult_flash',x:this.x,y:this.y,r:110,color:'#a24dff',t:0,dur:.8});
        triggerScreenUltFlash('#35105e',.72);
      }
    }
  }

  // ---- EMMY UPDATE ----
  updateEmmy(dt,enemies){
    this.emmyBallAngle -= 0.035; // counterclockwise

    if(this.emmyUltActive){
      // Emmy remains fully mobile during her ultimate.
      this.emmyUltDuration-=dt;
      this.ultProgress=1;
      if(this.emmyUltDuration<=0){
        this.emmyUltActive=false;
        this.emmyUltTimer=0;
        this.ultProgress=0;
        this.emmyThrowTimer=0;
        emmyUltBeams=emmyUltBeams.filter(b=>b.owner!==this);
        const sp=this.getSpeed(),cur=Math.hypot(this.vx,this.vy)||1;
        this.vx=this.vx/cur*sp;this.vy=this.vy/cur*sp;
      }
      return;
    }

    // Orbiting volleyball is an enemy-only melee hitbox.
    if(!this.emmyDisarmed){
      const p=getEmmyWeaponPos(this), wr=getEmmyWeaponRadius(this);
      const targets=[...balls,...copies].filter(e=>e.alive&&e.side!==this.side);
      for(const e of targets){
        const er=e.char.id==='elder_tree'?e.etGrowR:e.r;
        const key=e.id;
        if(Math.hypot(e.x-p.x,e.y-p.y)<er+wr){
          const dx=e.x-p.x,dy=e.y-p.y,dist=Math.hypot(dx,dy)||1;
          const nx=dx/dist,ny=dy/dist;
          const overlap=er+wr-dist;
          e.x+=nx*overlap;e.y+=ny*overlap;
          // Held volleyball is a solid obstacle: enemies always bounce away from it.
          const dot=e.vx*nx+e.vy*ny;
          e.vx-=2*dot*nx;e.vy-=2*dot*ny;
          const spd=e.getSpeed(),cur=Math.hypot(e.vx,e.vy)||1;
          e.vx=e.vx/cur*spd;e.vy=e.vy/cur*spd;
          // Damage/growth keeps its normal per-target cooldown.
          if((this.emmyOrbitHits[key]||0)<=0){
            e.takeDamage(this.emmyBallDamage,this);
            domainCount(this,'volleys',1);
            growEmmyVolley(this);
            this.emmyOrbitHits[key]=0.4;
            effects.push({type:'ring',x:e.x,y:e.y,r:er,maxR:er+25,color:'#ffffff',t:0,dur:0.22});
          }
        }
      }
      turrets.forEach(t=>{
        if(!t.alive||t.side===this.side) return;
        const key='t'+t.id;
        if(Math.hypot(t.x-p.x,t.y-p.y)<t.r+wr){
          const dx=t.x-p.x,dy=t.y-p.y,dist=Math.hypot(dx,dy)||1;
          const nx=dx/dist,ny=dy/dist;
          const overlap=t.r+wr-dist;
          t.x+=nx*overlap;t.y+=ny*overlap;
          // Turrets also bounce off the held volleyball.
          const dot=t.vx*nx+t.vy*ny;
          t.vx-=2*dot*nx;t.vy-=2*dot*ny;
          if(t.getSpeed){
            const spd=t.getSpeed(),cur=Math.hypot(t.vx,t.vy)||1;
            t.vx=t.vx/cur*spd;t.vy=t.vy/cur*spd;
          }
          if((this.emmyOrbitHits[key]||0)<=0){
            t.takeDamage(this.emmyBallDamage,this);
            growEmmyVolley(this);
            this.emmyOrbitHits[key]=0.4;
          }
        }
      });
      for(const k in this.emmyOrbitHits) this.emmyOrbitHits[k]-=dt;
    }

    this.emmyThrowTimer+=dt;
    if(this.emmyThrowTimer>=this.emmyThrowInterval && !this.emmyDisarmed){
      spawnEmmyThrow(this,enemies);
    }

    this.emmyUltTimer+=dt;
    this.ultProgress=Math.min(1,this.emmyUltTimer/this.emmyUltInterval);
    if(this.emmyUltTimer>=this.emmyUltInterval) activateEmmyUlt(this);
  }

  // ---- RAY UPDATE ----
  recordRayPanicDamage(amount){
    if(this.rayGraniteCooldown>0)return;
    this.rayPanicDamage.push({time:this.rayPanicClock,amount});
    this.rayPanicTotal+=amount;
    if(this.rayPanicTotal>=100){
      this.rayPanicDamage=[];
      this.rayPanicTotal=0;
      this.rayGraniteCooldown=25;
      beginRayGraniteCharge(this);
    }
  }

  updateRay(dt, enemies){
    const spd=this.getSpeed();
    const cur=Math.hypot(this.vx,this.vy);
    if(cur>0.01){const f=spd/cur;this.vx*=f;this.vy*=f;}
    else{const a=Math.random()*Math.PI*2;this.vx=Math.cos(a)*spd;this.vy=Math.sin(a)*spd;}

    if(this.isCopy) return;

    this.rayWallTimer += dt;
    if(this.rayWallTimer >= this.rayWallInterval){
      this.rayWallTimer = 0;
      this.rayWallInterval = 6 + Math.random()*2;
      spawnRayWall(this);
    }

    this.rayLaserTimer += dt;
    if(this.rayLaserTimer >= this.rayLaserInterval){
      this.rayLaserTimer = 0;
      this.rayLaserInterval = 12 + Math.random()*2;
      if(enemies.length > 0) spawnRayLasers(this, enemies);
    }

    this.rayUltTimer += dt;
    this.ultProgress = Math.min(1, this.rayUltTimer / this.rayUltInterval);
    if(!this.rayUltActive && this.rayUltTimer >= this.rayUltInterval){
      this.rayUltActive = true;
      this.rayUltDuration = 7;
      activateRayUlt(this);
    }
    if(this.rayUltActive){
      this.rayUltDuration -= dt;
      if(this.rayUltDuration <= 0){
        this.rayUltActive = false;
        this.rayUltTimer = 0;
        this.ultProgress = 0;
        rayUltBeams = rayUltBeams.filter(b=>b.owner!==this);
      }
    }
  }

  // ---- ELDER TREE UPDATE ----
  updateElderTree(dt, enemies){
    if(this.etUltActive){
      this.etUltDuration -= dt;
      // Expand to cover the entire arena — use a large diagonal so no corner is missed
      const fullCover = Math.hypot(W, H);
      this.etUltExpandR = Math.min(fullCover, this.etUltExpandR + dt * (fullCover / 4.5));
      this.vx *= 0.95;
      this.vy *= 0.95;

      if(this.etUltDuration <= 0 && !this.etUltExplosionDone){
        this.etUltExplosionDone = true;
        this.doTreeExplosion(enemies);
        this.etUltActive = false;
        this.etUltTimer = 0;
        this.ultProgress = 0;
        // FIX: Do NOT reset etGrowBonus or etGrowR — Elder Tree keeps all stacks after ult
        this.etUltExpandR = this.etGrowR; // shrink visual back to current grown size
        this.r = this.etGrowR;
      }
      return;
    }

    this.r = this.etGrowR;

    for(let i = spiritOrbs.length - 1; i >= 0; i--){
      const orb = spiritOrbs[i];
      const dist = Math.hypot(this.x - orb.x, this.y - orb.y);
      if(dist < this.etGrowR + orb.r + 5){
        spiritOrbs.splice(i, 1);
        this.etGrowR = Math.min(R * 2.5, this.etGrowR + 3.5);
        this.r = this.etGrowR;
        this.etGrowBonus = Math.min(75, this.etGrowBonus + 6);
        effects.push({type:'ring',x:this.x,y:this.y,r:this.etGrowR,maxR:this.etGrowR+45,color:'#44ff88',t:0,dur:0.55});
        effects.push({type:'ult_flash',x:this.x,y:this.y,r:50,color:'#44ff88',t:0,dur:0.3});
      }
    }

    this.etShockTimer += dt;
    if(this.etShockTimer >= this.etShockInterval){
      this.etShockTimer = 0;
      this.etShockInterval = 10 + Math.random()*5;
      this.doShockwave(enemies);
    }

    this.etUltTimer += dt;
    this.ultProgress = Math.min(1, this.etUltTimer / this.etUltInterval);
    if(this.etUltTimer >= this.etUltInterval){
      this.activateTreeUlt();
    }
  }

  doShockwave(enemies){
    const sizeMult = 1 + (this.etGrowR - R) / R;
    const baseDmg = 45 * sizeMult;
    const maxR = 200 * sizeMult;
    effects.push({type:'shockwave',x:this.x,y:this.y,r:this.etGrowR,maxR:maxR,color:'#33cc55',t:0,dur:0.7,damage:baseDmg,side:this.side,owner:this,hit:new Set(),turretHit:new Set()});
    effects.push({type:'ult_flash',x:this.x,y:this.y,r:this.etGrowR*1.5,color:'#88ffaa',t:0,dur:0.4});
    triggerScreenUltFlash('#002200', 0.35);
