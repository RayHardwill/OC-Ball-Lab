function getEmmyWeaponRadius(emmy){ return R * scaleFor(emmy) * (emmy.emmySizeMult || 1); }
function getEmmyWeaponPos(emmy){
  const orbit = emmy.r + getEmmyWeaponRadius(emmy) + 12;
  return {
    x: emmy.x + Math.cos(emmy.emmyBallAngle)*orbit,
    y: emmy.y + Math.sin(emmy.emmyBallAngle)*orbit
  };
}
function growEmmyVolley(emmy){
  emmy.emmyBallDamage=Math.min(35,emmy.emmyBallDamage+2);
  emmy.emmySizeMult=Math.min(2,emmy.emmySizeMult+0.05);
}

function spawnEmmyThrow(emmy, enemies){
  if(emmy.emmyDisarmed || emmy.emmyUltActive) return;
  emmy.emmyDisarmed=true;
  emmy.emmyThrowTimer=0;
  emmy.emmyOrbitHits={};

  const mainEnemy=balls.find(b=>b.alive&&b.side!==emmy.side&&!b.isCopy&&sameRealm(b,emmy));
  const doSlam = !!mainEnemy && Math.random()<0.33;
  if(doSlam){
    const target=mainEnemy;
    const p=getEmmyWeaponPos(emmy);
    const dx=target.x-p.x, dy=target.y-p.y, d=Math.hypot(dx,dy)||1;
    emmyThrows.push({
      owner:emmy, side:emmy.side, realm:emmy.realm||0, x:p.x,y:p.y,
      vx:dx/d*17, vy:dy/d*17,
      r:getEmmyWeaponRadius(emmy), angle:emmy.emmyBallAngle,
      spin:0.28, bounces:0, maxBounces:1, alive:true,
      slam:true, target, damage:70, hitIds:new Set()
    });
  } else {
    const p=getEmmyWeaponPos(emmy);
    const a=Math.random()*Math.PI*2;
    emmyThrows.push({
      owner:emmy, side:emmy.side, realm:emmy.realm||0, x:p.x,y:p.y,
      vx:Math.cos(a)*18, vy:Math.sin(a)*18,
      r:getEmmyWeaponRadius(emmy), angle:emmy.emmyBallAngle,
      spin:0.3, bounces:0, maxBounces:30, alive:true,
      slam:false, target:null, damage:emmy.emmyBallDamage, hitIds:new Set(), hitCooldowns:{}, wallCooldowns:{}, swordCooldowns:{},
      lastEnemyPositions:{}
    });
  }
}

function retrieveEmmyBall(proj){
  if(proj.owner && proj.owner.alive){
    proj.owner.emmyDisarmed=false;
    proj.owner.emmyThrowTimer=0;
    proj.owner.emmyOrbitHits={};
  }
  proj.alive=false;
}


function emmyThrowHitDarkKnightSword(p,knight){
  const swordAngle=knight.angle+knight.dkSwordAngle;
  const swordHitRadius=knight.r*0.235+2;
  const sx=knight.x+Math.cos(swordAngle)*(knight.r*1.62+knight.r*0.08);
  const sy=knight.y+Math.sin(swordAngle)*(knight.r*1.62+knight.r*0.08);
  const ex=knight.x+Math.cos(swordAngle)*knight.r*5.5;
  const ey=knight.y+Math.sin(swordAngle)*knight.r*5.5;
  const dx=ex-sx,dy=ey-sy,lenSq=dx*dx+dy*dy||1;
  const wx=p.x-sx,wy=p.y-sy;
  const t=Math.max(0,Math.min(1,(wx*dx+wy*dy)/lenSq));
  const px=sx+dx*t,py=sy+dy*t;
  if(Math.hypot(p.x-px,p.y-py)>p.r+swordHitRadius) return false;
  const len=Math.hypot(dx,dy)||1;
  const nx=dx/len,ny=dy/len;
  const dot=p.vx*nx+p.vy*ny;
  if(dot>0){ p.vx-=2*dot*nx; p.vy-=2*dot*ny; }
  const pushX=p.x-px,pushY=p.y-py,pushD=Math.hypot(pushX,pushY)||1;
  const pushR=p.r+swordHitRadius+1;
  p.x=px+pushX/pushD*pushR;
  p.y=py+pushY/pushD*pushR;
  p.bounces++;
  effects.push({type:'ring',x:p.x,y:p.y,r:p.r,maxR:p.r+32,color:'#ffffff',t:0,dur:0.25});
  effects.push({type:'ult_flash',x:p.x,y:p.y,r:30,color:'#d6b45a',t:0,dur:0.18});
  return true;
}

function updateEmmyThrow(p,dt){
  if(!p.alive || !p.owner || !p.owner.alive){ p.alive=false; return; }
  p.angle += p.spin;
  if(p.volleyReturnCooldown) p.volleyReturnCooldown=Math.max(0,p.volleyReturnCooldown-dt);

  if(p.slam && (!p.target || !p.target.alive || !sameRealm(p,p.target))){ retrieveEmmyBall(p); return; }
  if(p.slam && p.target && p.target.alive){
    // Home hard toward the chosen enemy so the downslam reliably connects.
    const dx=p.target.x-p.x, dy=p.target.y-p.y, d=Math.hypot(dx,dy)||1;
    p.vx=dx/d*19; p.vy=dy/d*19;
  }
  p.x+=p.vx; p.y+=p.vy;

  let wallBounce=false;
  if(isDomainMode()){
    wallBounce=bouncePointOffArena(p,p.r);
  }else if(isHexArena()){
    wallBounce=bouncePointOffArena(p,p.r);
  }else{
    if(p.x-p.r<0){p.x=p.r;p.vx=Math.abs(p.vx);wallBounce=true;}
    if(p.x+p.r>W){p.x=W-p.r;p.vx=-Math.abs(p.vx);wallBounce=true;}
    if(p.y-p.r<0){p.y=p.r;p.vy=Math.abs(p.vy);wallBounce=true;}
    if(p.y+p.r>H){p.y=H-p.r;p.vy=-Math.abs(p.vy);wallBounce=true;}
  }
  if(wallBounce && !p.slam) p.bounces++;

  // Thrown volleyballs also bounce off Ray's walls.
  if(!p.slam){
    for(const wall of rayWalls){
      if(wall.side===p.side||!sameRealm(wall,p)) continue;
      if(!bounceOffRayWall(p,wall,p.r)) continue;
      p.bounces++;
      effects.push({type:'ring',x:p.x,y:p.y,r:p.r,maxR:p.r+28,color:wall.color,t:0,dur:0.25});
      break;
    }
  }

  // If the thrown volleyball reaches Emmy, volley it back toward the nearest enemy's
  // most recently recorded position instead of simply retrieving it.
  if(!p.slam && !p.artistCopy){
    const emmy=p.owner;
    const emmyDist=Math.hypot(p.x-emmy.x,p.y-emmy.y);
    const emmyHitRadius=p.r+emmy.r;
    // Ignore the instant it is launched from Emmy's hands.
    if(emmyDist<=emmyHitRadius && (p.volleyReturnCooldown||0)<=0 && Math.hypot(p.vx,p.vy)>0){
      let nearest=null, nearestD=Infinity;
      const candidates=[...balls,...copies].filter(e=>e.alive&&e.side!==p.side&&sameRealm(e,p.owner));
      for(const e of candidates){
        const d=Math.hypot(e.x-emmy.x,e.y-emmy.y);
        if(d<nearestD){ nearest=e; nearestD=d; }
      }
      if(nearest){
        const saved=p.lastEnemyPositions[nearest.id]||{x:nearest.x,y:nearest.y};
        const dx=saved.x-emmy.x,dy=saved.y-emmy.y,d=Math.hypot(dx,dy)||1;
        p.x=emmy.x+dx/d*emmyHitRadius;
        p.y=emmy.y+dy/d*emmyHitRadius;
        p.vx=dx/d*18;
        p.vy=dy/d*18;
        p.volleyReturnCooldown=0.18;
        effects.push({type:'ring',x:emmy.x,y:emmy.y,r:emmy.r,maxR:emmy.r+28,color:'#ffffff',t:0,dur:0.25});
      }
    }
  }

  // Remember enemy positions so an Emmy return can aim at where the target was.
  if(!p.slam){
    p.lastEnemyPositions=p.lastEnemyPositions||{};
    for(const e of [...balls,...copies]){
      if(e.alive&&e.side!==p.side&&sameRealm(e,p)) p.lastEnemyPositions[e.id]={x:e.x,y:e.y};
    }
  }

  const enemyBalls=p.slam ? [p.target].filter(e=>e&&e.alive&&sameRealm(e,p)) : [...balls,...copies].filter(e=>e.alive&&e.side!==p.side&&sameRealm(e,p));
  for(const e of enemyBalls){
    const er=e.char.id==='elder_tree'?e.etGrowR:e.r;
    if(Math.hypot(e.x-p.x,e.y-p.y)>er+p.r) continue;
    if(p.slam){
      if(p.hitIds.has(e.id)) continue;
      p.hitIds.add(e.id);
      e.takeDamage(70,p.owner);
      if(!p.artistCopy) domainCount(p.owner,'volleys',1);
      e.damageDebuff=Math.min(0.25,(e.damageDebuff||0)+0.05);
      effects.push({type:'shockwave',owner:p.owner,realm:p.realm,x:e.x,y:e.y,r:10,maxR:120,color:'#fff5a0',t:0,dur:0.45,damage:0,side:p.side,hit:new Set([e.id]),turretHit:new Set()});
      // The slam shockwave explicitly clears nearby summons/turrets.
      copies.forEach(c=>{ if(c.alive&&c.side!==p.side&&sameRealm(c,p)&&Math.hypot(c.x-e.x,c.y-e.y)<120){ c.takeDamage(70,p.owner); } });
      turrets.forEach(t=>{ if(t.alive&&t.side!==p.side&&sameRealm(t,p)&&Math.hypot(t.x-e.x,t.y-e.y)<120+t.r){ t.takeDamage(70,p.owner); } });
      effects.push({type:'ring',x:e.x,y:e.y,r:er,maxR:er+85,color:'#fff5a0',t:0,dur:0.45});
      retrieveEmmyBall(p);
      return;
    }

    const key=e.id;
    if((p.hitCooldowns[key]||0)>0) continue;
    p.hitCooldowns[key]=0.28;
    e.takeDamage(p.damage,p.owner);
    if(!p.artistCopy) domainCount(p.owner,'volleys',1);
    if(!p.artistCopy){growEmmyVolley(p.owner);p.damage=p.owner.emmyBallDamage;p.r=getEmmyWeaponRadius(p.owner);}
    p.bounces++;
    // reflect away from enemy center
    const nx=(p.x-e.x)/(Math.hypot(p.x-e.x,p.y-e.y)||1), ny=(p.y-e.y)/(Math.hypot(p.x-e.x,p.y-e.y)||1);
    const dot=p.vx*nx+p.vy*ny;
    p.vx-=2*dot*nx; p.vy-=2*dot*ny;
    break;
  }

  if(!p.slam){
    for(const t of turrets){
      if(!t.alive||t.side===p.side||!sameRealm(t,p)) continue;
      const key='t'+t.id;
      if(Math.hypot(t.x-p.x,t.y-p.y)<t.r+p.r && (p.hitCooldowns[key]||0)<=0){
        p.hitCooldowns[key]=0.28;
        t.takeDamage(p.damage,p.owner);
        if(!p.artistCopy){growEmmyVolley(p.owner);p.damage=p.owner.emmyBallDamage;p.r=getEmmyWeaponRadius(p.owner);}
        p.bounces++;
        const nx=(p.x-t.x)/(Math.hypot(p.x-t.x,p.y-t.y)||1), ny=(p.y-t.y)/(Math.hypot(p.x-t.x,p.y-t.y)||1);
        const dot=p.vx*nx+p.vy*ny; p.vx-=2*dot*nx; p.vy-=2*dot*ny;
        break;
      }
    }
  }

  if(!p.slam){
    // Dark Knight's sword is a physical obstacle for the thrown volleyball.
    for(const knight of balls){
      if(!knight.alive || knight.char.id!=='dark_knight' || knight.side===p.side || knight.dkUltActive || !sameRealm(knight,p)) continue;
      const swordKey='s'+knight.id;
      if((p.swordCooldowns?.[swordKey]||0)>0) continue;
      if(emmyThrowHitDarkKnightSword(p,knight)){
        p.swordCooldowns=p.swordCooldowns||{};
        p.swordCooldowns[swordKey]=0.2;
        break;
      }
    }
  }

  if(p.hitCooldowns) for(const k in p.hitCooldowns) p.hitCooldowns[k]-=dt;
  if(p.swordCooldowns) for(const k in p.swordCooldowns) p.swordCooldowns[k]-=dt;
  if(!p.slam && p.bounces>=p.maxBounces) retrieveEmmyBall(p);
}

function drawEmmyThrow(ctx,p){
  if(!p.alive) return;
  if(p.artistCopy){ctx.save();ctx.globalAlpha=.82;drawVolleyball(ctx,p.x,p.y,p.r,p.angle,true);ctx.globalCompositeOperation='source-atop';ctx.fillStyle='rgba(25,25,30,.48)';ctx.beginPath();ctx.arc(p.x,p.y,p.r,0,Math.PI*2);ctx.fill();ctx.restore();}
  else drawVolleyball(ctx,p.x,p.y,p.r,p.angle,true);
}

function activateEmmyUlt(emmy){
