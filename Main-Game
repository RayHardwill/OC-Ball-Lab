// ---- RAY WALL ----
const RAY_WALL_COLORS = ['#ff4466','#ffaa00','#00ffee','#aa44ff','#44ff88','#ff88ff','#ffff44','#ff6600'];
function rayWallVertices(w){
  if(w.shape==='circle')return null;
  const cx=w.x+w.w/2,cy=w.y+w.h/2;
  if(w.shape==='pentagon')return Array.from({length:5},(_,i)=>({x:cx+Math.cos(-Math.PI/2+i*Math.PI*2/5)*w.w/2,y:cy+Math.sin(-Math.PI/2+i*Math.PI*2/5)*w.h/2}));
  return [{x:w.x,y:w.y},{x:w.x+w.w,y:w.y},{x:w.x+w.w,y:w.y+w.h},{x:w.x,y:w.y+w.h}];
}
function rayWallCollision(obj,wall,r=obj.r||0){
  const cx=wall.x+wall.w/2,cy=wall.y+wall.h/2;
  if(wall.shape==='circle'){
    const dx=obj.x-cx,dy=obj.y-cy,d=Math.hypot(dx,dy),overlap=wall.w/2+r-d;
    return overlap>0?{nx:dx/(d||1),ny:dy/(d||1),depth:overlap}:null;
  }
  if(obj.x+r<wall.x||obj.x-r>wall.x+wall.w||obj.y+r<wall.y||obj.y-r>wall.y+wall.h)return null;
  const vertices=rayWallVertices(wall);let inside=true,nearest=null,best=Infinity;
  for(let i=0;i<vertices.length;i++){
    const a=vertices[i],b=vertices[(i+1)%vertices.length],ex=b.x-a.x,ey=b.y-a.y;
    if(ex*(obj.y-a.y)-ey*(obj.x-a.x)<0)inside=false;
    const t=Math.max(0,Math.min(1,((obj.x-a.x)*ex+(obj.y-a.y)*ey)/(ex*ex+ey*ey)));
    const dx=obj.x-(a.x+ex*t),dy=obj.y-(a.y+ey*t),dist=Math.hypot(dx,dy);
    if(dist<best){best=dist;nearest={dx,dy,ex,ey};}
  }
  if(!inside&&best>=r)return null;
  const len=best||Math.hypot(nearest.ex,nearest.ey)||1;
  return inside?{nx:-nearest.dx/len||nearest.ey/len,ny:-nearest.dy/len||-nearest.ex/len,depth:r+best}:{nx:nearest.dx/len,ny:nearest.dy/len,depth:r-best};
}
function bounceOffRayWall(obj,wall,r=obj.r||0){
  const hit=rayWallCollision(obj,wall,r);if(!hit)return false;
  obj.x+=hit.nx*hit.depth;obj.y+=hit.ny*hit.depth;
  const dot=(obj.vx||0)*hit.nx+(obj.vy||0)*hit.ny;
  if(dot<0){obj.vx-=2*dot*hit.nx;obj.vy-=2*dot*hit.ny;}
  return true;
}
function spawnRayWall(ray){
  const attackScale=scaleFor(ray);
  const shape=['rectangle','rectangle','square','pentagon','circle'][Math.floor(Math.random()*5)];
  const ww = (shape==='rectangle'?115+Math.random()*105:65+Math.random()*105)*attackScale;
  const wh = (shape==='rectangle'?20+Math.random()*18:ww/attackScale)*attackScale;
  const isVertical = Math.random() < 0.5;
  const actualW = shape==='rectangle'&&isVertical ? wh : ww;
  const actualH = shape==='rectangle'&&isVertical ? ww : wh;
  const wallCenter=isDomainMode()?domainCirclePoint(ray.realm||0,Math.max(actualW,actualH)+25):randomArenaPoint(Math.max(actualW,actualH)+25);
  const wx = wallCenter.x-actualW/2;
  const wy = wallCenter.y-actualH/2;
  const artistCopy=ray.char?.id==='maniac_artist';
  const col = artistCopy?'#9a9a9a':RAY_WALL_COLORS[Math.floor(Math.random()*RAY_WALL_COLORS.length)];
  rayWalls.push({
    x: wx, y: wy, w: actualW, h: actualH,shape,realm:ray.realm||0,
    color: col,
    side: ray.side,
    life: 0,
    dur: 4 + Math.random()*2,
    id: Math.random(), artistCopy, owner:ray
  });
  effects.push({type:'ult_flash',x:wx+actualW/2,y:wy+actualH/2,r:80,color:col,t:0,dur:0.4});
  triggerScreenUltFlash('#110022', 0.3);
}

function drawRayWall(ctx, wall){
  const frac = wall.life / wall.dur;
  const alpha = frac < 0.1 ? frac/0.1 : (frac > 0.8 ? (1-frac)/0.2 : 1);
  ctx.save();
  ctx.globalAlpha = alpha;
  ctx.shadowColor = wall.color;
  ctx.shadowBlur = 18;
  ctx.fillStyle = wall.color + '33';
  ctx.beginPath();
  if(wall.shape==='circle')ctx.arc(wall.x+wall.w/2,wall.y+wall.h/2,wall.w/2,0,Math.PI*2);
  else rayWallVertices(wall).forEach((p,i)=>i?ctx.lineTo(p.x,p.y):ctx.moveTo(p.x,p.y));
  ctx.closePath();ctx.fill();
  ctx.strokeStyle = wall.color;
  ctx.lineWidth = 3;
  ctx.stroke();ctx.fillStyle=wall.color+'88';ctx.fill();
  ctx.globalAlpha*=.8;ctx.strokeStyle='#ffffff';ctx.lineWidth=1;
  ctx.stroke();
  ctx.restore();
}

// ---- ABILITY DAMAGE TO TURRETS ----
function damageTurretsInRadius(x, y, radius, damage, side, color='#ffffff', source=null){
  turrets.forEach(t=>{
    if(!t.alive || t.side===side || (source&&!sameRealm(t,source))) return;
    if(Math.hypot(t.x-x,t.y-y) <= radius+t.r){
      t.takeDamage(damage,source);
      effects.push({type:'ring',x:t.x,y:t.y,r:t.r,maxR:t.r+30,color,t:0,dur:0.3});
    }
  });
}

