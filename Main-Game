function turnTowardAngle(current,target,maxStep){
  let diff=(target-current+Math.PI)%(Math.PI*2)-Math.PI;
  if(diff<-Math.PI) diff+=Math.PI*2;
  return current+Math.max(-maxStep,Math.min(maxStep,diff));
}

function drawPlasmaIcon(ctx,x,y,r,ultActive=false){
  ctx.save();ctx.translate(x,y);

  // Ultimate preview glow.
  if(ultActive){
    ctx.save();ctx.shadowColor='#a33cff';ctx.shadowBlur=r*.55;
    ctx.fillStyle='rgba(153,54,255,.22)';
    ctx.beginPath();ctx.arc(0,0,r*1.18,0,Math.PI*2);ctx.fill();
    ctx.restore();
  }

  // Face.
  ctx.beginPath();ctx.arc(0,0,r,0,Math.PI*2);
  ctx.fillStyle='#FAE9D9';ctx.fill();
  ctx.strokeStyle='#24182b';ctx.lineWidth=Math.max(1.5,r*.065);ctx.stroke();

  // Both side-hair pieces share one mirrored shape.
  ctx.fillStyle='#8F47ED';ctx.strokeStyle='#3f1268';
  ctx.lineWidth=Math.max(1,r*.045);ctx.lineJoin='round';
  for(const side of [-1,1]){
    ctx.save();ctx.scale(side,1);ctx.beginPath();
    ctx.moveTo(r*1.02,-r*.42);
    ctx.quadraticCurveTo(r*1.38,r*.15,r*1.88,r*.02);
    ctx.quadraticCurveTo(r*1.15,r*.3,r*1.03,r*.18);
    ctx.quadraticCurveTo(r*1.15,r*.65,r*1.38,r*.52);
    ctx.quadraticCurveTo(r*1.05,r*.6,r*.9,r*.48);
    ctx.quadraticCurveTo(r*.77,r*.65,r*.55,r*.7);
    ctx.quadraticCurveTo(r*.97,r*.1,r*.85,0);
    ctx.quadraticCurveTo(r*.7,-r*.1,r*(side<0?.4:.2),-r*.43);
    ctx.closePath();ctx.fill();ctx.stroke();ctx.restore();
  }

  // Smile.
  ctx.fillStyle='#fff';ctx.strokeStyle='#562d38';ctx.lineWidth=Math.max(1.2,r*.05);
  ctx.beginPath();ctx.moveTo(-r*.42,r*.5);
  ctx.quadraticCurveTo(0,r*1.01,r*.42,r*.5);
  ctx.quadraticCurveTo(0,r*.62,-r*.42,r*.5);
  ctx.closePath();ctx.fill();ctx.stroke();

  // Shades.
  const shades=ctx.createLinearGradient(-r*.78,0,r*.78,0);
  shades.addColorStop(0,'#1fdcff');shades.addColorStop(1,'#9b37ff');
  ctx.fillStyle=shades;ctx.strokeStyle='#17111f';ctx.lineWidth=Math.max(2,r*.05);
  ctx.beginPath();ctx.moveTo(-r*.96,-r*.17);ctx.lineTo(-r*.1,-r*.1);
  ctx.lineTo(r*.1,-r*.1);ctx.lineTo(r*.96,-r*.17);ctx.lineTo(r*.78,r*.23);
  ctx.quadraticCurveTo(r*.48,r*.49,r*.14,r*.25);ctx.lineTo(-r*.14,r*.25);
  ctx.quadraticCurveTo(-r*.48,r*.49,-r*.78,r*.23);
  ctx.closePath();ctx.fill();ctx.stroke();

  // Reflections.
  ctx.globalAlpha=.55;ctx.strokeStyle='#ffffff';ctx.lineWidth=Math.max(1,r*.08);
  ctx.beginPath();ctx.moveTo(-r*.68,-r*.12);ctx.lineTo(-r*.40,r*.34);ctx.moveTo(r*.24,-r*.1);ctx.lineTo(r*.50,r*.34);ctx.stroke();
  ctx.globalAlpha=1;

  // Front bang.
  ctx.fillStyle='#8F47ED';ctx.strokeStyle='#3f1268';ctx.lineWidth=Math.max(1,r*.045);
  ctx.beginPath();ctx.moveTo(-r*.30,-r*.88);
  ctx.quadraticCurveTo(r*.20,-r*.62,r*.02,r*.08);
  ctx.quadraticCurveTo(-r*.30,-r*.12,-r*.48,-r*.63);
  ctx.closePath();ctx.fill();ctx.stroke();

  // Hat crown and half-circle brim.
  ctx.fillStyle='#0a0810';ctx.strokeStyle='#2f2238';ctx.lineWidth=Math.max(1.5,r*.05);
  ctx.beginPath();ctx.moveTo(-r*.9,-r*.42);ctx.lineTo(-r*1.1,-r*1.18);
  ctx.quadraticCurveTo(0,-r*1.56,r*1.1,-r*1.18);ctx.lineTo(r*.9,-r*.42);
  ctx.closePath();ctx.fill();ctx.stroke();
  ctx.beginPath();ctx.moveTo(-r*1.08,-r*.4);
  ctx.ellipse(0,-r*.4,r*1.08,r*.3,0,Math.PI,Math.PI*2);
  ctx.closePath();ctx.fill();ctx.stroke();

  // Gold hat metals.
  ctx.fillStyle='#d9ab36';ctx.strokeStyle='#6f4c12';ctx.lineWidth=Math.max(1,r*.035);
  for(const metalX of [-r*.22,r*.22]){
    ctx.beginPath();ctx.arc(metalX,-r*.83,r*.1,0,Math.PI*2);ctx.fill();ctx.stroke();
  }

  ctx.restore();
}


function getPlasmaSwordSegment(plasma){
  const a=plasma.plasmaSwordAngle,start=plasma.r*.88,end=plasma.r*3.45;
  return {x1:plasma.x+Math.cos(a)*start,y1:plasma.y+Math.sin(a)*start,x2:plasma.x+Math.cos(a)*end,y2:plasma.y+Math.sin(a)*end};
}

function drawPlasmaSword(ctx,angle,r){
  ctx.save();ctx.rotate(angle);ctx.lineJoin=ctx.lineCap='round';

  // Main measurements.
  const handleStart=r*.78,bladeBaseX=r*1.34,bladeTipX=r*3.72;
  const bladeHalfWidth=r*.35; // CHANGE THIS: lower = thinner, higher = wider.
  const holeX=r*1.98,holeRadius=r*.2,slitHalfWidth=r*.045;
  const slitTipX=bladeTipX-r*.17;
  const joinX=holeX+Math.sqrt(holeRadius**2-slitHalfWidth**2);
  const joinAngle=Math.asin(slitHalfWidth/holeRadius);

  // Reusable paths keep the sword code short.
  const bladePath=()=>{
    ctx.moveTo(bladeBaseX,-bladeHalfWidth);ctx.lineTo(bladeTipX,0);
    ctx.lineTo(bladeBaseX,bladeHalfWidth);ctx.closePath();
  };
  const gapPath=()=>{
    ctx.moveTo(slitTipX,-slitHalfWidth);ctx.lineTo(joinX,-slitHalfWidth);
    ctx.arc(holeX,0,holeRadius,-joinAngle,joinAngle,true);
    ctx.lineTo(slitTipX,slitHalfWidth);ctx.closePath();
  };

  // Handle and pommel.
  ctx.fillStyle='#11151d';ctx.strokeStyle='#d8ad3d';ctx.lineWidth=Math.max(1.5,r*.055);
  ctx.beginPath();ctx.roundRect(handleStart,-r*.105,bladeBaseX-handleStart,r*.21,r*.07);
  ctx.fill();ctx.stroke();
  ctx.beginPath();ctx.arc(handleStart,0,r*.105,0,Math.PI*2);
  ctx.fillStyle='#e3ba45';ctx.fill();ctx.strokeStyle='#765316';ctx.stroke();

  // Glowing triangular blade with a transparent keyhole gap.
  const bladeGradient=ctx.createLinearGradient(bladeBaseX,0,bladeTipX,0);
  bladeGradient.addColorStop(0,'#00a9bd');bladeGradient.addColorStop(.48,'#39f7ff');
  bladeGradient.addColorStop(1,'#dfffff');
  ctx.save();ctx.shadowColor='#21f4ff';ctx.shadowBlur=r*.26;ctx.fillStyle=bladeGradient;
  ctx.beginPath();bladePath();gapPath();ctx.fill('evenodd');ctx.restore();

  // Blade and gap outlines.
  ctx.beginPath();bladePath();ctx.strokeStyle='#dfffff';ctx.lineWidth=Math.max(2,r*.065);
  ctx.shadowColor='#24efff';ctx.shadowBlur=r*.12;ctx.stroke();
  ctx.beginPath();gapPath();ctx.strokeStyle='#f3ffff';ctx.lineWidth=Math.max(1.2,r*.035);ctx.stroke();

  // Flat base / guard.
  ctx.shadowBlur=0;
  const guardX=bladeBaseX-r*.035;
  const guard=(color,width,pad)=>{
    ctx.strokeStyle=color;ctx.lineWidth=width;ctx.beginPath();
    ctx.moveTo(guardX,-bladeHalfWidth-pad);ctx.lineTo(guardX,bladeHalfWidth+pad);ctx.stroke();
  };
  guard('#172635',r*.15,r*.06);guard('#e2b84a',r*.055,r*.05);

  ctx.restore();
}

function choosePlasmaBlinkPoint(plasma,enemies){
  const margin=plasma.r+8;
  const live=enemies.filter(e=>e.alive&&sameRealm(e,plasma));
  if(live.length){
    // "Behind" continues the line from Plasma's old position through the
    // nearest enemy, then lands beyond that enemy with a safe body gap.
    const enemy=live.reduce((a,b)=>Math.hypot(a.x-plasma.x,a.y-plasma.y)<Math.hypot(b.x-plasma.x,b.y-plasma.y)?a:b);
    const dx=enemy.x-plasma.x,dy=enemy.y-plasma.y,dist=Math.hypot(dx,dy)||1;
    const enemyR=enemy.char?.id==='elder_tree'?enemy.etGrowR:(enemy.r||R);
    const behind=enemyR+plasma.r+22;
    const p={x:enemy.x+dx/dist*behind,y:enemy.y+dy/dist*behind};
    let valid;
    if(isDomainMode()){const c=circleFor(plasma);valid=Math.hypot(p.x-c.x,p.y-c.y)+margin<DOMAIN_RADIUS;}
    else if(!isHexArena())valid=p.x>=margin&&p.x<=W-margin&&p.y>=margin&&p.y<=H-margin;
    else{
      const probe={x:p.x,y:p.y};keepPointInArena(probe,margin);
      valid=Math.hypot(probe.x-p.x,probe.y-p.y)<.01;
    }
    if(valid)return p;
  }
  // If the true behind-enemy point would leave the arena, use a completely
  // random safe point rather than squeezing Plasma against the boundary.
  return isDomainMode()?domainCirclePoint(plasma.realm||0,margin):randomArenaPoint(margin);
}

function activatePlasmaBlink(plasma,enemies){
  const from={x:plasma.x,y:plasma.y},to=choosePlasmaBlinkPoint(plasma,enemies);
  const artistCopy=plasma.char?.id==='maniac_artist';
  const blinkColor=artistCopy?'#d8d8d8':'#39f7ff';
  const arrivalColor=artistCopy?'#888888':'#9b47ff';
  for(const e of [...balls,...copies]){
    if(!e.alive||e.side===plasma.side||!sameRealm(e,plasma))continue;
    const er=e.char.id==='elder_tree'?e.etGrowR:e.r;
    if(pointSegmentDistance(e.x,e.y,from.x,from.y,to.x,to.y)<=er+12)e.takeDamage(50,plasma);
  }
  for(const t of turrets)if(t.alive&&t.side!==plasma.side&&sameRealm(t,plasma)&&pointSegmentDistance(t.x,t.y,from.x,from.y,to.x,to.y)<=t.r+12)t.takeDamage(50,plasma);
  // Blink uses one clean beam-like line. Its width is one radius, which is
  // half of a normal character's full diameter.
  abilityTrails.push({points:[from,to],realm:plasma.realm||0,t:0,dur:1.05,color:blinkColor,lineWidth:plasma.r});
  effects.push({type:'ring',x:from.x,y:from.y,r:plasma.r,maxR:plasma.r+55,color:blinkColor,t:0,dur:.45});
  plasma.x=to.x;plasma.y=to.y;
  effects.push({type:'ring',x:to.x,y:to.y,r:plasma.r,maxR:plasma.r+65,color:arrivalColor,t:0,dur:.5});
}

function registerPlasmaWallPoint(plasma){
  if(!plasma.plasmaCurrentArmed)return;
  const artistCopy=plasma.char?.id==='maniac_artist';
  const anchorColor=artistCopy?'#d8d8d8':'#39f7ff';
  plasma.plasmaCurrentPoints.push({x:plasma.x,y:plasma.y});
  effects.push({type:'ring',x:plasma.x,y:plasma.y,r:8,maxR:34,color:anchorColor,t:0,dur:.4});
  if(plasma.plasmaCurrentPoints.length>=2){
    plasmaCurrents.push({owner:plasma,side:plasma.side,a:plasma.plasmaCurrentPoints[0],b:plasma.plasmaCurrentPoints[1],life:8,hits:{},alive:true,artistCopy});
    plasma.plasmaCurrentPoints=[];plasma.plasmaCurrentArmed=false;plasma.plasmaCurrentTimer=0;
  }
}

function updatePlasmaFields(dt){
  const targets=[...balls,...copies].filter(b=>b.alive);
  targets.forEach(b=>{b.plasmaSlowed=false;b.plasmaCurrentSlowed=false;b.plasmaUltSlowed=false;b.plasmaChargePaused=false;});
  for(const line of plasmaCurrents){
    line.life-=dt;if(line.life<=0){line.alive=false;continue;}
    for(const e of targets){
      if(e.side===line.side||!sameRealm(e,line.owner))continue;
      const er=e.char.id==='elder_tree'?e.etGrowR:e.r,key=e.id;
      if(pointSegmentDistance(e.x,e.y,line.a.x,line.a.y,line.b.x,line.b.y)<=er+9){
        e.plasmaSlowed=true;e.plasmaCurrentSlowed=true;line.hits[key]=(line.hits[key]||0)-dt;
        if(line.hits[key]<=0){line.hits[key]=PLASMA_CURRENT_TICK;const before=e.hp;e.takeDamage(PLASMA_CURRENT_DAMAGE,line.owner);if(line.owner.char?.id==='plasma')domainCount(line.owner,'electrocution',Math.max(0,before-e.hp));}
      }
    }
    for(const t of turrets){
      if(!t.alive||t.side===line.side||!sameRealm(t,line.owner))continue;const key='t'+t.id;
      if(pointSegmentDistance(t.x,t.y,line.a.x,line.a.y,line.b.x,line.b.y)<=t.r+9){line.hits[key]=(line.hits[key]||0)-dt;if(line.hits[key]<=0){line.hits[key]=PLASMA_CURRENT_TICK;const before=t.hp;t.takeDamage(PLASMA_CURRENT_DAMAGE,line.owner);if(line.owner.char?.id==='plasma')domainCount(line.owner,'electrocution',Math.max(0,before-t.hp));}}
    }
  }
  plasmaCurrents=plasmaCurrents.filter(l=>l.alive);
  const active=[...balls,...copies].filter(b=>b.alive&&b.char.id==='plasma'&&b.plasmaUltActive);
  for(const plasma of active){
    const victims=targets.filter(e=>e.side!==plasma.side&&sameRealm(e,plasma));
    victims.forEach(e=>{e.plasmaSlowed=true;e.plasmaUltSlowed=true;e.plasmaChargePaused=true;});
    plasma.plasmaUltTickTimer-=dt;
    if(plasma.plasmaUltTickTimer<=0){
      plasma.plasmaUltTickTimer+=PLASMA_ULT_TICK;
      victims.forEach(e=>e.takeDamage(PLASMA_ULT_DAMAGE,plasma));
      turrets.forEach(t=>{if(t.alive&&t.side!==plasma.side&&sameRealm(t,plasma))t.takeDamage(PLASMA_ULT_DAMAGE,plasma);});
    }
    // Duration advances globally so opposing Plasma ultimates cannot pause one
    // another forever when both voltage webs are active.
    plasma.plasmaUltDuration-=dt;
    if(plasma.plasmaUltDuration<=0){
      plasma.plasmaUltActive=false;plasma.plasmaUltTimer=0;plasma.plasmaUltDuration=0;plasma.plasmaUltTickTimer=0;plasma.ultProgress=0;
      effects.push({type:'ring',x:plasma.x,y:plasma.y,r:plasma.r,maxR:plasma.r+100,color:'#9c50ff',t:0,dur:.55});
    }
  }
}

function electricNoise(n){
  const x=Math.sin(n*12.9898)*43758.5453;
  return x-Math.floor(x);
}

function drawElectricLine(ctx,a,b,width=4,alpha=1,seed=0,gray=false,lite=false){
  const dx=b.x-a.x,dy=b.y-a.y,len=Math.hypot(dx,dy)||1;
  const tx=dx/len,ty=dy/len,nx=-ty,ny=tx;
  const steps=lite?Math.max(6,Math.min(14,Math.floor(len/45))):Math.max(6,Math.min(34,Math.floor(len/20)));
  const frame=Math.floor(Date.now()/55);
  const strands=lite?[0]:[-.75,0,.75];
  ctx.save();ctx.globalAlpha=alpha;ctx.lineCap='round';ctx.lineJoin='round';
  for(let s=0;s<strands.length;s++){
    const points=[a];
    for(let i=1;i<steps;i++){
      const f=i/steps;
      const wild=(electricNoise(seed+frame*7.1+i*19.7+s*101)-.5)*(18+width*2.5);
      const along=(electricNoise(seed+frame*3.7+i*31.2+s*47)-.5)*8;
      const spread=strands[s]*width*1.2*Math.sin(Math.PI*f);
      points.push({x:a.x+dx*f+tx*along+nx*(wild+spread),y:a.y+dy*f+ty*along+ny*(wild+spread)});
    }
    points.push(b);
    // Wide translucent glow followed by a sharp white-cyan core.
    ctx.beginPath();points.forEach((p,i)=>i?ctx.lineTo(p.x,p.y):ctx.moveTo(p.x,p.y));
    ctx.strokeStyle=gray?'rgba(220,220,220,.24)':'rgba(20,225,255,.24)';ctx.lineWidth=width*3.6;ctx.shadowColor=gray?'#d8d8d8':'#20eaff';ctx.shadowBlur=lite?9:24;ctx.stroke();
    ctx.beginPath();points.forEach((p,i)=>i?ctx.lineTo(p.x,p.y):ctx.moveTo(p.x,p.y));
    ctx.strokeStyle=gray?(s===1||lite?'#ffffff':'#bcbcbc'):(s===1||lite?'#efffff':'#43f7ff');ctx.lineWidth=s===1||lite?Math.max(1.2,width*.40):Math.max(.75,width*.20);ctx.shadowBlur=lite?4:10;ctx.stroke();

    // Short forks break up the main bolt and make it look like unstable electricity.
    if(s===1||lite){
      for(let i=2;i<points.length-1;i+=lite?5:3){
        const p=points[i],side=electricNoise(seed+frame+i*13)>.5?1:-1;
        const branchLen=12+electricNoise(seed+i*23+frame)*28;
        const bx=p.x+tx*branchLen*.35+nx*branchLen*side;
        const by=p.y+ty*branchLen*.35+ny*branchLen*side;
        const kinkX=p.x+(bx-p.x)*.48+nx*side*7;
        const kinkY=p.y+(by-p.y)*.48+ny*side*7;
        ctx.beginPath();ctx.moveTo(p.x,p.y);ctx.lineTo(kinkX,kinkY);ctx.lineTo(bx,by);
        ctx.strokeStyle=gray?'#ededed':'#baffff';ctx.lineWidth=Math.max(.7,width*.16);ctx.shadowBlur=lite?3:9;ctx.stroke();
      }
    }
  }
  ctx.restore();
}

function drawPlasmaFields(ctx){
  for(const line of plasmaCurrents){
    domainClip(ctx,line.owner,()=>{
      const gray=!!line.artistCopy;
      drawElectricLine(ctx,line.a,line.b,5.5,Math.min(1,line.life),line.owner.id*1000,gray);
