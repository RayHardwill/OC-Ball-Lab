  emmyThrows.forEach(p=>{ if(p.owner===emmy) p.alive=false; });
  emmy.emmyDisarmed=false;
  emmyUltBeams.push({owner:emmy,side:emmy.side,life:0,dur:6,alive:true,tick:0});
  triggerScreenUltFlash('#ffffff',0.8);
  effects.push({type:'ult_flash',x:emmy.x,y:emmy.y,r:150,color:'#ffffff',t:0,dur:0.65});
}

function updateEmmyUltBeam(beam,dt){
  if(!beam.alive||!beam.owner||!beam.owner.alive){beam.alive=false;return;}
  beam.life+=dt;beam.tick+=dt;
  if(beam.life>=beam.dur){beam.alive=false;return;}
  const frac=Math.min(1,beam.life/beam.dur);
  const maxRadius=Math.hypot(W,H)*0.58;
  const radius=beam.owner.r+(maxRadius-beam.owner.r)*frac;
  while(beam.tick>=0.1){
    beam.tick-=0.1;
    const enemies=[...balls,...copies].filter(e=>e.alive&&e.side!==beam.side);
    enemies.forEach(e=>{
      const er=e.char.id==='elder_tree'?e.etGrowR:e.r;
      if(Math.hypot(e.x-beam.owner.x,e.y-beam.owner.y)<=radius+er) e.takeDamage(5,beam.owner);
    });
    turrets.forEach(t=>{
      if(t.alive&&t.side!==beam.side&&Math.hypot(t.x-beam.owner.x,t.y-beam.owner.y)<=radius+t.r) t.takeDamage(5,beam.owner);
    });
  }
}

function drawEmmyUltBeam(ctx,beam){
  if(!beam.alive||!beam.owner||!beam.owner.alive) return;
  const frac=Math.min(1,beam.life/beam.dur);
  const radius=beam.owner.r+(Math.hypot(W,H)*0.58-beam.owner.r)*frac;
  const x=beam.owner.x,y=beam.owner.y;
  ctx.save();

  // Soft outer fountain with translucent sides.
  const outer=ctx.createRadialGradient(x,y,Math.max(1,radius*0.45),x,y,radius);
  outer.addColorStop(0,'rgba(255,255,255,0.04)');
  outer.addColorStop(0.55,'rgba(255,255,255,0.07)');
  outer.addColorStop(0.86,'rgba(255,255,255,0.15)');
  outer.addColorStop(1,'rgba(255,255,255,0)');
  ctx.fillStyle=outer;ctx.shadowColor='#ffffff';ctx.shadowBlur=30;
  ctx.beginPath();ctx.arc(x,y,radius,0,Math.PI*2);ctx.fill();

  ctx.shadowBlur=16;ctx.strokeStyle='rgba(255,255,255,0.26)';
  ctx.lineWidth=Math.max(2,7*(1-frac)+2);
  ctx.beginPath();ctx.arc(x,y,radius,0,Math.PI*2);ctx.stroke();

  const coreR=Math.max(8,Math.min(radius*0.45,42+radius*0.10));
  const core=ctx.createRadialGradient(x,y,0,x,y,coreR);
  core.addColorStop(0,'rgba(255,255,255,0.78)');
  core.addColorStop(0.55,'rgba(255,255,255,0.34)');
  core.addColorStop(1,'rgba(255,255,255,0)');
  ctx.shadowBlur=22;ctx.fillStyle=core;
  ctx.beginPath();ctx.arc(x,y,coreR,0,Math.PI*2);ctx.fill();

  ctx.globalAlpha=0.20*(1-frac*0.35);
  ctx.strokeStyle='#ffffff';ctx.lineWidth=2;
  for(let i=0;i<8;i++){
    const a=(i/8)*Math.PI*2+beam.life*0.8;
    const inner=coreR*0.65;
    const outerLen=radius*(0.72+0.12*Math.sin(beam.life*4+i));
    ctx.beginPath();
    ctx.moveTo(x+Math.cos(a)*inner,y+Math.sin(a)*inner);
    ctx.lineTo(x+Math.cos(a)*outerLen,y+Math.sin(a)*outerLen);
    ctx.stroke();
  }
  ctx.restore();
}

