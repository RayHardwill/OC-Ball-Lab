function domainVillainyPath(owner){
  // Predict the route the current velocity would take inside the circular
  // room. Check every enemy BEFORE each wall bounce; the first intersection
  // wins, even when it is behind Villainy after a reflection.
  const center=DOMAIN_CENTERS[1],wallR=DOMAIN_RADIUS-owner.r-3;
  const speed=Math.hypot(owner.vx,owner.vy);
  if(speed<.001)return null;
  let dx=owner.vx/speed,dy=owner.vy/speed,x=owner.x,y=owner.y;
  const points=[{x,y}];
  const targets=[...domainEnemies(owner,true),...turrets.filter(t=>t.alive&&t.realm===1&&t.side!==owner.side)];
  for(let bounce=0;bounce<96;bounce++){
    const ox=x-center.x,oy=y-center.y,along=ox*dx+oy*dy;
    const wallDist=-along+Math.sqrt(Math.max(0,along*along+wallR*wallR-ox*ox-oy*oy));
    if(wallDist<.001)break;
    let first=null,firstDist=Infinity;
    for(const target of targets){
      if(!target.alive)continue;
      const tr=target.char?.id==='elder_tree'?target.etGrowR:target.r;
      const rx=x-target.x,ry=y-target.y,approach=rx*dx+ry*dy;
      const offset=rx*rx+ry*ry-(owner.r+tr)*(owner.r+tr);
      const disc=approach*approach-offset;
      if(disc<0||offset<=0&&approach>=0)continue;
      const distance=-approach-Math.sqrt(disc);
      if(distance>=-.001&&distance<=wallDist+.001&&distance<firstDist){
        first=target;firstDist=Math.max(0,distance);
      }
    }
    if(first){
      const hit={x:x+dx*firstDist,y:y+dy*firstDist};
      points.push(hit);
      return {target:first,points,hit,incoming:{x:dx,y:dy},bounces:bounce};
    }
    const wall={x:x+dx*wallDist,y:y+dy*wallDist};
    points.push(wall);
    const nx=(wall.x-center.x)/wallR,ny=(wall.y-center.y)/wallR;
    const dot=dx*nx+dy*ny;
    dx-=2*dot*nx;dy-=2*dot*ny;
    // Start the next segment just inside the wall to avoid re-hitting it at t=0.
    x=wall.x+dx*.05;y=wall.y+dy*.05;
  }
  return null; // No invented straight-line hit if this heading misses everyone.
}
