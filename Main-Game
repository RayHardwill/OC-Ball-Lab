  takeDamage(dmg,source=null){
    if(!this.alive) return;
    if(isFriendlySource(this,source)) return;
    if(this.char.id==='harper'&&this.harperTransformIFrames>0) return;
    if(this.char.id==='matt'&&this.mattImmuneTimer>0) return;
    if(this.char.id==='hyperbole'&&this.hyperboleUltDuration>0)return;
    if(isDomainMode()){
      if(source && !sameRealm(this,{realm:combatRealm(source)})) return;
      if(domainState?.phase==='active' && this.realm===1 && (domainState.owner.char.id==='emmy' || (this===domainState.owner && this.char.id==='devourer'))) return;
    }
    // Juggernaut-only protection for freshly produced ultimate lion copies.
    if(this.isCopy && this.char.id==='manic_lion' && this.fromUlt && this.lionSpawnImmunity>0) return;
    dmg=modeDamage(dmg,source);
    if(this.char.id==='elder_tree' && this.etUltActive) return;
    if(this.char.id==='devourer' && this.devUltActive) return;
    if(this.char.id==='emmy' && this.emmyUltActive) return;
    if(this.char.id==='mayhem' && this.mayhemState==='fire_charge') return;
    if(this.char.id==='maniac_artist' && this.artistMayhemCharge>0) return;
    // Maniac Artist is completely immune for Omni Drill's entire sequence:
    // fade, wait, telegraph, strike, and every transition between them.
    if(this.char.id==='maniac_artist' && this.artistUltType==='omni_drill') return;
    // Maniac Artist's forcefield blocks every damage source for four seconds.
    if(this.char.id==='maniac_artist' && this.artistForceActive>0) return;
    // Copied Dark Knight shield: nullify exactly the next incoming hit.
    if(this.char.id==='maniac_artist' && this.artistCopiedShield){
      this.artistCopiedShield=false;this.artistCopiedShieldGlow=0;
      effects.push({type:'ult_flash',x:this.x,y:this.y,r:65,color:'#ffffff',t:0,dur:.35});
      effects.push({type:'ring',x:this.x,y:this.y,r:this.r,maxR:this.r+45,color:'#ffffff',t:0,dur:.4});
      return;
    }

    // Dodge is checked at the single shared damage gateway, so it works against
    // contact, projectiles, summons, beams, shockwaves and ultimate ticks.
    if(this.char.id==='maniac_artist' && this.artistDodge>0 && Math.random()<this.artistDodge){
      effects.push({type:'text',x:this.x,y:this.y-this.r-10,text:'DODGE',color:'#ffffff',t:0,dur:.55});
      effects.push({type:'ring',x:this.x,y:this.y,r:this.r,maxR:this.r+35,color:'#ffffff',t:0,dur:.3});
      return;
    }

    // Dark Knight's charged shield nullifies the next incoming hit.
    if(this.char.id==='dark_knight' && this.dkShieldReady && !this.dkUltActive){
      this.dkShieldReady=false;
      this.dkShieldCharge=0;
      effects.push({type:'ult_flash',x:this.x,y:this.y,r:65,color:'#ffffff',t:0,dur:0.35});
      effects.push({type:'ring',x:this.x,y:this.y,r:this.r,maxR:this.r+45,color:'#ffffff',t:0,dur:0.4});
      return;
    }

    let reduced = dmg;
    if(this.char.id === 'elder_tree' && this.etGrowBonus > 0 && !source?.ignoreDefense){
      const defense=this.etGrowBonus/100;
      reduced = dmg * (1 - (isDomainMode()&&domainState?.owner.char.id==='plasma'&&this.realm===1?defense*.5:defense));
    }
    if(this.char.id === 'dark_knight' && !source?.ignoreDefense){
      const def=this.dkUltActive ? 0.25 : (this.char.defense||0);
      reduced *= (1-(isDomainMode()&&domainState?.owner.char.id==='plasma'&&this.realm===1?def*.5:def));
    }
    if(this.char.id === 'plasma' && !source?.ignoreDefense){
      // Normal defense is 20%. During the voltage-web ultimate, -50% defense
      // means incoming damage is multiplied by 1.5 instead.
      const defense=isDomainMode()&&domainState?.owner.char.id==='plasma'&&this.realm===1?(this===domainState.owner?0:(this.char.defense||0)*.5):(this.char.defense||0);
      reduced *= this.plasmaUltActive ? 1.5 : (1-defense);
    }
    // A negative defense value replaces innate defense while its effect lasts.
    if(this.hyperboleDefenseTimer>0)reduced=dmg*2;
    else if(this.hyperboleLifedoomTimer>0)reduced=dmg*1.5;
    const actual=Math.min(this.hp,Math.max(0,reduced));
    this.hp=Math.max(0,this.hp-actual);
    creditDamage(source,actual);
    if(this.char.id==='ray'&&!this.isCopy&&this.hp>0&&actual>0)this.recordRayPanicDamage(actual);
    this.flashTimer=0.15;
    effects.push({type:'ring',x:this.x,y:this.y,r:this.r,maxR:this.r+40,color:'#ff4444',t:0,dur:0.4});
    if(this.hp<=0){
      if(this.char.id==='harper'&&!this.harperInstalled){
        this.activateDaemonInstall();
        return;
      }
      this.alive=false;
    }
  }

  updateLion(dt,enemies){
    if(this.ultActive){
      spawnLionAuraParticles(this);
    }
    if(!this.isCopy){
      this.ultTimer+=dt;
      this.ultProgress=Math.min(1,this.ultTimer/this.ultInterval);
      if(!this.ultActive && this.ultTimer>=this.ultInterval){
        this.activateLionUlt();
