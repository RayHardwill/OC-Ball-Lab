function drawHarperDaemonParticles(ctx,r){
  // WHITE ENERGY travels outward from both eyes. No particle arrays are used,
  // so this remains lightweight even during Gem Dominion.
  const now=Date.now()/760;
  for(const side of [-1,1]){
    const eyeX=side*r*.38,eyeY=r*.02;
    const baseAngle=side<0?Math.PI:0;
    for(let i=0;i<7;i++){
      const progress=(now+i/7)%1;
      const spread=((i%3)-1)*.19+Math.sin(i*2.1)*.035;
      const distance=r*(.24+progress*1.08);
      const px=eyeX+Math.cos(baseAngle+spread)*distance;
      const py=eyeY+Math.sin(baseAngle+spread)*distance;
      ctx.globalAlpha=(1-progress)*.82;
      ctx.fillStyle=i%3===0?'#ffd8e5':'#ffffff';
      ctx.shadowColor='#ffffff';ctx.shadowBlur=r*.15;
      ctx.beginPath();ctx.arc(px,py,r*(.025+.035*(1-progress)),0,Math.PI*2);ctx.fill();
    }
  }
  ctx.globalAlpha=1;ctx.shadowBlur=0;
}

function drawHarperDaemonBody(ctx,r,showEyes=true,showParticles=true){
  const body=ctx.createRadialGradient(-r*.25,-r*.32,r*.06,0,0,r);
  body.addColorStop(0,'#151118');body.addColorStop(.55,'#08070a');body.addColorStop(1,HARPER_DARK);
  ctx.beginPath();ctx.arc(0,0,r,0,Math.PI*2);ctx.fillStyle=body;ctx.fill();
  // Same finished hair on both sides, filled black with no outlines.
  drawHarperHairSide(ctx,r,1,false);drawHarperHairSide(ctx,r,-1,false);
  // Horns reuse the Hybrid coordinates and stay above the hat.
  drawHarperTopHat(ctx,r);drawHarperDaemonHorns(ctx,r);

  if(!showEyes) return;
  // Angry left eye and tall four-point-star right eye.
  ctx.fillStyle='#ffffff';ctx.shadowColor='#ffffff';ctx.shadowBlur=r*.36;
