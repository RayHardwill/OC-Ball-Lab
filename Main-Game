}

function setGameMode(mode){
  if(!GAME_MODES[mode]) return;
  gameMode=mode;
  document.getElementById('screen-select').classList.toggle('domain-select',isDomainMode());
  selected.splice(0);
  document.querySelectorAll('.char-card.selected').forEach(c=>c.classList.remove('selected'));
  document.querySelectorAll('.mode-btn').forEach(btn=>btn.classList.toggle('active',btn.id==='mode-'+mode));
  updateSelectionHint();
  btnFight.disabled=true;
}

function updateSelectionHint(){
  const mode=getMode();
  if(isDomainMode()){
    hint.textContent=`${selected.length} / ${CHARS.length} selected · choose any ${mode.minSelection}–${CHARS.length} fighters · free for all`;
    btnFight.disabled=selected.length<mode.minSelection;
    return;
  }
  const needed=mode.selectionCount-selected.length;
  let detail='';
  if(gameMode==='2v2') detail=' · first 2 are Team A, next 2 are Team B';
  if(gameMode==='3v3') detail=' · first 3 are Team A, next 3 are Team B';
  if(gameMode==='juggernaut') detail=' · first selected character is the Juggernaut';
  hint.textContent=needed===0?'Ready to fight!'+detail:'Select '+needed+' more character'+(needed===1?'':'s')+detail;
  btnFight.disabled=selected.length!==mode.selectionCount;
}

