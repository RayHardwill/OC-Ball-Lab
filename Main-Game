        ctx.beginPath();ctx.arc(d.x,d.y,d.radius*(1-d.timer)*.9, a,a+.35);ctx.stroke();ctx.globalAlpha=1;}
      ctx.font='700 54px "Cinzel Decorative"';ctx.textAlign='center';
      ctx.shadowColor=d.color;ctx.shadowBlur=25;ctx.fillStyle=Math.sin(t*23)>-.25?'#fff':d.color;
      ctx.fillText('DOMAIN EXPANSION',W/2,H/2-25);ctx.shadowBlur=0;
      ctx.font='700 22px Rajdhani';ctx.fillText(d.owner.char.name.toUpperCase(),W/2,H/2+13);
    }else{
      ctx.save();ctx.beginPath();ctx.arc(DOMAIN_CENTERS[0].x,DOMAIN_CENTERS[0].y,DOMAIN_RADIUS,0,Math.PI*2);ctx.clip();
      const g=ctx.createRadialGradient(d.x-d.radius*.28,d.y-d.radius*.32,9,d.x,d.y,d.radius);
      g.addColorStop(0,'#737481');g.addColorStop(.16,'#20202a');g.addColorStop(.75,'#030309');g.addColorStop(1,'#554967');
      ctx.fillStyle=g;ctx.shadowColor=d.color;ctx.shadowBlur=20;
      ctx.beginPath();ctx.arc(d.x,d.y,d.radius,0,Math.PI*2);ctx.fill();ctx.shadowBlur=0;
      ctx.strokeStyle='#d7e4f9';ctx.lineWidth=2;ctx.beginPath();ctx.arc(d.x,d.y,d.radius-4,0,Math.PI*2);ctx.stroke();
      ctx.save();ctx.beginPath();ctx.arc(d.x,d.y,d.radius-5,0,Math.PI*2);ctx.clip();
      for(const [i,crack] of d.cracks.entries()){
        const length=d.radius*(.27+.28*(i%4)/3),branches=2+(i%3);
        ctx.beginPath();
        for(let k=0;k<=branches+2;k++){
          const r=d.radius-3-length*k/(branches+2),angle=crack.angle+(k%2?1:-1)*(.025+crack.seed*.001);
          const x=d.x+Math.cos(angle)*r,y=d.y+Math.sin(angle)*r;
          k?ctx.lineTo(x,y):ctx.moveTo(x,y);
          if(k===2){
            ctx.moveTo(x,y);
            ctx.lineTo(x+Math.cos(angle+.48)*length*.34,y+Math.sin(angle+.48)*length*.34);
            ctx.moveTo(x,y);
          }
        }
        ctx.strokeStyle='rgba(226,238,255,.92)';ctx.shadowColor=d.color;ctx.shadowBlur=10;
        ctx.lineWidth=1.4+(i%3)*.65;ctx.stroke();
      }
      ctx.restore();ctx.shadowBlur=0;
      ctx.font='700 20px Rajdhani';ctx.fillStyle='#fff';ctx.textAlign='center';
      ctx.restore();
      ctx.fillText(`${d.timer.toFixed(1)}s · ${d.owner.char.name.toUpperCase()}`,DOMAIN_CENTERS[1].x,DOMAIN_CENTERS[1].y+DOMAIN_RADIUS-22);
    }
  }
  ctx.restore();
}

function startGame(){
  cancelAnimationFrame(animId);
  const mode=getMode();
  W=mode.width;
  H=mode.height;
  canvas.width=W;
  canvas.height=H;
  canvas.classList.toggle('large-arena',W>600||H>560);
  const gameUI=document.getElementById('game-ui');
  document.getElementById('screen-game').classList.toggle('domain-game',isDomainMode());
  gameUI.style.setProperty('--hud-cols',Math.min(matchRoster.length,3));
  gameUI.innerHTML=matchRoster.map((_,i)=>`<div class="hud-side" id="hud-${i}"></div>`).join('');

  balls=[];copies=[];effects=[];spikes=[];chains=[];abilityTrails=[];
  turrets=[];bullets=[];spiritOrbs=[];
  devourerRockWalls=[];
  lionBiteRedirectTarget=null;
  rayWalls=[];rayLasers=[];rayUltBeams=[];rayTargetBeams=[];rayVisuals=[];rayGraniteBlasts=[];rayGraniteCharges=[];
  darkKnightPortals=[];darkKnightWindParticles=[];darkKnightShadowParticles=[];darkKnightSlashEffects=[];darkKnightStunTimers={};
  emmyThrows=[];emmyUltBeams=[];
  artistBeams=[];
  plasmaCurrents=[];
  harperShards=[];
  harperBloodstones=[];
  mayhemFireballs=[];
  mayhemPuddles=[];
  mayhemExplosions=[];
  mayhemGeysers=[];
  mattZones=[];mattSlashes=[];mattStars=[];
  hyperboleMeteors=[];hyperboleRifts=[];hyperboleRiftFades=[];hyperboleSplits=[];
  lionAuraParticles=[];
  domainState=null;domainQueue=[];
  frozenBalls=new Set();
  orbSpawnTimer=0;
  orbSpawnInterval=6+Math.random()*4;
  document.getElementById('overlay').classList.add('hidden');
  document.getElementById('screen-select').style.display='none';
  document.getElementById('screen-countdown').style.display='none';
  document.getElementById('screen-game').style.display='flex';
  matchRoster.forEach((slot,i)=>{
    const c=CHARS.find(ch=>ch.id===slot.charId);
    balls.push(new Ball(c,slot.side,false,null,slot.isJuggernaut,i));
  });
  gameRunning=true;
  lastTime=performance.now();
  lastHudTime=0;
  updateHUD();
  requestAnimationFrame(loop);
}

function loop(ts){
  const dt=Math.min((ts-lastTime)/1000,0.05);
  lastTime=ts;
  if(!gameRunning) return;
  // Run two normal-size simulation steps at 2× speed. Keeping the steps
  // separate makes collisions and fast projectiles more reliable than one large dt.
  for(let step=0;step<battleSpeed;step++) update(dt);
  if(!gameRunning||ts-lastHudTime>=50){updateHUD();lastHudTime=ts;}
  render();
  animId=requestAnimationFrame(loop);
}

let frozenBalls=new Set();

function update(dt){
  frozenBalls=new Set();
  // Status timers tick even while a fighter is stunned and skips Ball.update.
  for(const fighter of [...balls,...copies]){
    if(fighter.hyperboleStunTimer>0){
      fighter.hyperboleStunTimer=Math.max(0,fighter.hyperboleStunTimer-dt);
      if(fighter.hyperboleStunTimer>0)frozenBalls.add(fighter.id);
    }
    fighter.hyperboleDefenseTimer=Math.max(0,(fighter.hyperboleDefenseTimer||0)-dt);
    fighter.hyperboleLifedoomTimer=Math.max(0,(fighter.hyperboleLifedoomTimer||0)-dt);
  }
  for(const id in darkKnightStunTimers){
    darkKnightStunTimers[id]-=dt;
    if(darkKnightStunTimers[id]>0) frozenBalls.add(Number(id));
    else delete darkKnightStunTimers[id];
  }
  updateDarkKnightParticles(dt);
  updatePlasmaFields(dt);

  updateMattStars(dt);
  updateMattZones(dt);
  updateHyperboleObjects(dt);

  mayhemFireballs.forEach(p=>updateMayhemFireball(p,dt));
  mayhemFireballs=mayhemFireballs.filter(p=>p.alive);
  mayhemPuddles.forEach(p=>updateMayhemPuddle(p,dt));
  mayhemPuddles=mayhemPuddles.filter(p=>p.life<p.dur);
  mayhemExplosions.forEach(ex=>updateMayhemExplosion(ex,dt));
  mayhemExplosions=mayhemExplosions.filter(ex=>!ex.activated||ex.life<ex.dur);
  mayhemGeysers.forEach(g=>updateMayhemGeyser(g,dt));
  mayhemGeysers=mayhemGeysers.filter(g=>g.life<g.dur);
  [...balls,...copies,...turrets].forEach(entity=>updateMayhemBurnStatus(entity,dt));

  harperShards.forEach(shard=>updateHarperShard(shard,dt));
  harperShards=harperShards.filter(shard=>shard.alive);
  harperBloodstones.forEach(stone=>updateHarperBloodstone(stone,dt));
  harperBloodstones=harperBloodstones.filter(stone=>stone.alive);

  const etInMatch = [...balls,...copies].some(b=>b.char.id==='elder_tree'&&b.alive&&!b.isCopy);
  if(etInMatch){
    orbSpawnTimer += dt;
    if(orbSpawnTimer >= orbSpawnInterval){
      orbSpawnTimer = 0;
      orbSpawnInterval = 6 + Math.random()*4;
      spawnSpiritOrb();
    }
  }

  rayWalls.forEach(w=>{ w.life+=dt; });
  rayWalls = rayWalls.filter(w=>w.life<w.dur);
  rayVisuals.forEach(v=>v.life+=dt);
  rayVisuals=rayVisuals.filter(v=>v.life<v.dur);

  rayTargetBeams.forEach(b=>updateRayTargetBeam(b,dt));
  rayTargetBeams = rayTargetBeams.filter(b=>b.alive);

  rayLasers.forEach(l=>updateRayLaser(l,dt));
  rayLasers = rayLasers.filter(l=>l.alive);

  rayGraniteCharges=rayGraniteCharges.filter(charge=>updateRayGraniteCharge(charge,dt));
  rayGraniteBlasts.forEach(beam=>updateRayGraniteBlast(beam,dt));
  rayGraniteBlasts=rayGraniteBlasts.filter(beam=>beam.active||beam.trail.length);

  rayUltBeams.forEach(b=>updateRayUlt(b,dt));
  rayUltBeams = rayUltBeams.filter(b=>b.alive);

  updateDevourerRockWalls();

  emmyThrows.forEach(p=>updateEmmyThrow(p,dt));
  emmyThrows=emmyThrows.filter(p=>p.alive);
  emmyUltBeams.forEach(b=>updateEmmyUltBeam(b,dt));
  emmyUltBeams=emmyUltBeams.filter(b=>b.alive);
  artistBeams.forEach(b=>updateArtistBeam(b,dt));
  artistBeams=artistBeams.filter(b=>b.alive);

  chains=chains.filter(ch=>{
    if(!ch.devourer.alive||!ch.target.alive){if(ch.devourer) ch.devourer.inChainDash=false;return false;}
    ch.t+=dt;
    if(ch.state==='freeze'){
      const anotherDash=chains.some(other=>other!==ch&&other.devourer===ch.devourer&&other.state==='dash'&&!other.dashHit);
      if(!anotherDash) ch.devourer.inChainDash=false;
      frozenBalls.add(ch.target.id);
      if(ch.t>=ch.dur){
        // Juggernaut's two targets are chained together, then punched in order.
        const earlierChain=chains.some(other=>other!==ch&&other.groupId===ch.groupId&&other.sequence<ch.sequence&&!other.dashHit&&other.target.alive);
        if(!earlierChain){
          ch.state='dash';
          ch.t=0;
          const dx=ch.target.x-ch.devourer.x;
          const dy=ch.target.y-ch.devourer.y;
          const d=Math.hypot(dx,dy)||1;
          const dashSpd=14;
          ch.devourer.vx=dx/d*dashSpd;
          ch.devourer.vy=dy/d*dashSpd;
        }
      }
    } else {
      ch.devourer.inChainDash=true;
      if(!ch.dashHit){
        const dx=ch.target.x-ch.devourer.x;
        const dy=ch.target.y-ch.devourer.y;
        const d=Math.hypot(dx,dy)||1;
        const dashSpd=16;
        ch.devourer.vx=dx/d*dashSpd;
        ch.devourer.vy=dy/d*dashSpd;
      }
      if(!ch.dashHit && Math.hypot(ch.devourer.x-ch.target.x,ch.devourer.y-ch.target.y)<ch.devourer.r+ch.target.r+4){
        ch.dashHit=true;
        ch.devourer.inChainDash=false;
        const dmg=ch.devourer.getDamage()*5;
        ch.target.takeDamage(dmg,ch.devourer);
        if(ch.devourer.char.id==='devourer'&&!ch.devourer.isCopy) domainCount(ch.devourer,'chains',1);
        const ang=Math.atan2(ch.target.y-ch.devourer.y,ch.target.x-ch.devourer.x);
        ch.target.vx=Math.cos(ang)*(ch.target.getSpeed()*1.5);
        ch.target.vy=Math.sin(ang)*(ch.target.getSpeed()*1.5);
        const devSpd=ch.devourer.getSpeed();
        ch.devourer.vx=-Math.cos(ang)*devSpd;
        ch.devourer.vy=-Math.sin(ang)*devSpd;
        effects.push({type:'punch',x:ch.target.x,y:ch.target.y,t:0,dur:0.55});
        effects.push({type:'ring',x:ch.target.x,y:ch.target.y,r:ch.target.r,maxR:ch.target.r+90,color:'#aa44ff',t:0,dur:0.5});
        effects.push({type:'ring',x:ch.target.x,y:ch.target.y,r:ch.target.r,maxR:ch.target.r+50,color:'#ffffff',t:0,dur:0.3});
        effects.push({type:'ult_flash',x:ch.target.x,y:ch.target.y,r:70,color:'#cc66ff',t:0,dur:0.4});
        if(ch.devourer.char.id==='devourer'){
          ch.devourer.devBonus+=15;
          if(ch.devourer.isJuggernaut){
            const heal=ch.devourer.maxHp*0.04;
            ch.devourer.hp=Math.min(ch.devourer.maxHp,ch.devourer.hp+heal);
            effects.push({type:'text',x:ch.devourer.x,y:ch.devourer.y-ch.devourer.r-14,text:'SOUL +4%',color:'#88ffbb',t:0,dur:0.65});
          }
        }
        return false;
      }
      if(ch.t>3){ch.devourer.inChainDash=false;return false;}
    }
    return true;
  });

  effects.forEach(ef=>{
    if(ef.type!=='shockwave') return;
    const curR = ef.r + (ef.maxR - ef.r)*(ef.t/ef.dur);
    const enemies = [...balls,...copies].filter(b=>b.alive&&b.side!==ef.side&&sameRealm(b,ef));
    enemies.forEach(e=>{
      if(ef.hit.has(e.id)) return;
      const dist = Math.hypot(e.x-ef.x,e.y-ef.y);
      const eR = e.char.id==='elder_tree' ? e.etGrowR : e.r;
      if(Math.abs(dist - curR) < eR + 8){
        ef.hit.add(e.id);
        e.takeDamage(ef.damage,ef.owner);
        effects.push({type:'ring',x:e.x,y:e.y,r:eR,maxR:eR+35,color:'#55ff77',t:0,dur:0.4});
      }
    });
    turrets.forEach(t=>{
      if(!t.alive || t.side===ef.side || !sameRealm(t,ef) || ef.turretHit.has(t.id)) return;
      if(Math.abs(Math.hypot(t.x-ef.x,t.y-ef.y)-curR) < t.r+8){
        ef.turretHit.add(t.id);
        t.takeDamage(ef.damage,ef.owner);
        effects.push({type:'ring',x:t.x,y:t.y,r:t.r,maxR:t.r+35,color:'#55ff77',t:0,dur:0.4});
      }
    });
  });

  const allLive=[...balls,...copies].filter(b=>b.alive);
  [...balls,...copies].forEach(b=>{
    if(!b.alive) return;
    if(frozenBalls.has(b.id)) return;
    const enemies=allLive.filter(o=>o.side!==b.side&&o.alive&&sameRealm(o,b));
    b.update(dt,enemies,allLive);
    if(b.char.id==='villainy' && b.inThrust && !b.thrustUltActive){
      checkThrustHit(b);
    }

    {
      rayWalls.forEach(wall=>{
        if(!sameRealm(b,wall))return;
        // Normal Ray walls ignore Ray's own team. Artist-copy walls ignore only Maniac Artist himself.
        if(wall.artistCopy){ if(b===wall.owner) return; }
        else { if(b.char.id==='ray' || wall.side===b.side) return; }
        const bR2 = b.char.id==='elder_tree' ? b.etGrowR : b.r;
        if(bounceOffRayWall(b,wall,bR2)){
          if(b.isCopy && b.char.id==='manic_lion') redirectLionCopyAfterBounce(b);
          effects.push({type:'ring',x:b.x,y:b.y,r:bR2,maxR:bR2+30,color:wall.color,t:0,dur:0.3});
        }
      });
    }
  });
  copies=copies.filter(c=>c.alive);

  turrets.forEach(t=>t.update(dt,[...balls,...copies],[...balls,...copies]));
  turrets=turrets.filter(t=>t.alive);
  bullets.forEach(b=>b.update(dt,[...balls,...copies],[...balls,...copies],turrets));
  bullets=bullets.filter(b=>b.alive);

  const liveBalls=[...balls,...copies].filter(b=>b.alive);
  turrets.forEach(t=>{
    if(!t.alive) return;
    liveBalls.forEach(b=>{
      if(b.side===t.side || !sameRealm(b,t)) return;
      const bR = b.char.id==='elder_tree' ? b.etGrowR : b.r;
      const dist=Math.hypot(b.x-t.x,b.y-t.y);
      if(dist<bR+t.r){
        const nx=(b.x-t.x)/(dist||1);
        const ny=(b.y-t.y)/(dist||1);
        const overlap=bR+t.r-dist;
        b.x+=nx*overlap;
        b.y+=ny*overlap;
        const dot=b.vx*nx+b.vy*ny;
        if(dot<0){
          b.vx-=2*dot*nx;
          b.vy-=2*dot*ny;
          const spd=b.getSpeed();
          const cur=Math.hypot(b.vx,b.vy)||1;
          b.vx=b.vx/cur*spd;
          b.vy=b.vy/cur*spd;
          domainEmmyRedirectAfterBounce(b);
        }
        if(isEmmyDomainParticipant(b))return; // a turret can be a wall, never an attack
        if(!t._hitCooldowns) t._hitCooldowns={};
        const key=b.id;
        if(!t._hitCooldowns[key] || t._hitCooldowns[key]<=0){
          t._hitCooldowns[key]=0.5;
          if((b.char.id==='mayhem'&&b.mayhemState==='fire_charge')||(b.char.id==='maniac_artist'&&b.artistMayhemCharge>0)){
            triggerMayhemChargeHit(b,t);
          }else{
            const dmg=b.getDamage()*(b.isCrit()?b.char.critMult:1);
            t.takeDamage(dmg,b);
          }
          effects.push({type:'ring',x:t.x,y:t.y,r:t.r,maxR:t.r+30,color:'#ff8800',t:0,dur:0.35});
        }
      }
      if(t._hitCooldowns){
        for(const k in t._hitCooldowns) t._hitCooldowns[k]-=dt;
      }
    });
  });

  spikes.forEach(sp=>{
    sp.t+=dt;
    if(!sp.hit && sp.t>=sp.dur*0.55){
      sp.hit=true;
      if(sp.target.alive && Math.hypot(sp.target.x-sp.x,sp.target.y-sp.y)<60){
        const crit=Math.random()<0.2;
        sp.target.takeDamage(sp.damage*(crit?1.8:1),sp.owner);
      }
    }
  });
  spikes=spikes.filter(s=>s.t<s.dur);

  const lb=[...balls,...copies].filter(b=>b.alive);
  for(let i=0;i<lb.length;i++){
    for(let j=i+1;j<lb.length;j++){
      if(lb[i].side!==lb[j].side && sameRealm(lb[i],lb[j])){
        handleCollision(lb[i],lb[j]);
      }
    }
  }

  processDarkKnightUltContacts();
  updateLionAuraParticles(dt);
  if(isDomainMode()) updateDomain(dt);

  effects=effects.filter(e=>{e.t+=dt;return e.t<e.dur;});
  abilityTrails=abilityTrails.filter(t=>{t.t+=dt;return t.t<t.dur;});

  const configuredSides=[...new Set(matchRoster.map(s=>s.side))];
  const survivingSides=configuredSides.filter(side=>[...balls,...copies].some(b=>b.alive&&b.side===side));
  if(survivingSides.length===1) endGame(survivingSides[0]);
}

function endGame(winSide){
  if(!gameRunning) return;
  gameRunning=false;
  const ov=document.getElementById('overlay');
  const ot=document.getElementById('overlay-title');
  const os=document.getElementById('overlay-sub');
  const winners=balls.filter(b=>b&&b.side===winSide);
  ot.textContent=winners.length>1?'TEAM '+String.fromCharCode(65+winSide)+' WINS!':(winners[0]?winners[0].char.name+' WINS!':'Draw!');
  const winnerColors=['#ffcc44','#aa88ff','#55ddff'];
  ot.style.color=winnerColors[winSide]||'#ffffff';
  os.textContent='Click restart or go back to character select';
  ov.classList.remove('hidden');
}

function abilityCooldown(timer,interval){
  return Math.max(0,interval-timer).toFixed(1)+'s';
}

function abilityBarHTML(items){
  const bars=items.map(item=>{
    const pct=Math.max(0,Math.min(1,item.pct||0))*100;
    return `<div class="ability-track"><div class="ability-fill" style="width:${pct}%;background:${item.color};color:${item.glow||'#ffffff'}"></div><div class="ability-text">${item.label}</div></div>`;
  }).join('');
  return `<div class="ability-bars ${items.length===1?'single':'double'}">${bars}</div>`;
}

function updateRayGraniteMeter(el,b){
  if(!el.classList.contains('ray-hud')){
    el.classList.add('ray-hud');
    el.innerHTML='<div class="ray-hud-meter"><div class="ray-panic-fill"><span class="ray-panic-spark"></span><span class="ray-panic-spark"></span><span class="ray-panic-spark"></span></div></div><div class="ray-hud-content"></div>';
  }
  const pct=b.rayGraniteCooldown>0?0:Math.min(1,b.rayPanicTotal/100);
  const color=`rgb(${Math.round(180+75*pct)},${Math.round(150)},${Math.round(230-180*pct)})`;
  const status=b.rayGraniteCooldown>0?`${b.rayGraniteCooldown.toFixed(1)}s cooldown`:`${Math.round(b.rayPanicTotal)}/100 damage in 3s`;
  const track=el.querySelector('.ray-hud-meter'),fill=el.querySelector('.ray-panic-fill');
  track.title=`GRANITE BLAST · ${status}`;track.setAttribute('aria-label',track.title);
  fill.style.height=`${pct*100}%`;fill.style.backgroundColor=color;fill.style.color=color;fill.style.opacity=pct>0?'1':'0';
  return el.querySelector('.ray-hud-content');
}

function updateMattComboMeter(el,b){
  if(!el.classList.contains('matt-hud')){
    el.classList.add('matt-hud');
    el.innerHTML='<div class="matt-combo-meter"><div class="matt-combo-fill"><span class="matt-combo-spark"></span><span class="matt-combo-spark"></span><span class="matt-combo-spark"></span></div></div><div class="matt-hud-content"></div>';
  }
  const required=mattComboRequired(b);
  const pct=b.mattNextSpin?1:Math.min(1,Math.max(0,b.mattCombo/required));
  const track=el.querySelector('.matt-combo-meter'),fill=el.querySelector('.matt-combo-fill');
  track.title=b.mattNextSpin?'SPIN READY':b.mattCombo?`${b.mattCombo}/${required} · ${b.mattComboTimer.toFixed(1)}s`:`0/${required}`;
  track.setAttribute('aria-label',track.title);
  fill.style.height=`${pct*100}%`;
  return el.querySelector('.matt-hud-content');
}

function getAbilityBars(b){
  switch(b.char.id){
    case 'hyperbole':
      return abilityBarHTML([
        {label:b.hyperboleSplit?'GREAT SPLIT · CHARGING':`GREAT SPLIT · ${abilityCooldown(b.hyperboleSplitTimer,b.hyperboleSplitInterval)}`,
          pct:b.hyperboleSplit?1:b.hyperboleSplitTimer/b.hyperboleSplitInterval,
          color:'linear-gradient(90deg,#4d207e,#af65ed)',glow:'#ba85ff'},
        {label:b.hyperboleRiftCharge?'PROPULSION RIFT · FORMING':b.hyperboleVolley?'METEOR SHOWER · FALLING':`METEOR / RIFT · ${abilityCooldown(b.hyperboleMeteorTimer,b.hyperboleMeteorInterval)}`,
          pct:b.hyperboleRiftCharge||b.hyperboleVolley?1:b.hyperboleMeteorTimer/b.hyperboleMeteorInterval,
          color:'linear-gradient(90deg,#20453a,#46CF8F)',glow:'#7affbc'}
      ]);
    case 'manic_lion':
