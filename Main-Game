function mattTargets(owner,includeTurrets=true){
  return [...balls,...copies,...(includeTurrets?turrets:[])].filter(e=>e.alive&&e.side!==owner.side&&sameRealm(e,owner));
}
function mattRadius(target){return target.char?.id==='elder_tree'?target.etGrowR:target.r;}
function mattKnockback(owner,target,force=1.6){
  if(!(target instanceof Ball)||!target.alive)return;
  const a=Math.atan2(target.y-owner.y,target.x-owner.x);
  const speed=target.getSpeed();target.vx=Math.cos(a)*speed*force;target.vy=Math.sin(a)*speed*force;
  target.mattKnockbackTimer=.2;
}
function mattComboRequired(owner){return owner.isJuggernaut?5:3;}
function mattSpin(owner){
  owner.mattCombo=0;owner.mattComboTimer=0;owner.mattNextSpin=false;
  owner.mattSpinTimer=MATT_SPIN_DURATION;owner.mattSpinStart=owner.mattSwordAngle;
  owner.mattSpinDirection=owner.mattSwordDirection;
  domainCount(owner,'combos',1);
  const radius=owner.r*7.15;
  for(const e of mattTargets(owner)){
    if(Math.hypot(e.x-owner.x,e.y-owner.y)>radius+mattRadius(e)*.5)continue;
    e.takeDamage(MATT_COMBO_DAMAGE,owner);mattKnockback(owner,e,2.25);
  }
  effects.push({type:'ring',x:owner.x,y:owner.y,realm:owner.realm,r:owner.r,maxR:radius,color:MATT_GREEN,t:0,dur:.5});
  effects.push({type:'ult_flash',x:owner.x,y:owner.y,realm:owner.realm,r:radius,color:'#f1fff4',t:0,dur:.4});
  effects.push({type:'text',x:owner.x,y:owner.y-owner.r*.7,realm:owner.realm,text:'360 COMBO',color:'#c6ffe0',t:0,dur:.7});
}
function mattSwordHits(owner,dt){
  if(owner.mattSpinTimer>0)return;
  const a=owner.mattSwordAngle,x1=owner.x+Math.cos(a)*owner.r*2.15;
  const y1=owner.y+Math.sin(a)*owner.r*2.15;
  const x2=owner.x+Math.cos(a)*owner.r*6.875,y2=owner.y+Math.sin(a)*owner.r*6.875;
  for(const key in owner.mattSwordCooldowns){owner.mattSwordCooldowns[key]-=dt;if(owner.mattSwordCooldowns[key]<=0)delete owner.mattSwordCooldowns[key];}
  const touching=mattTargets(owner).filter(e=>pointSegmentDistance(e.x,e.y,x1,y1,x2,y2)<=mattRadius(e)+owner.r*.24);
  const touchingIds=new Set(touching.map(e=>e.id));
  // A blade must leave a target before it can hit that target again.
  for(const id of owner.mattSwordContacts)if(!touchingIds.has(id))owner.mattSwordContacts.delete(id);
  owner.mattSwordHitGrace=Math.max(0,owner.mattSwordHitGrace-dt);
  if(owner.mattSwordHitGrace>0)return;
  for(const e of touching){
    if(owner.mattSwordContacts.has(e.id))continue;
    if(owner.mattSwordCooldowns[e.id]>0)continue;
    owner.mattSwordContacts.add(e.id);
    owner.mattSwordCooldowns[e.id]=.4;
    owner.mattSwordHitGrace=.14; // Let the reversed blade travel visibly before another hit.
    owner.mattSwordDirection*=-1; // Every successful hit reverses rotation.
    if(owner.mattNextSpin||owner.mattCombo>=mattComboRequired(owner)-1){mattSpin(owner);break;}
    // The first two hits keep contact fighters close. Only the finisher pushes back.
    e.takeDamage(MATT_SWORD_DAMAGE,owner);
    owner.mattCombo++;owner.mattComboTimer=2;
    effects.push({type:'ring',x:e.x,y:e.y,realm:owner.realm,r:mattRadius(e),maxR:mattRadius(e)+27,color:MATT_GREEN,t:0,dur:.27});
    break; // One registered hit per simulation step, even in a crowded melee.
  }
}

function mattCreateZone(owner,x,y,duration=5,white=false,boost=false,gray=false){
  mattZones.push({owner,realm:owner.realm,x,y,r:owner.r*(white?3.75:4.25),life:0,dur:duration,tick:MATT_ZONE_TICK,white,boost,gray,ultimate:white&&boost,claimed:false,id:Math.random()});
}
function mattUltimateDamage(owner,target,amount){
  const already=owner.mattUltDamageByTarget[target.id]||0;
  const remaining=MATT_ULT_DAMAGE_CAP-already;
  if(remaining<=0)return;
  // The standard damage gateway applies Juggernaut's multiplier afterward.
  const before=target.hp;
  target.takeDamage(Math.min(amount,remaining/(owner.damageMultiplier||1)),owner);
  owner.mattUltDamageByTarget[target.id]=already+Math.max(0,before-target.hp);
}
function updateMattZones(dt){
  mattZones.forEach(z=>{
    z.life+=dt;z.tick-=dt;
    const size=z.r*Math.min(1,z.life/.34,Math.max(0,(z.dur-z.life)/.46));
    if(size<=0)return;
    const inside=e=>e.alive&&sameRealm(e,z)&&Math.hypot(e.x-z.x,e.y-z.y)<=size+mattRadius(e)*.22;
    for(const e of mattTargets(z.owner))if(inside(e)&&e instanceof Ball)e.mattZoneSlowTimer=.23;
    if(z.boost&&!z.claimed&&z.owner.alive&&inside(z.owner)){
      z.claimed=true;z.owner.mattBurstTimer=1;z.owner.mattImmuneTimer=1;z.owner.mattNextSpin=true;
      effects.push({type:'ring',x:z.owner.x,y:z.owner.y,realm:z.realm,r:z.owner.r,maxR:z.owner.r*3,color:MATT_GREEN,t:0,dur:.45});
    }
    while(z.tick<=0){
      z.tick+=MATT_ZONE_TICK;
      for(const e of mattTargets(z.owner))if(inside(e)){
        if(!z.ultimate){e.takeDamage(4,z.owner);continue;}
        // Multiple star zones share one damage tick per enemy, even if they overlap.
        const last=z.owner.mattUltZoneLastHit[e.id];
        if(last!=null&&z.owner.mattClock-last<MATT_ZONE_TICK-.0001)continue;
        z.owner.mattUltZoneLastHit[e.id]=z.owner.mattClock;
        mattUltimateDamage(z.owner,e,4);
      }
      for(const ally of [...balls,...copies])if(ally.alive&&ally.side===z.owner.side&&inside(ally))ally.hp=Math.min(ally.maxHp,ally.hp+3);
    }
  });
  mattZones=mattZones.filter(z=>z.life<z.dur);
}

function mattFireSlash(owner,gray=false){
  const target=mattTargets(owner,false).sort((a,b)=>Math.hypot(a.x-owner.x,a.y-owner.y)-Math.hypot(b.x-owner.x,b.y-owner.y))[0];
  if(!target)return;
  const base=Math.atan2(target.y-owner.y,target.x-owner.x);
  const angle=base+(Math.random()*2-1)*20*Math.PI/180;
  const length=Math.hypot(W,H)*1.65;
  const x1=owner.x,y1=owner.y,x2=x1+Math.cos(angle)*length,y2=y1+Math.sin(angle)*length;
  mattSlashes.push({owner,realm:owner.realm,x1,y1,x2,y2,life:0,dur:.23,seed:Math.random(),gray});
  for(const e of mattTargets(owner))if(pointSegmentDistance(e.x,e.y,x1,y1,x2,y2)<=mattRadius(e)+8)e.takeDamage(20,owner);
}

function mattSpawnShowerStar(owner){
  const center=isDomainMode()?circleFor(owner):null;
  const r=owner.r*(.38+Math.random()*.55);
  const x=center?center.x+(Math.random()-.5)*(DOMAIN_RADIUS-r)*1.45:r+20+Math.random()*(W-2*r-40);
  const y=center?center.y+DOMAIN_RADIUS+r+20:H+r+20;
  mattStars.push({owner,realm:owner.realm,x,y,r,vy:-(195+Math.random()*260),vx:(Math.random()-.5)*55,
    rotation:Math.random()*Math.PI*2,spin:(Math.random()-.5)*2.2,life:0,alive:true});
}
function mattExplodeStar(star,domainStar=false){
  const owner=star.owner;
  const radius=domainStar?owner.r*3.55:star.r*(3.4+Math.random()*1.8);
  const damage=domainStar?32:Math.round(12+star.r/owner.r*18);
  for(const e of mattTargets(owner))if(Math.hypot(e.x-star.x,e.y-star.y)<radius+mattRadius(e)){
    if(domainStar)e.takeDamage(damage,owner);
    else mattUltimateDamage(owner,e,damage);
    mattKnockback(star,e,2.05);
  }
  mattCreateZone(owner,star.x,star.y,domainStar?3:5,true,!domainStar);
  effects.push({type:'ring',x:star.x,y:star.y,realm:star.realm,r:star.r,maxR:radius,color:'#faffff',t:0,dur:.48});
  effects.push({type:'ult_flash',x:star.x,y:star.y,realm:star.realm,r:radius,color:'#ffffff',t:0,dur:.35});
}
function updateMattStars(dt){
  for(const s of mattStars){
    s.life+=dt;s.x+=s.vx*dt;s.y+=s.vy*dt;s.rotation+=s.spin*dt;
    const target=mattTargets(s.owner,false).find(e=>Math.hypot(e.x-s.x,e.y-s.y)<=mattRadius(e)+s.r);
    if(target){s.alive=false;mattExplodeStar(s);}
    if(s.y<-(s.r+35)||s.life>7)s.alive=false;
  }
  mattStars=mattStars.filter(s=>s.alive);
  mattSlashes.forEach(s=>s.life+=dt);
  mattSlashes=mattSlashes.filter(s=>s.life<s.dur);
}

function drawMattStar(ctx,x,y,r,angle=0,alpha=1){
  ctx.save();ctx.translate(x,y);ctx.rotate(angle);ctx.globalAlpha=alpha;
  ctx.shadowColor='#adffd6';ctx.shadowBlur=Math.min(20,r*.85);
  ctx.fillStyle='#fff';ctx.strokeStyle='#c9ffdf';ctx.lineWidth=1.3;
  ctx.beginPath();for(let i=0;i<10;i++){
    const a=-Math.PI/2+i*Math.PI/5,rad=i%2?r*.43:r;
    if(i)ctx.lineTo(Math.cos(a)*rad,Math.sin(a)*rad);else ctx.moveTo(Math.cos(a)*rad,Math.sin(a)*rad);
  }ctx.closePath();ctx.fill();ctx.stroke();ctx.restore();
}
function drawMattZone(ctx,z){
  const open=Math.min(1,z.life/.34,Math.max(0,(z.dur-z.life)/.46));
  if(open<=0)return;
  const r=z.r*open,now=performance.now()*.001;
  ctx.save();ctx.globalAlpha=Math.min(1,z.life/.16)*Math.min(1,(z.dur-z.life)/.34);
  const glow=ctx.createRadialGradient(z.x,z.y,0,z.x,z.y,r);
  glow.addColorStop(0,z.gray?'rgba(245,245,245,.23)':z.white?'rgba(247,255,251,.23)':'rgba(75,255,164,.22)');
  glow.addColorStop(.7,z.gray?'rgba(185,185,185,.14)':z.white?'rgba(230,255,242,.13)':'rgba(43,190,116,.14)');
  glow.addColorStop(1,z.gray?'rgba(170,170,170,.03)':'rgba(38,196,98,.03)');
  ctx.fillStyle=glow;ctx.beginPath();ctx.arc(z.x,z.y,r,0,Math.PI*2);ctx.fill();
  ctx.strokeStyle=z.gray?'#ededed':z.white?'#eafff5':'#76ffb1';ctx.shadowColor=z.gray?'#cccccc':MATT_GREEN;ctx.shadowBlur=13;
  ctx.lineWidth=3*open;ctx.stroke();ctx.shadowBlur=0;
  for(let i=0;i<17;i++){
    const phase=(now*.32+i*.618+z.id*4)%1,a=i*2.399+z.id*7,rad=r*phase;
    const size=2+(i%3);ctx.globalAlpha=(1-phase)*.7*open;
    ctx.fillStyle=i%4===0?'#fff':z.gray?'#bdbdbd':MATT_GREEN;
    ctx.fillRect(z.x+Math.cos(a)*rad-size/2,z.y+Math.sin(a)*rad-size/2,size,size);
  }
  ctx.restore();
}
function drawMattSlash(ctx,s){
  const fade=Math.max(0,1-s.life/s.dur);
  ctx.save();ctx.globalAlpha=fade;ctx.lineCap='round';
  ctx.strokeStyle=s.gray?'#c6c6c6':'#69fca9';ctx.shadowColor=s.gray?'#dedede':'#51ff9e';ctx.shadowBlur=17;
  ctx.lineWidth=10*fade+1;ctx.beginPath();ctx.moveTo(s.x1,s.y1);ctx.lineTo(s.x2,s.y2);ctx.stroke();
  ctx.strokeStyle='#fff';ctx.lineWidth=2*fade+1;ctx.shadowBlur=6;ctx.stroke();ctx.shadowBlur=0;
  for(let i=0;i<12;i++){
    const q=.025+i*.055+Math.min(.15,s.life*.5),perp=(Math.sin(s.seed*71+i*15)-.5)*25;
    const dx=s.x2-s.x1,dy=s.y2-s.y1,len=Math.hypot(dx,dy)||1;
    const x=s.x1+dx*q-dy/len*perp,y=s.y1+dy*q+dx/len*perp;
    ctx.fillStyle=i%4===0?'#fff':s.gray?'#aaa':MATT_GREEN;ctx.globalAlpha=fade*(.45+i/22);
    ctx.fillRect(x-2,y-2,4,4);
  }ctx.restore();
}

function mayhemEntityRadius(entity){
  return entity.char?.id==='elder_tree' ? entity.etGrowR : (entity.r||R);
}

function getMayhemTargets(owner){
  return [...balls,...copies,...turrets].filter(e=>e&&e.alive&&e.side!==owner.side&&sameRealm(e,owner));
}

function getNearestMayhemTarget(owner){
  const targets=getMayhemTargets(owner);
  return targets.length?targets.reduce((a,b)=>
    Math.hypot(a.x-owner.x,a.y-owner.y)<Math.hypot(b.x-owner.x,b.y-owner.y)?a:b
  ):null;
}

function applyOnFire(target,owner,artistGrayCopy=false){
  if(!target||!target.alive||target.side===owner.side||!sameRealm(target,owner)) return;
  // Being touched again while already burning does NOT refresh the timer.
  // Once the four seconds finish, a target still standing in fire may ignite again.
  if((target.onFireTimer||0)>0) return;
  if(owner.char?.id==='mayhem' && !owner.isCopy) domainCount(owner,'burns',1);
  target.onFireTimer=MAYHEM_ON_FIRE_DURATION;
  target.onFireOwner=owner;
  target.onFireGray=!!artistGrayCopy;
  target.onFireTickTimer=MAYHEM_FIRE_TICK;
}

function applyInextinguishableFire(target,owner){
  if(!target||!target.alive||target.side===owner.side||!sameRealm(target,owner)) return;
  target.inextinguishableStacks=Math.min(5,(target.inextinguishableStacks||0)+1);
  target.inextinguishableOwner=owner;
  if(!(target.inextinguishableTickTimer>0)) target.inextinguishableTickTimer=MAYHEM_FIRE_TICK;
  effects.push({type:'text',x:target.x,y:target.y-mayhemEntityRadius(target)-12,text:`BLUE FIRE x${target.inextinguishableStacks}`,color:MAYHEM_BLUE,t:0,dur:.7});
}

function updateMayhemBurnStatus(target,dt){
  if(!target||!target.alive) return;
  if((target.onFireTimer||0)>0){
    target.onFireTimer=Math.max(0,target.onFireTimer-dt);
    target.onFireTickTimer=(target.onFireTickTimer||MAYHEM_FIRE_TICK)-dt;
    while(target.onFireTickTimer<=0&&target.onFireTimer>0){
      target.onFireTickTimer+=MAYHEM_FIRE_TICK;
      target.takeDamage(MAYHEM_ON_FIRE_DAMAGE,target.onFireOwner);
    }
    if(target.onFireTimer<=0) target.onFireGray=false;
  }
  if((target.inextinguishableStacks||0)>0){
    target.inextinguishableTickTimer=(target.inextinguishableTickTimer||MAYHEM_FIRE_TICK)-dt;
    while(target.inextinguishableTickTimer<=0&&target.alive){
      target.inextinguishableTickTimer+=MAYHEM_FIRE_TICK;
      target.takeDamage(target.inextinguishableStacks,target.inextinguishableOwner);
    }
  }
}

function isMayhemProjectileInsideArena(p){
  if(isDomainMode()){
    if(rayHeptagonActive(p.owner?.realm||0)){
      const vertices=rayHeptagonVertices(p.r+3);
      return vertices.every((a,i)=>{const b=vertices[(i+1)%7];return (b.x-a.x)*(p.y-a.y)-(b.y-a.y)*(p.x-a.x)>=0;});
    }
    const c=circleFor(p.owner);return Math.hypot(p.x-c.x,p.y-c.y)+p.r<DOMAIN_RADIUS;
  }
  if(!isHexArena()) return p.x>=p.r&&p.x<=W-p.r&&p.y>=p.r&&p.y<=H-p.r;
  const v=getArenaVertices(2);
  for(let i=0;i<v.length;i++){
    const a=v[i],b=v[(i+1)%v.length],ex=b.x-a.x,ey=b.y-a.y,len=Math.hypot(ex,ey)||1;
    const nx=-ey/len,ny=ex/len;
    if((p.x-a.x)*nx+(p.y-a.y)*ny<p.r) return false;
  }
  return true;
}

function getMayhemWallInwardDirection(x,y){
  if(isDomainMode()){const c=DOMAIN_CENTERS[x>W/2?1:0],dx=c.x-x,dy=c.y-y,len=Math.hypot(dx,dy)||1;return {dx:dx/len,dy:dy/len};}
  if(!isHexArena()){
    const candidates=[
      {d:x,dx:1,dy:0},{d:W-x,dx:-1,dy:0},
      {d:y,dx:0,dy:1},{d:H-y,dx:0,dy:-1}
    ];
    return candidates.reduce((a,b)=>a.d<b.d?a:b);
  }
  const v=getArenaVertices(2);
  let best=null;
  for(let i=0;i<v.length;i++){
    const a=v[i],b=v[(i+1)%v.length],ex=b.x-a.x,ey=b.y-a.y,len=Math.hypot(ex,ey)||1;
    const item={d:pointSegmentDistance(x,y,a.x,a.y,b.x,b.y),dx:-ey/len,dy:ex/len};
    if(!best||item.d<best.d) best=item;
  }
  return best||{dx:1,dy:0};
}

function mayhemFireballHitsRayWall(p){
  return rayWalls.some(w=>sameRealm(p,w)&&rayWallCollision(p,w,p.r));
}

function spawnMayhemPuddle(owner,x,y,artistCopy=false){
  mayhemPuddles.push({id:Math.random(),owner,side:owner.side,x,y,r:owner.r*2.5,life:0,dur:MAYHEM_PUDDLE_DURATION,artistCopy});
}

function mayhemPuddleGrowth(p){
  const t=Math.max(0,Math.min(1,p.life/MAYHEM_PUDDLE_GROW_TIME));
  // Ease outward quickly from the impact point, then settle smoothly at full size.
  return .04+.96*(1-Math.pow(1-t,3));
}

function spawnMayhemFireball(owner,ultimate=false,artistCopy=false){
  const target=getNearestMayhemTarget(owner);
  if(!target) return false;
  // Aim once at the nearest enemy's current/last known location. It never homes.
  const angle=Math.atan2(target.y-owner.y,target.x-owner.x);
  const r=owner.r*.43,speed=8*scaleFor(owner);
  mayhemFireballs.push({
    id:Math.random(),owner,side:owner.side,x:owner.x+Math.cos(angle)*(owner.r+r+4),y:owner.y+Math.sin(angle)*(owner.r+r+4),
    vx:Math.cos(angle)*speed,vy:Math.sin(angle)*speed,r,ultimate,artistCopy,alive:true,hitIds:new Set()
  });
  return true;
}

function spawnMayhemGeyser(fireball,x,y){
  const inward=getMayhemWallInwardDirection(x,y),length=Math.hypot(W,H)*1.55;
  mayhemGeysers.push({
    id:Math.random(),owner:fireball.owner,side:fireball.side,x1:x,y1:y,
    x2:x+inward.dx*length,y2:y+inward.dy*length,width:fireball.owner.r*2.15,
    life:0,dur:5,hitTimers:{},stackedIds:new Set()
  });
  effects.push({type:'ult_flash',x,y,r:fireball.owner.r*2.8,color:MAYHEM_BLUE,t:0,dur:.55});
}

function updateMayhemFireball(p,dt){
  if(!p.alive||!p.owner?.alive){p.alive=false;return;}
  const oldX=p.x,oldY=p.y;
  p.x+=p.vx;p.y+=p.vy;

  for(const target of getMayhemTargets(p.owner)){
    if(p.hitIds.has(target.id)) continue;
    if(Math.hypot(target.x-p.x,target.y-p.y)<=mayhemEntityRadius(target)+p.r){
      p.hitIds.add(target.id);
      target.takeDamage(MAYHEM_FIREBALL_DAMAGE,p.owner);
      if(!p.ultimate){spawnMayhemPuddle(p.owner,p.x,p.y,p.artistCopy);p.alive=false;return;}
    }
  }

  if(!p.ultimate&&mayhemFireballHitsRayWall(p)){
    spawnMayhemPuddle(p.owner,oldX,oldY,p.artistCopy);p.alive=false;return;
  }
  if(!isMayhemProjectileInsideArena(p)){
    if(p.ultimate) spawnMayhemGeyser(p,oldX,oldY);
    else spawnMayhemPuddle(p.owner,oldX,oldY,p.artistCopy);
    p.alive=false;
  }
}

function updateMayhemPuddle(p,dt){
  p.life+=dt;
  const activeRadius=p.r*mayhemPuddleGrowth(p);
  for(const target of getMayhemTargets(p.owner)){
    if(Math.hypot(target.x-p.x,target.y-p.y)<=activeRadius+mayhemEntityRadius(target)*.35) applyOnFire(target,p.owner,p.artistCopy);
  }
}

function scheduleMayhemAmplifier(owner,angle){
  const radii=[owner.r*1.5,owner.r*2.25,owner.r*3];
  let distance=owner.r+radii[0]+6;
  radii.forEach((radius,index)=>{
    if(index>0) distance+=radii[index-1]+radius+owner.r*.16;
    const center={x:owner.x+Math.cos(angle)*distance,y:owner.y+Math.sin(angle)*distance,realm:owner.realm||0};
    if(isDomainMode())keepInCircle(center,Math.min(radius,DOMAIN_RADIUS*.65),false);
    mayhemExplosions.push({
      id:Math.random(),owner,side:owner.side,x:center.x,y:center.y,
      r:radius,delay:index*.4,life:0,dur:1.35,activated:false,index
    });
  });
}

function updateMayhemExplosion(ex,dt){
  if(!ex.activated){
    ex.delay-=dt;
    if(ex.delay>0) return;
    ex.activated=true;
    triggerScreenUltFlash('#6b2100',.12+ex.index*.035);
    effects.push({type:'ult_flash',x:ex.x,y:ex.y,r:ex.r*1.25,color:'#ff7a18',t:0,dur:.38});
    for(const target of getMayhemTargets(ex.owner)){
      if(Math.hypot(target.x-ex.x,target.y-ex.y)<=ex.r+mayhemEntityRadius(target)){
        target.takeDamage(MAYHEM_AMPLIFIER_DAMAGE,ex.owner);
        applyOnFire(target,ex.owner);
      }
    }
  }
  ex.life+=dt;
}

function updateMayhemGeyser(g,dt){
  g.life+=dt;
  for(const key in g.hitTimers) g.hitTimers[key]-=dt;
  for(const target of getMayhemTargets(g.owner)){
    const radius=mayhemEntityRadius(target);
    if(pointSegmentDistance(target.x,target.y,g.x1,g.y1,g.x2,g.y2)>g.width/2+radius) continue;
    const key=String(target.id);
    if((g.hitTimers[key]||0)<=0){
      g.hitTimers[key]=MAYHEM_GEYSER_TICK;
      target.takeDamage(MAYHEM_GEYSER_DAMAGE,g.owner);
    }
    if(!g.stackedIds.has(target.id)){
      g.stackedIds.add(target.id);
      applyInextinguishableFire(target,g.owner);
    }
  }
}

function triggerMayhemChargeHit(owner,target){
  const artistCopy=owner?.char?.id==='maniac_artist'&&(owner.artistMayhemCharge||0)>0;
  const mayhemOriginal=owner?.char?.id==='mayhem'&&owner.mayhemState==='fire_charge';
  if((!mayhemOriginal&&!artistCopy)||!target?.alive||target.side===owner.side) return;
  const key=String(target.id);
  const hitTimers=artistCopy?owner.artistMayhemChargeHits:owner.mayhemChargeHits;
  if((hitTimers[key]||0)>0) return;
  hitTimers[key]=1;
  target.takeDamage(MAYHEM_CHARGE_DAMAGE,owner);
  const radius=owner.r*2.5;
  effects.push({type:'mayhem_charge_wave',x:owner.x,y:owner.y,r:owner.r,maxR:radius,color:artistCopy?'#c8c8c8':'#ff7a18',t:0,dur:.5});
  for(const enemy of getMayhemTargets(owner)){
    if(Math.hypot(enemy.x-owner.x,enemy.y-owner.y)<=radius+mayhemEntityRadius(enemy)) applyOnFire(enemy,owner,artistCopy);
  }
}

function mayhemRand(seed){
