    const ar=r*(1.6+0.2*Math.sin(phase));
    const ag=ctx.createRadialGradient(0,0,r*0.8,0,0,ar);
    ag.addColorStop(0,auraColor);
    ag.addColorStop(1,'rgba(0,0,0,0)');
    ctx.beginPath();
    ctx.arc(0,0,ar,0,Math.PI*2);
    ctx.fillStyle=ag;
    ctx.fill();
  }
  const haze=ctx.createRadialGradient(0,r*0.2,0,0,0,r*1.5);
  haze.addColorStop(0,'rgba(180,60,255,0.25)');
  haze.addColorStop(1,'rgba(0,0,0,0)');
  ctx.beginPath();
  ctx.arc(0,0,r*1.5,0,Math.PI*2);
  ctx.fillStyle=haze;
  ctx.fill();
  function flamePath(scale){
    const s=r*scale;
    ctx.beginPath();
    ctx.moveTo(0, s*0.85);
    ctx.bezierCurveTo(-s*0.75, s*0.6,  -s*0.9, s*0.0,  -s*0.55, -s*0.4);
    ctx.bezierCurveTo(-s*0.7, -s*0.55, -s*0.35,-s*0.85,  0, -s*1.0);
    ctx.bezierCurveTo( s*0.35,-s*0.85,  s*0.7, -s*0.55,  s*0.55, -s*0.4);
    ctx.bezierCurveTo( s*0.9, s*0.0,   s*0.75, s*0.6,    0,  s*0.85);
    ctx.closePath();
  }
  flamePath(1.0);
  const outerGrad=ctx.createLinearGradient(0,-r,0,r);
  outerGrad.addColorStop(0,'#220033');
  outerGrad.addColorStop(0.35,'#5500aa');
  outerGrad.addColorStop(0.75,'#7722cc');
  outerGrad.addColorStop(1,'#3a0055');
  ctx.fillStyle=outerGrad;
  ctx.fill();
  flamePath(0.78);
  const midGrad=ctx.createLinearGradient(0,-r*0.75,0,r*0.75);
  midGrad.addColorStop(0,'#9933ff');
  midGrad.addColorStop(0.5,'#cc55ff');
  midGrad.addColorStop(1,'#6611bb');
  ctx.fillStyle=midGrad;
  ctx.fill();
  flamePath(0.48);
  const coreGrad=ctx.createLinearGradient(0,-r*0.45,0,r*0.45);
  coreGrad.addColorStop(0,'#ffffff');
  coreGrad.addColorStop(0.3,'#eeccff');
  coreGrad.addColorStop(0.7,'#cc88ff');
  coreGrad.addColorStop(1,'#aa44ff');
  ctx.fillStyle=coreGrad;
  ctx.fill();
  for(let w=0;w<4;w++){
    const wa=phase*1.3+w*1.57;
    const wr=r*(0.12-w*0.02);
    const wox=Math.sin(wa+w)*r*(0.18+w*0.08);
    const woy=-r*(0.7+w*0.12)+Math.cos(wa*0.9)*r*0.06;
    ctx.beginPath();
    ctx.arc(wox,woy,Math.max(0.5,wr),0,Math.PI*2);
    ctx.fillStyle=`rgba(220,150,255,${0.5-w*0.1})`;
    ctx.fill();
  }
  flamePath(1.0);
  ctx.strokeStyle='rgba(160,60,255,0.5)';
  ctx.lineWidth=1.5;
  ctx.stroke();
  ctx.restore();
}

let lionAuraParticles = [];
let lionBiteRedirectTarget = null;
let devourerRockWalls = [];
function spawnLionAuraParticles(lion){
  const count = 3 + Math.floor(Math.random()*3);
  for(let i=0;i<count;i++){
    const angle = Math.random()*Math.PI*2;
    const dist = lion.r*(0.8+Math.random()*1.2);
    const px = lion.x + Math.cos(angle)*dist;
    const py = lion.y + Math.sin(angle)*dist;
    const speed = 0.4 + Math.random()*1.2;
    const vx = (Math.random()-0.5)*speed - Math.cos(angle)*0.3;
    const vy = (Math.random()-0.5)*speed - Math.sin(angle)*0.3;
    const size = 2 + Math.random()*5;
    const colors=['#1a0033','#2b0055','#3d0070','#0d0020','#4a0066','#180028','#6600aa','#000011'];
    const col = colors[Math.floor(Math.random()*colors.length)];
    lionAuraParticles.push({x:px,y:py,vx,vy,size,col,life:0,maxLife:0.5+Math.random()*0.7,sideId:lion.side,rotate:Math.random()*Math.PI*2,rSpeed:(Math.random()-0.5)*4});
  }
}
function updateLionAuraParticles(dt){
  lionAuraParticles=lionAuraParticles.filter(p=>{
    p.life+=dt;
    p.x+=p.vx;
    p.y+=p.vy;
    p.vy-=0.04;
    p.vx*=0.97;
    p.vy*=0.97;
    p.rotate+=p.rSpeed*dt;
    return p.life<p.maxLife;
  });
}
function drawLionAuraParticles(ctx){
  lionAuraParticles.forEach(p=>{
    const frac=p.life/p.maxLife;
    const alpha=(1-frac)*(frac<0.2?frac/0.2:1);
    ctx.save();
    ctx.globalAlpha=alpha*0.85;
    ctx.translate(p.x,p.y);
    ctx.rotate(p.rotate);
    const s=p.size*(1-frac*0.5);
    ctx.beginPath();
    const spikes=5;
    for(let i=0;i<spikes;i++){
      const a=i/spikes*Math.PI*2;
      const r1=s*(0.5+0.5*(i%2));
      ctx.lineTo(Math.cos(a)*r1,Math.sin(a)*r1);
    }
    ctx.closePath();
    ctx.fillStyle=p.col;
    ctx.fill();
    ctx.shadowBlur=8;
    ctx.shadowColor='#6600aa';
    ctx.strokeStyle='rgba(100,0,180,0.4)';
    ctx.lineWidth=0.8;
    ctx.stroke();
    ctx.restore();
  });
}

// ---- DAMAGE TRACKING ----
function getDamageOwner(source){
  if(!source) return null;
  if(source.damageOwner) return source.damageOwner;
  if(source.char) return source;
  if(source.owner && source.owner.char) return source.owner;
  return null;
}

function creditDamage(source, amount){
  const owner=getDamageOwner(source);
  if(owner && Number.isFinite(amount) && amount>0){
    owner.damageDealt=(owner.damageDealt||0)+amount;
    if(isDomainMode()&&!owner.isCopy){
      if(owner.char.id==='engineer' && source instanceof Turret) domainCount(owner,'turretDamage',amount);
      if(domainState?.phase==='active' && owner===domainState.owner && combatRealm(source)===1) owner.domainDamage=(owner.domainDamage||0)+amount;
    }
  }
}

// ---- ENGINEER TURRET ----
class Turret {
  constructor(owner, isMissile=false, isMelee=false){
    this.owner=owner;
    this.realm=owner.realm||0;
    this.side=owner.side;
    this.isMissile=isMissile;
    this.isMelee=isMelee;
    this.x=owner.x+(Math.random()-0.5)*60;
    this.y=owner.y+(Math.random()-0.5)*60;
    if(isDomainMode())keepInCircle(this,30,false);
    else if(isHexArena()) keepPointInArena(this,30);
    else {
      this.x=Math.max(30,Math.min(W-30,this.x));
      this.y=Math.max(30,Math.min(H-30,this.y));
    }
    this.hp=isMissile?150:(isMelee?60:50);
    this.maxHp=this.hp;
    this.r=(isMissile?35:(isMelee?28:20))*scaleFor(owner);
    this.damage=isMissile?35:(isMelee?6:10);
    this.fireRate=isMissile?3.5:1;
    this.fireTimer=Math.random()*this.fireRate;
    this.meleeHitCooldowns={};
    this.clubAngle=Math.random()*Math.PI*2;
    this.angle=0;
    this.alive=true;
    this.flashTimer=0;
    // Juggernaut Engineer turrets get a short setup shield.
    this.spawnShieldTimer=(owner.char.id==='engineer'&&owner.isJuggernaut)?3:0;
    this.id=Math.random();
  }
  findTarget(allBalls,allCopies){
    const enemies=[...allBalls,...allCopies].filter(b=>b.alive&&b.side!==this.side&&sameRealm(b,this));
    if(!enemies.length) return null;
    return enemies.reduce((a,b)=>Math.hypot(a.x-this.x,a.y-this.y)<Math.hypot(b.x-this.x,b.y-this.y)?a:b);
  }
  update(dt,allBalls,allCopies){
    if(!this.alive) return;
    if(isEmmyDomainParticipant(this)) return; // no turret abilities during volleyball
    this.flashTimer=Math.max(0,this.flashTimer-dt);
    this.spawnShieldTimer=Math.max(0,this.spawnShieldTimer-dt);
    // Engineer's 10-second ultimate overclocks every owned turret by 25%.
    const overclock=(this.owner?.char?.id==='engineer'&&this.owner.engUltActive)?1.25:1;
    const target=this.findTarget(allBalls,allCopies);
    if(this.isMelee){
      // The melee turret has no projectile attack. Its club spins continuously.
      this.clubAngle += Math.PI*2*dt*(1.7/3)*overclock;
      for(const e of [...allBalls,...allCopies]){
        if(!e.alive || e.side===this.side || !sameRealm(e,this)) continue;
        const eR=e.char.id==='elder_tree'?e.etGrowR:e.r;
        if(Math.hypot(e.x-this.x,e.y-this.y)<eR+this.r*7.5){
          const key=e.id;
          if((this.meleeHitCooldowns[key]||0)<=0){
            this.meleeHitCooldowns[key]=0.5;
            e.takeDamage(this.damage,this);
            effects.push({type:'ring',x:e.x,y:e.y,r:eR,maxR:eR+35,color:this.artistGrayCopy?'#bdbdbd':'#3399ff',t:0,dur:0.3});
          }
        }
      }
      for(const k in this.meleeHitCooldowns) this.meleeHitCooldowns[k]-=dt*overclock;
      return;
    }
    if(target){
      this.angle=Math.atan2(target.y-this.y,target.x-this.x);
      this.fireTimer-=dt*overclock;
      if(this.fireTimer<=0){
        this.fireTimer=this.fireRate;
        bullets.push(new Bullet(this,target));
      }
    }
  }
  takeDamage(dmg,source=null){
    if(!this.alive) return;
    if(isEmmyDomainParticipant(this)) return;
    if(isDomainMode() && (this.domainImmortal || (source && !sameRealm(this,{realm:combatRealm(source)})))) return;
    if(isFriendlySource(this,source)) return;
    if(this.spawnShieldTimer>0) return;
    dmg=modeDamage(dmg,source);
    const actual=Math.min(this.hp,Math.max(0,dmg));
    this.hp=Math.max(0,this.hp-actual);
    creditDamage(source,actual);
    this.flashTimer=0.12;
    if(this.hp<=0) this.alive=false;
  }
  draw(ctx){
    if(!this.alive || isHiddenByPaperRip(this)) return;
    ctx.save();
    if(this.artistGrayCopy)ctx.filter='grayscale(1)';
    if(this.flashTimer>0) ctx.globalAlpha=0.4+0.6*Math.sin(this.flashTimer*40);
    ctx.translate(this.x,this.y);
    if(this.owner?.char?.id==='engineer'&&this.owner.engUltActive){
      const pulse=0.55+0.25*Math.sin(Date.now()/90);
      ctx.beginPath();ctx.arc(0,0,this.r+4,0,Math.PI*2);
      ctx.strokeStyle=`rgba(255,190,45,${pulse})`;ctx.lineWidth=2;ctx.stroke();
    }
    if(this.spawnShieldTimer>0){
      ctx.beginPath();ctx.arc(0,0,this.r+7,0,Math.PI*2);
      ctx.fillStyle='rgba(120,220,255,0.12)';ctx.fill();
      ctx.strokeStyle='rgba(150,235,255,0.9)';ctx.lineWidth=2.5;ctx.stroke();
    }
    if(this.isMelee){
      // Blue melee turret with a Dark-Knight-style spinning club.
      ctx.beginPath();
      ctx.arc(0,0,this.r,0,Math.PI*2);
      const g=ctx.createRadialGradient(0,0,0,0,0,this.r);
      g.addColorStop(0,'#66bbff'); g.addColorStop(1,'#14558c');
      ctx.fillStyle=g; ctx.fill();
      ctx.strokeStyle='#55aaff'; ctx.lineWidth=1.8; ctx.stroke();
      ctx.save();
      ctx.rotate(this.clubAngle);
      ctx.fillStyle='#173b5e';
      ctx.fillRect(this.r*0.15,-3,this.r*5.05,6);
      ctx.fillStyle='#7fbfff';
      ctx.beginPath();
      ctx.roundRect(this.r*4.75,-10,20,20,4); ctx.fill();
      ctx.fillStyle='#d8efff';
      ctx.fillRect(this.r*5.15,-13,6,26);
      ctx.restore();
      ctx.beginPath(); ctx.arc(0,0,this.r*0.28,0,Math.PI*2); ctx.fillStyle='#e8f6ff'; ctx.fill();
      const bw2=this.r*2.4,bh=5,bx=-bw2/2,by=this.r+5;
      ctx.fillStyle='#1a1830'; ctx.fillRect(bx,by,bw2,bh);
      const frac=Math.max(0,this.hp/this.maxHp); ctx.fillStyle=frac>0.5?'#44cc66':'#ee4444'; ctx.fillRect(bx,by,bw2*frac,bh);
      ctx.restore();
      return;
    }
    const col=this.isMissile?'#ff4411':'#ffcc44';
    const dark=this.isMissile?'#660011':'#664400';
    ctx.beginPath();
    ctx.arc(0,0,this.r,0,Math.PI*2);
    const baseGrad=ctx.createRadialGradient(0,0,0,0,0,this.r);
    baseGrad.addColorStop(0,col);
    baseGrad.addColorStop(1,dark);
    ctx.fillStyle=baseGrad;
    ctx.fill();
    ctx.strokeStyle=this.isMissile?'#ff8866':'#ffaa00';
    ctx.lineWidth=1.5;
    ctx.stroke();
    const teeth=this.isMissile?6:5;
    ctx.strokeStyle=dark;
    ctx.lineWidth=2;
    for(let i=0;i<teeth;i++){
      const a=i/teeth*Math.PI*2;
      ctx.beginPath();
      ctx.moveTo(Math.cos(a)*this.r*0.85,Math.sin(a)*this.r*0.85);
      ctx.lineTo(Math.cos(a)*this.r*1.2,Math.sin(a)*this.r*1.2);
      ctx.stroke();
    }
    ctx.save();
    ctx.rotate(this.angle);
    const blen=this.isMissile?this.r*1.8:this.r*1.5;
    const bw=this.isMissile?5:3.5;
    ctx.fillStyle=dark;
    ctx.fillRect(0,-bw/2,blen,bw);
    if(this.isMissile){
      ctx.fillStyle='#ff2200';
      ctx.beginPath();
      ctx.moveTo(blen,0);
      ctx.lineTo(blen+8,-4);
      ctx.lineTo(blen+8,4);
      ctx.closePath();
      ctx.fill();
    }
    ctx.restore();
    ctx.beginPath();
    ctx.arc(0,0,this.r*0.28,0,Math.PI*2);
    ctx.fillStyle='#fffbe0';
    ctx.fill();
    const bw2=this.r*2.4,bh=5,bx=-bw2/2,by=this.r+4;
    ctx.fillStyle='#1a1830';
    ctx.fillRect(bx,by,bw2,bh);
    const frac=Math.max(0,this.hp/this.maxHp);
    ctx.fillStyle=frac>0.5?'#44cc66':'#ee4444';
    ctx.fillRect(bx,by,bw2*frac,bh);
    ctx.restore();
  }
}

class Bullet {
  constructor(turret,target){
    this.side=turret.side;
    this.realm=turret.realm||0;
    this.isMissile=turret.isMissile;
    this.x=turret.x+Math.cos(turret.angle)*turret.r*1.2;
    this.y=turret.y+Math.sin(turret.angle)*turret.r*1.2;
    this.damage=turret.damage;
    this.source=turret;
    this.target=target;
    this.speed=this.isMissile?4.5:9;
    this.r=(this.isMissile?6:3.5)*scaleFor(turret);
    this.alive=true;
    this.angle=turret.angle;
    this.life=0;
    this.maxLife=this.isMissile?10:5;
    this.vx=Math.cos(this.angle)*this.speed;
    this.vy=Math.sin(this.angle)*this.speed;
    this.homingStrength = this.isMissile ? 0.18 : 0.12;
  }
  update(dt,allBalls,allCopies,allTurrets){
    if(!this.alive) return;
    this.life+=dt;
    if(this.life>this.maxLife){this.alive=false;return;}
    if(this.target && this.target.alive && sameRealm(this.target,this.source)){
      const dx=this.target.x-this.x, dy=this.target.y-this.y;
      const d=Math.hypot(dx,dy)||1;
      const desired={x:dx/d*this.speed,y:dy/d*this.speed};
      this.vx+=(desired.x-this.vx)*this.homingStrength;
      this.vy+=(desired.y-this.vy)*this.homingStrength;
      const spd=Math.hypot(this.vx,this.vy)||1;
      this.vx=this.vx/spd*this.speed;
      this.vy=this.vy/spd*this.speed;
    } else {
      const newTarget = [...allBalls,...allCopies].find(b=>b.alive&&b.side!==this.side&&sameRealm(b,this.source));
      if(newTarget) this.target=newTarget;
    }
    this.x+=this.vx;
    this.y+=this.vy;
    if(isDomainMode()||isHexArena()){
      bouncePointOffArena(this,this.r);
    }else if(this.x<0||this.x>W||this.y<0||this.y>H){
      if(this.x<0||this.x>W) this.vx*=-1;
      if(this.y<0||this.y>H) this.vy*=-1;
      this.x=Math.max(5,Math.min(W-5,this.x));
      this.y=Math.max(5,Math.min(H-5,this.y));
    }
    const enemies=[...allBalls,...allCopies].filter(b=>b.alive&&b.side!==this.side&&sameRealm(b,this));
    for(const e of enemies){
      const eR = e.char.id==='elder_tree' ? e.etGrowR : e.r;
      if(Math.hypot(e.x-this.x,e.y-this.y)<eR+this.r){
        e.takeDamage(this.damage,this.source);
        if(this.isMissile){
          effects.push({type:'punch',x:e.x,y:e.y,t:0,dur:0.45});
          effects.push({type:'ring',x:e.x,y:e.y,r:eR,maxR:eR+50,color:this.source?.artistGrayCopy?'#bdbdbd':'#ff6622',t:0,dur:0.4});
        }
        this.alive=false;
        return;
      }
    }
    const enemyTurrets=allTurrets.filter(t=>t.alive&&t.side!==this.side&&sameRealm(t,this));
    for(const t of enemyTurrets){
      if(Math.hypot(t.x-this.x,t.y-this.y)<t.r+this.r){
        t.takeDamage(this.damage*0.5,this.source);
        this.alive=false;
        return;
      }
    }
  }
  draw(ctx){
    if(!this.alive) return;
    ctx.save();
    if(this.source?.artistGrayCopy)ctx.filter='grayscale(1)';
    if(this.isMissile){
      ctx.translate(this.x,this.y);
      ctx.rotate(Math.atan2(this.vy,this.vx));
      ctx.beginPath();
      ctx.moveTo(this.r*2,0);
      ctx.lineTo(-this.r*1.5,-this.r*0.7);
      ctx.lineTo(-this.r*1.5,this.r*0.7);
      ctx.closePath();
      ctx.fillStyle='#ff5500';
      ctx.fill();
      ctx.fillStyle='#ffcc00';
      ctx.beginPath();
      ctx.arc(-this.r,0,this.r*0.5,0,Math.PI*2);
      ctx.fill();
      ctx.globalAlpha=0.4;
      ctx.beginPath();
      ctx.moveTo(-this.r,0);
      ctx.lineTo(-this.r*3.5,0);
      ctx.strokeStyle='#ff8800';
      ctx.lineWidth=3;
      ctx.stroke();
    } else {
      ctx.beginPath();
      ctx.arc(this.x,this.y,this.r,0,Math.PI*2);
      ctx.fillStyle='#ffee44';
      ctx.fill();
      ctx.shadowColor='#ffcc00';
      ctx.shadowBlur=6;
      ctx.fill();
    }
    ctx.restore();
  }
}


// ---- DARK KNIGHT DRAW ----
function drawDarkKnightHelmet(ctx,x,y,r,swordAngle=0,ultActive=false,outline=false){
  ctx.save();
  ctx.translate(x,y);

  // ------------------------------------------------------------
  // STICKER OUTLINE — DRAWN AS A TRUE UNDERLAYER
  // ------------------------------------------------------------
  // Every helmet piece is duplicated in white FIRST, slightly enlarged.
  // The real colored pieces are then painted on top, so white never
  // paints across the Knight's artwork.
  if(outline || ultActive){
    ctx.save();
    ctx.scale(1.12,1.12);
    ctx.fillStyle='#ffffff';

    // Side plates
    ctx.beginPath();
    ctx.moveTo(-r*1.3,r*0.3); ctx.lineTo(-r*0.5,-r*0.6); ctx.lineTo(-r*0.5,r*0.9); ctx.closePath(); ctx.fill();
    ctx.beginPath();
    ctx.moveTo(r*1.3,r*0.3); ctx.lineTo(r*0.5,-r*0.6); ctx.lineTo(r*0.5,r*0.9); ctx.closePath(); ctx.fill();

    // Main helmet
    ctx.beginPath(); ctx.arc(0,0,r*0.98,0,Math.PI*2); ctx.fill();

    // Bottom visor plates
    ctx.beginPath();
    ctx.moveTo(-r,r*0.2); ctx.lineTo(-r*0.7,r*0.35); ctx.lineTo(-r*0.55,r*0.75);
    ctx.lineTo(-r*0.5,r*0.45); ctx.lineTo(0,r*0.7); ctx.lineTo(0,r*1.2); ctx.lineTo(-r*0.8,r*0.8); ctx.closePath(); ctx.fill();
    ctx.beginPath();
    ctx.moveTo(r,r*0.2); ctx.lineTo(r*0.8,r*0.8); ctx.lineTo(0,r*1.2); ctx.lineTo(0,r*0.7); ctx.closePath(); ctx.fill();

    // Small side plates around visor
    ctx.beginPath(); ctx.moveTo(-r,r*0.2); ctx.lineTo(-r*0.7,r*0.4); ctx.lineTo(-r*0.95,r*0.1); ctx.lineTo(-r,r*0.1); ctx.closePath(); ctx.fill();
    ctx.beginPath(); ctx.moveTo(r,r*0.2); ctx.lineTo(0,r*1.2); ctx.lineTo(r*0.95,r*0.1); ctx.lineTo(r,r*0.1); ctx.closePath(); ctx.fill();

    // Top plates
    ctx.beginPath();
    ctx.moveTo(-r,r*0.1); ctx.lineTo(-r*0.7,r*0.2); ctx.lineTo(-r*0.6,-r*0.4);
    ctx.lineTo(-r*0.55,r*0.3); ctx.lineTo(0,r*0.55); ctx.lineTo(0,-r*0.3); ctx.lineTo(-r*0.6,-r*0.6); ctx.closePath(); ctx.fill();
    ctx.beginPath();
    ctx.moveTo(r,r*0.1); ctx.lineTo(0,r*0.55); ctx.lineTo(0,-r*0.3); ctx.lineTo(r*0.6,-r*0.6); ctx.closePath(); ctx.fill();

    // Ears / horns
    ctx.beginPath(); ctx.moveTo(-r*0.98,r*0.1); ctx.lineTo(-r*0.5,-r*0.6); ctx.lineTo(-r*1.2,-r*1.5); ctx.closePath(); ctx.fill();
    ctx.beginPath(); ctx.moveTo(r*0.98,r*0.1); ctx.lineTo(r*0.5,-r*0.6); ctx.lineTo(r*1.2,-r*1.5); ctx.closePath(); ctx.fill();

    ctx.restore();
  }

